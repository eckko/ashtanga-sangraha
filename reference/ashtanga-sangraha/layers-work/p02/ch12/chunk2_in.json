[
 {
  "n": "35",
  "type": "verse",
  "line_ids": [
   "02.12.35"
  ],
  "lines_deva": [
   "यः शष्कुलीरपूपान्वाऽभ्यवहृत्य प्रतिबुद्धश्छर्दयतियस्य शिरसि लतादयो जायंते बयांसि च निलीयंते मौढ्यं वा भवतियो गृध्रोलूककाकाद्यैः प्रेतपिशाचरक्षोद्रविडांध्रस्त्रीचंडालाद्यै र्वा परिचर्यते दक्षिणाभिमुखं वा स्त्रिया नृत्यंत्या ऽऽकृष्यते वायसादिभिर्वा स्वयंवा दिग्वासा याति शून्याटवीं वा कपिरथेन प्रेतैः प्रब्रजितैर्वा परिष्वज्यतेनग्नो वा रक्तां स्रजं धारयति पंकदिग्धो हसति नृत्यति वा वेत्रवंशकंटकतृणगहने संसृज्यते पतति वा पांशूपधानायां भुवि वल्मीकभस्मश्मशानश्वभ्रायतनेषु वा पंककूपकलुषोदकेषु वा मज्जति स्रोतसा वाह्रियते रक्तकुसुमवनांभूमिं गुहामंधकाराचितां पापकर्मालयं संबाधंजननीं वा प्रविशति मत्स्येन वा ग्रस्यते श्मश्रुकर्म च यो गात्रवृद्धिंविवाहं चानुभवति शैलप्रासादाग्रात्पत्यारोहति वा यूपपुष्पाढ्यशाल्मलीकिंशुककोविदारपारिभद्रकान् यो वा पराजीयते बध्यते छर्दयतिविरिच्यते हृष्यति लभते वा हिरण्यलोहलवणतैलपिण्याककार्पासानश्नाति पक्वान्नं पिबति मद्यं स्नेहं वा ऽभ्यज्यते निर्भर्त्स्यते वा कुपितैःपितृभिः चंद्रार्कतारादीपदेवतानेत्रदशनान्यतमान्नश्यतो वा पश्यतिवक्रं वा बाहुं नग्नं वा विभिद्यमानं पुरुषान् वा नग्नान्कषायवाससोऽसौम्यान्दंडपाशहस्तान् कृष्णान् रक्ताक्षान् स्त्रियं वा कृष्णां शुक्लदर्शनां दीर्घकेशस्तनीं कालरात्रिरूपां ते व्याधिताः पंचतामाप्नुवंति"
  ],
  "lines_iast": [
   "yaḥ śaṣkulīrapūpānvā'bhyavahṛtya pratibuddhaśchardayatiyasya śirasi latādayo jāyaṃte bayāṃsi ca nilīyaṃte mauḍhyaṃ vā bhavatiyo gṛdhrolūkakākādyaiḥ pretapiśācarakṣodraviḍāṃdhrastrīcaṃḍālādyai rvā paricaryate dakṣiṇābhimukhaṃ vā striyā nṛtyaṃtyā ''kṛṣyate vāyasādibhirvā svayaṃvā digvāsā yāti śūnyāṭavīṃ vā kapirathena pretaiḥ prabrajitairvā pariṣvajyatenagno vā raktāṃ srajaṃ dhārayati paṃkadigdho hasati nṛtyati vā vetravaṃśakaṃṭakatṛṇagahane saṃsṛjyate patati vā pāṃśūpadhānāyāṃ bhuvi valmīkabhasmaśmaśānaśvabhrāyataneṣu vā paṃkakūpakaluṣodakeṣu vā majjati srotasā vāhriyate raktakusumavanāṃbhūmiṃ guhāmaṃdhakārācitāṃ pāpakarmālayaṃ saṃbādhaṃjananīṃ vā praviśati matsyena vā grasyate śmaśrukarma ca yo gātravṛddhiṃvivāhaṃ cānubhavati śailaprāsādāgrātpatyārohati vā yūpapuṣpāḍhyaśālmalīkiṃśukakovidārapāribhadrakān yo vā parājīyate badhyate chardayativiricyate hṛṣyati labhate vā hiraṇyalohalavaṇatailapiṇyākakārpāsānaśnāti pakvānnaṃ pibati madyaṃ snehaṃ vā 'bhyajyate nirbhartsyate vā kupitaiḥpitṛbhiḥ caṃdrārkatārādīpadevatānetradaśanānyatamānnaśyato vā paśyativakraṃ vā bāhuṃ nagnaṃ vā vibhidyamānaṃ puruṣān vā nagnānkaṣāyavāsaso'saumyāndaṃḍapāśahastān kṛṣṇān raktākṣān striyaṃ vā kṛṣṇāṃ śukladarśanāṃ dīrghakeśastanīṃ kālarātrirūpāṃ te vyādhitāḥ paṃcatāmāpnuvaṃti"
  ],
