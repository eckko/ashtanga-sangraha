[
 {
  "id": "05.02.107",
  "kind": "metre",
  "line": "कल्प्या गुल्मोदरगत्व्रोगमधुमेहिषु ॥",
  "before": "मृदौ कोष्ठेऽबले बाले स्थविरे दीर्घरोगिणि ॥",
  "after": "पांडौ दूषीविषे शोफे दोषविभ्रांतचेतसि ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.03.1",
  "kind": "metre",
  "line": "अथातो वमनविरेचनव्यापत्सिद्धिं व्याख्यास्यामः ॥",
  "before": "॥ इति विरेचनकल्पो नाम द्वितीयोऽध्यायः ॥",
  "after": "अतिक्षुधितेन मृदुकोष्ठेनाल्पश्लेष्मणा दुर्बमेन दुर्बलेन हीनमात्रमतितीक्ष्णमतिशीतमजीर्णे वा पीतं वमनमधो गच्छति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.03.29",
  "kind": "metre",
  "line": "सामे लंघनो दीपनश्च लघुरूक्षोष्णं चान्नपानं ॥",
  "before": "क्षामस्य मधुरो बृंहणश्च सर्वो विधिरिष्टः ॥",
  "after": "निरामीभूते ( मध्यबलोपचारइव वातातपाभ्यामिव पांशु भस्मावकिरणैरित्यादि ) वातानुरंधे लघुक्षाराम्लं वातेऽधिके दधि साम्लं दाडिमत्वचा युक्तं भोजने पाने च युंजीत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.03.38",
  "kind": "metre",
  "line": "पीतौषधो यदा वेगमुदीरयति निगृह्णाति वा ॥",
  "before": "शुद्धे च दीप नांश्चूर्णान्सवारिष्टादीन् योजयेत् ॥",
  "after": "तदा प्रवाहिकाऽस्य जायते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.03.66",
  "kind": "metre",
  "line": "विसंज्ञं सामवेणुगीतशब्दान् श्रावयेत् ॥",
  "before": "अक्षिणी व्यावृत्ते घृताभ्यक्ते पीडयेत् ॥",
  "after": "विरेचनातियोगे तंदुलांभसा मिश्रेण वमेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.03.69",
  "kind": "metre",
  "line": "क्षौद्रशर्करामधुकोदुंबरत्वचो वा ॥",
  "before": "प्रियंग्वादिकं च तंडुलोदकेन पिबेल्लोध्रसांजनदाडिमत्वचो वा कमलोत्पलसमंगापद्मकेसराणि वा ॥",
  "after": "रक्तातिसारक्रियां च कुर्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.04.59",
  "kind": "metre",
  "line": "मधुक कल्कैन सरसाज्येन बृंहणः ॥",
  "before": "उषकादिप्रतीवापो लेखनस्त्रिफलारसः ॥",
  "after": "बदर्यैरावणीशैलूशाल्मलीधन्वनांकुराः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.04.104",
  "kind": "metre",
  "line": "बस्तीञ्च बृंहणीयान्दद्याद्व्याधिषु विशोधनीयेषु ॥",
  "before": "तद्योग्यौषधयुक्तान् बस्तीन्संतर्क्स युंजीत ॥",
  "after": "मेदस्विनो विशोध्या ये च नराः कुष्ठमेहार्त्ताः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.06.1",
  "kind": "metre",
  "line": "अथातो बस्तिव्यापत्तिसिद्धिं व्याख्यास्यामः ॥",
  "before": "॥ इतिसिद्धबस्तिकल्पो नाम पंचमोऽध्यायः ॥",
  "after": "विबंधगौरवाध्मानशिरोरुग्वाहनोर्ध्वगाः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.06.164",
  "kind": "metre",
  "line": "इति बस्तिव्यापत्सिद्धिर्नामषष्ठोऽध्यायः ॥",
  "before": "यथापथं यथावस्थं तासां कुर्वीत साधनं ॥",
  "after": "अथातः स्नेहव्यापदिकां सिद्धिं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.08.25",
  "kind": "metre",
  "line": "तदंमत्तावनतिक्रांतसंवत्सराणि ॥",
  "before": "तानि सक्षीरण्युपकल्पयेत् ॥",
  "after": "पुराणानि तु पिप्पलीविडंगगुडमधुघृतानि ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.08.26",
  "kind": "metre",
  "line": "पुराणानि तु पिप्पलीविडंगगुडमधुघृतानि ॥",
  "before": "तदंमत्तावनतिक्रांतसंवत्सराणि ॥",
  "after": "अपिच ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.08.30",
  "kind": "metre",
  "line": "पंचविधस्तु भेषजानां कषायः कल्प्यः ॥",
  "before": "वयोबलवतां धातुपुच्छश्रृं गरखुरादिकं ॥",
  "after": "निर्यासः कल्को निर्धूहः शीतः फांटश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.08.42",
  "kind": "metre",
  "line": "शीतसलिलाप्लुतं तु निशापर्युषितं पूतं शीतः ॥",
  "before": "क्षीरादिसहितं च द्रव्यं न सम्यङ्मुक्त रसं भवतीति वारिक्वाथपूर्वकं क्षीराद्यैस्तदुपदेशानुपदग्धं काथयेत् ॥",
  "after": "उष्णांभसि क्षुण्णाभिसुतपूतं फांटः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.08.50",
  "kind": "metre",
  "line": "यथातु सर्वेभिषजो विज्ञास्यंति तथोपदेक्ष्यते ॥",
  "before": "तदेवमुपदिष्टं बुद्धिमतां ज्ञानप्रबोधाय ॥",
  "after": "निर्यासस्य मध्यमा मात्रा च तुष्पलं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.08.58",
  "kind": "metre",
  "line": "पंचप्रभृति तु द्रवं पृथक्स्नेहसममेवावपेत् ॥",
  "before": "कल्कस्य योजयेदंशं चतुर्थं षष्ठमष्टमं ॥",
  "after": "अनिरूपितकल्पं भेषजं कल्कीकुर्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.08.59",
  "kind": "metre",
  "line": "अनिरूपितकल्पं भेषजं कल्कीकुर्यात् ॥",
  "before": "पंचप्रभृति तु द्रवं पृथक्स्नेहसममेवावपेत् ॥",
  "after": "अथैकध्यं प्रतिसंसृज्याधिश्रित्य च निर्यूहवत्साधयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.01.4",
  "kind": "metre",
  "line": "इति ह स्माहुरात्रेयादयो महर्षयः ॥",
  "before": "अथातो बालोपचारणीयमध्यायं व्याख्यास्यामः ॥",
  "after": "अथ खलु जातमात्रमेव बालमुल्बात्सैंधवसर्पिषा विशोधयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.01.21",
  "kind": "metre",
  "line": "द्वितीये लक्ष्मणासिद्धं सर्पिस्तृतीये च ॥",
  "before": "तस्मात्प्रथमेऽहन्यनंतामिश्रं मधुसर्पिषी मंत्रपूते त्रिकालं प्राशयेत् ॥",
  "after": "ततः प्राङ्द्वारितस्तन्यस्य स्वपाणितलसंमितं सर्पिर्द्विकालं दापयेदनंतरं च स्तन्यमिष्टं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.01.30",
  "kind": "metre",
  "line": "देहलीमनुलिखेद्ङ्मुसलं निधापयेत् ॥",
  "before": "तद्वद्दार्यपर्णी शतावरीमार्यामपराजितां च रोचनाभिलि खितां द्वारे च ॥",
  "after": "कणकंटकतिंदुकेंधनस्याग्निर्नक्तं दिनं जागृयात्तथानुक्ताः स्त्रियः सुहृदश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.01.32",
  "kind": "metre",
  "line": "प्रह ष्टजनसंपूर्ण च तद्वेश्म कार्य्यं ॥",
  "before": "कणकंटकतिंदुकेंधनस्याग्निर्नक्तं दिनं जागृयात्तथानुक्ताः स्त्रियः सुहृदश्च ॥",
  "after": "अथास्य समानवर्णा मध्यमवयाः शुचिरलोलुपा निभृता नातुरा जीवद्वत्सा वत्सला ब्रह्मचारिण्यव्यंगा च बहुक्षीरा शुक्लांबराचारा दीर्घह्रस्वादिदेहदोषअष्टकरहिता लंबोर्ध्वचूचुकातिहीनपीनस्तनदोषरहिता युक्तचूचुका धात्री स्यात्तस्या एव स्तन्यं पिबेत्तच्चोदकपात्रे दुह्यमानमेकतां यदुदकेन सह गच्छति वक्ष्यमाणदोषरहितं च तच्छुद्धमारोग्यं बलजननं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.02.23",
  "kind": "metre",
  "line": "प्रियंगुधातकीपद्मपद्मकदेवदारुक्षौद्रैर्वा ॥",
  "before": "तिक्तकानुरसं स्तन्यं मुद्गमाषपलाशाभ्यां काकोलीयुगेन च शोधयेत् ॥",
  "after": "कषायानुरसं हिंगुसैंधववचाघृतेन ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.02.37",
  "kind": "metre",
  "line": "कफे तु सैंधवपिप्पलीयुक्तं सर्पिर्बालं पाययेत् ॥",
  "before": "उष्णमामदाहज्वरकरं विरेचनं च तच्चंदनोत्पलकमलैः ॥",
  "after": "सैंधवमधुकसंसृष्टं वा मदनपुष्पकल्केन च सक्षौद्रेण स्तनं बालस्य चोष्मालिंपेत्तेन सुखं वमति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.02.40",
  "kind": "metre",
  "line": "नागरसुरदारुसुरेंद्रयवपृश्चीकाक्वाथं वा ॥",
  "before": "धात्रीं तीक्ष्णैर्वामयेत्ततः कृतसंसर्जनां पंचकोलघनवचाऽतिविषाक्वाथं पाययेत् ॥",
  "after": "आरग्वधादिं मुस्तादिं वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.02.54",
  "kind": "metre",
  "line": "रास्त्राऽजमोदाप्रियंगुभद्रदारूणां वा ॥",
  "before": "तत्र धात्रीं बालं च पूर्वमेवाशु वामयेद्विहितसंसर्गयोश्च मुस्तपाठाऽतिविषाकुंभकटुकानां क्वाथं पानाय दद्यात् ॥",
  "after": "पाठातेजोवतीपुनर्नववृश्चिकालीनां वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.02.61",
  "kind": "metre",
  "line": "अनुबंधे च यथाय्याधि प्रतिकुर्वीत ॥",
  "before": "बिल्वभंगस्य वा ॥",
  "after": "दंतोद्भेदश्च सर्वरोगायतनं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.02.71",
  "kind": "metre",
  "line": "यद्यदालंभते तत्तदास्यमानयति ॥",
  "before": "तद्व्रतेन च श्लेष्मणा कंडूस्तदा चूचुकं दंदश्यते ॥",
  "after": "मारुतश्चास्य दंतमूलेषु मूर्च्छति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.02.82",
  "kind": "metre",
  "line": "सौकुमार्याल्पकायतत्वात्सर्वान्नानुपसेवनात ॥",
  "before": "अतस्तदेव भैषज्यं मात्रात्वस्य कनीयसी ॥",
  "after": "स्त्रिग्धा एव सदा बाला घृतक्षीरनिषेवणात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.02.96",
  "kind": "metre",
  "line": "लावतित्तिरित्त्वग्रजः पुष्प रसप्लुतं ॥",
  "before": "वाघ्रीणसकपोतोत्थरजस्तद्वच्च योजितं ॥",
  "after": "द्रुतं करोति बालानां दंतकेसरवन्मुखं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.02.131",
  "kind": "metre",
  "line": "मधुकव्योषषड्ग्रंथिकाः स्पृष्टरोदिताः ॥",
  "before": "हन्याच्च मातृकांदोषान् रोगानन्यांश्च तद्विधान् ॥",
  "after": "क्षीरिणां च प्रवालानि पाठां च विपिच्चेद्द्द्रुते ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.03.1",
  "kind": "metre",
  "line": "अथातो बालग्रहविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति बालामयप्रतिषेधो नाम द्वितीयोऽध्यायः ॥",
  "after": "पुग गृहस्य रक्षार्थं निर्मिताः शूलपाणिना ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.03.97",
  "kind": "metre",
  "line": "इतरौ तु यथाकामं रतिबल्यादिदानतइति ॥",
  "before": "हंतुकामं जयेद्धोमैः सिद्धमंत्रप्रवर्त्तितैः ॥",
  "after": "इति बालग्रहविज्ञानं नाम तृतीयोऽध्यायः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.04.122",
  "kind": "metre",
  "line": "दुष्टग्रहचारणं सर्वोपद्रवेषु च ॥",
  "before": "तत्सादय तेजसा त्वं मम वश्यं च तत्कुरु ॥",
  "after": "त्वया कृतेन होमेन शीघ्रं शांतिः प्रजायते ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.05.148",
  "kind": "metre",
  "line": "इति स्त्रपनविधिर्नाम पंचमोऽध्यायः ॥",
  "before": "रात्रौ प्रसुप्तलोकायां पुष्टिदं सर्वरोगजित् ॥",
  "after": "अथातः प्रत्येकग्रहप्रतिषेधं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.06.25",
  "kind": "metre",
  "line": "रक्तदिव्यवपुर्देवः पातु त्वा क्रौंचसूदनइति ॥",
  "before": "रक्तमाल्यांबरः श्रीमान् रक्तचंदनभूषितः ॥",
  "after": "विशाखे स्कंदोक्तो वचाकुष्ठान्वितः प्रदेहो गोलोमीबिल्वशिरीषयुक्तसुरसादिक्वाथेन परिषेकः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.06.41",
  "kind": "metre",
  "line": "बालं र्बालहितो देवो नैगमेषोऽभिरक्षतु स्वाहा ॥",
  "before": "अजाननश्चलाक्षिभ्रूः कामरूपीमहायशाः ॥",
  "after": "श्वग्रहे गवांक्षी ब्रह्मदंतावृहतीद्वयसारिवाहीबेरकुष्ठभूमिकादंबसुरसमंजरीकरवीरपुष्पैः प्रदेहः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.06.57",
  "kind": "metre",
  "line": "वृक्षमूले कृतावासाः स त्वा पातु पिता महः स्वाहा ॥",
  "before": "यः पिता सर्वबालानां ग्रहाणां पूजितो वरः ॥",
  "after": "शकुन्यां मधुकह्रीवेरोशीरसारिवापद्मकोत्पलशंजिह्वालोध्रप्रियंगुगैरिकैः प्रदेहः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.06.101",
  "kind": "metre",
  "line": "अनंताकुकुटी मर्कटीबिंबीर्धारयेत् ॥",
  "before": "रक्षोघ्नारुष्करैः समधुभिर्धूपो जीर्णभिक्षुसंघाटीकुकवाकुपुरीषाहित्वकेशचर्मभिर्वा ॥",
  "after": "तुंबीचित्रफलामृगैर्वारुजालिनीकाकादनीर्वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.06.102",
  "kind": "metre",
  "line": "तुंबीचित्रफलामृगैर्वारुजालिनीकाकादनीर्वा ॥",
  "before": "अनंताकुकुटी मर्कटीबिंबीर्धारयेत् ॥",
  "after": "पक्वामसांशोणितैश्चतुष्पथे बलिर्गृहे स्नानं मंत्रश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.06.120",
  "kind": "metre",
  "line": "कुष्ठसर्ज रससाधितं तैलमभ्यंगः ॥",
  "before": "अश्वगंधाऽश्वशृंगीसारिवादिविपुनर्नवादिसहाविदारीभिः परिषेकः ॥",
  "after": "धवाश्वकर्णधातकीककुभतिंदुकैर्जीवनीयैश्च पिष्टैर्घृतं शृतं प्राशः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.06.122",
  "kind": "metre",
  "line": "यवयवकलोलूकगृध्रशकृद्भिः सघृतैर्धूपः ॥",
  "before": "धवाश्वकर्णधातकीककुभतिंदुकैर्जीवनीयैश्च पिष्टैर्घृतं शृतं प्राशः ॥",
  "after": "वरुणादिरिष्टशिग्रुकान्विः श्वाविकमूत्रेण गंडकः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.06.128",
  "kind": "metre",
  "line": "सर्षपतैलं वचासिद्धं नेत्रपूरणं ॥",
  "before": "वचाऽश्वगंधाहिंगुलाजसिद्धार्थकैरूद्वर्त्तनं ॥",
  "after": "काकगृध्रगर्दभशकृद्भिर्धूपः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.07.33",
  "kind": "metre",
  "line": "मेघस्तनितविद्युद्वृष्टीर्वाचा विमृजंतमिंद्रेण ॥",
  "before": "तत्रापि गोवृषभइव नर्दंतं दीप्तमुखनयनमादीप्तेन भास्वरेण सर्वमाभाषणमीश्वरेण ॥",
  "after": "धनानि वाचा प्रयच्छंतमाच्छिंदंतं च धनदेन ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.34",
  "kind": "metre",
  "line": "धनानि वाचा प्रयच्छंतमाच्छिंदंतं च धनदेन ॥",
  "before": "मेघस्तनितविद्युद्वृष्टीर्वाचा विमृजंतमिंद्रेण ॥",
  "after": "सुरासवसमगंधं काष्ठतृणरज्ज्वादिसर्वपाशमभिगम्यमानं वरुणेन ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.07.39",
  "kind": "metre",
  "line": "जागरूकं पठंतं हसंतं हसनेन ॥",
  "before": "तत्रापि शिरोधुनानं कलहं कुर्वंतं सहेन ॥",
  "after": "क्रोधनमनिशं निश्वसंतं असंतमातपत्रतो रक्ताक्षं स्तब्धदृष्टिं जिह्वां लोलयंतं सृक्विण्यौ लिहंतमधोमुखशायिनं चलं वक्रगामिनं बिलमवलोकयंतं सर्पवद्धूरं प्रसरंतं जलौघघनदुंदुभिस्वनैर्हृष्यंतं क्षीरमधुघृतगुडमधुस्नानमाल्यप्रियं गात्राणि कंपयंतं दंतैः खादयंतं जलेऽवतीर्णमुत्तरमनिच्छंतमुरगेण ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.07.67",
  "kind": "metre",
  "line": "इति भूतविज्ञानं नाम सप्तमोऽध्यायः ॥",
  "before": "अस्वस्थमनसं दीर्घकालिकं सग्रहं त्यजेत् ॥",
  "after": "अथातो भूतप्रतिषेधं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.08.116",
  "kind": "metre",
  "line": "इति भूतप्रतिषेधो नामाष्टमोऽध्यायः ॥",
  "before": "यथोक्तमिह तत्सर्वं प्रयुंजीत परस्परं ॥",
  "after": "अथातउन्मादप्रतिषेधं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.09.1",
  "kind": "metre",
  "line": "अथातउन्मादप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति भूतप्रतिषेधो नामाष्टमोऽध्यायः ॥",
  "after": "षडुन्मादा भवंति वातपित्तकफसन्निपाताधिविषनिमित्ताः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.09.7",
  "kind": "metre",
  "line": "ततोऽनंतरमुन्मादाभिनिर्वृत्तिरेव ॥",
  "before": "तत्र शिरसः शून्यता चक्षुषोऽस्वस्थत्वं स्वनः कर्णयोरुच्छासाधिक्यमास्यस्त्रवणमन्न्नाभिलाषोऽरोचकोऽविपाको हृदयग्रहोऽस्थाने ध्यानायासमंमोहोद्वेगाः सततं रोमहर्षो ज्वरोऽभीक्ष्णमभीक्ष्णमुन्मत्तचित्तत्वमर्दिताकृतिकरणं व्याधेः स्वप्ने च दर्शनमभीक्ष्ण भ्रांतचलितानवस्थितानामप्रशस्तानां च रूपाणां तिलपीडकचक्राधिरोहणं वातकुंडलिकभिरुन्मथनं निमज्जनं कलुषाणामंभसामावर्त्तेषु चक्षुषोश्चापतर्पणमिति दोषनिमित्तानामुन्मादानां पूर्वरूपाणि ॥",
  "after": "तस्य सामान्यलिंगं मनोबुद्धिस्मृत्यादिसंप्रमोहः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.09.8",
  "kind": "metre",
  "line": "तस्य सामान्यलिंगं मनोबुद्धिस्मृत्यादिसंप्रमोहः ॥",
  "before": "ततोऽनंतरमुन्मादाभिनिर्वृत्तिरेव ॥",
  "after": "ततश्च देहो हतसारथिरिव रथो ऽकर्णधारइव चाप्सु प्लवः सुखदुःखाचारधर्माधर्मप्रलुप्तोऽकस्माद्भवति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.10.1",
  "kind": "metre",
  "line": "अथातोऽपस्मारप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इत्युन्मादप्रतिषेधो नाम नवमोऽध्यायः ॥",
  "after": "स्मृत्यपायो ह्यपस्मारः स धीसत्त्वाभिसंप्लवात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.10.138",
  "kind": "metre",
  "line": "इति तृतीयं भूतविद्यातंत्रं संपूर्णं ॥",
  "before": "इत्यपस्मारप्रतिषेधो नाम दशमोऽध्यायः ॥",
  "after": "भूतनाथांघ्रिपाथोजध्यानविध्वस्तपाप्मनां ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.11.3",
  "kind": "metre",
  "line": "अथातो वर्त्मरोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "मनांसि न मनुष्याणामेनांसि समुपासते ॥",
  "after": "सर्वरोगनिदानोक्तैरहितैः कुपिता मलाः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.12.58",
  "kind": "metre",
  "line": "क्षारेण वा दहेत्तमया वा शलाकया ॥",
  "before": "निर्भुज्य वा वर्मदोषोपहतां वलिं विलिख्य तुंबरुबाकुच्यभयाबीजान्यतमकल्केन प्रतिसारयेत् ॥",
  "after": "उपपक्ष्मकाणि तु लाक्षारसेन लक्षयित्वा संदंशेनोद्धृत्य तनुसूच्यग्रेणाग्निवर्णेन रोमकूपान्दहेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.12.60",
  "kind": "metre",
  "line": "ततश्च पूर्ववत्परिषेको नावनं च ॥",
  "before": "उपपक्ष्मकाणि तु लाक्षारसेन लक्षयित्वा संदंशेनोद्धृत्य तनुसूच्यग्रेणाग्निवर्णेन रोमकूपान्दहेत् ॥",
  "after": "बाह्यालजेर्भिन्त्रलिखितस्य क्षारेणाग्निना वा दाहो व्रणवच्चोपचारः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.13.1",
  "kind": "metre",
  "line": "अथातः संधिसितासितरोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति वर्त्मरोगप्रतिषेधो नाम द्वादशोऽध्यायः ॥",
  "after": "वायुः कुद्धः सिराः प्राप्य जलाभं जलवाहिनीः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.14",
  "kind": "metre",
  "line": "रसक्रियेयं बलासग्रथितशोफोपदेहहरा ॥",
  "before": "ततस्तद्भस्म क्षारकल्पेन परिस्राव्या दर्वीप्रलेपाद्विपचेत् ॥",
  "after": "अयमेव कल्पः फणिज्जकार्जकास्फोताबिल्वकपित्थनिर्गुंड्येरण्डकुमुदोत्पलजातीकुसुमेषु पृथक्कार्यः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.18",
  "kind": "metre",
  "line": "त्रिवृत्रिकटुककट्फलचूर्णो बलासग्रथितं च ॥",
  "before": "शुंठीशिग्रुफलपिप्पलीसैंधवचूर्णो बीजपूरकरसाद्द्द्रुतोऽंजनं पिष्टकमपहरति ॥",
  "after": "बृहतीफलं पिप्पलीतंडुलपूरितं पुटपाकेन पचेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.20",
  "kind": "metre",
  "line": "तैस्तंडुलैश्चूर्णार्ंजनं बलासग्रथितपिष्टकघ्नं ॥",
  "before": "बृहतीफलं पिप्पलीतंडुलपूरितं पुटपाकेन पचेत् ॥",
  "after": "अत्यर्थशोफे हरितालसैंधवशंठीदेवदारुपुनर्नवैर्बिडालपदकः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.32",
  "kind": "metre",
  "line": "वर्जयेच्च कनीनकं सिराश्राम्रुवहाः ॥",
  "before": "अथ तीक्ष्णेन मंडलाग्रेण वृद्धिपत्रेण वोल्लिख्य कनीनकं चोपनीय कनीनकसमेव चतुर्भागशेषं छिंद्यात् ॥",
  "after": "तथा हि नाक्षिव्यापद्यते ॥",
  "note": "14 aksharas"
 }
]