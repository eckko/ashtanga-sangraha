[
 {
  "id": "06.14.80",
  "kind": "metre",
  "line": "सघृतैयैवैरामलकपत्रैश्च बहुशो धूपयेत् ॥",
  "before": "शुंठीसैंधवमधुयष्टिकाबृहतीमूलताम्रजोभिरांमलकरसपिष्टैस्ताम्रपात्रं लेपयेत् ॥",
  "after": "ततो वर्त्तिरेषा महानीला मधुतोयघृष्टा शुद्धशुक्रं नाशयति पूर्वोक्ता च दंतवर्त्तिः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.94",
  "kind": "metre",
  "line": "अथैनमुपनाहप्रचलितस्यांजनं ॥",
  "before": "तद्वदानूपमांसवेसवारो वसापयःसर्पिर्विमिश्रसिद्धः ॥",
  "after": "गोरखराश्वोष्ट्रदंताः समुद्रकफः शंखश्चार्जुनकषायपिष्टा वर्त्तिर्लेखनी ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.14.100",
  "kind": "metre",
  "line": "सिराशुक्रे त्वदृष्टिघ्नेतरुणे व्रणशुक्रवत्कुर्यात् ॥",
  "before": "पुटपाकेन वा बलासग्रथितोक्तक्षाररसक्रियया वा ॥",
  "after": "अंजनं चास्य प्रपौंडरीकमधुकहरिद्रालोहरजोऽंजनबृहतीक्षीरकाकोल्यजापयः पिष्टायवैर्घृतयुतैरामलकीपत्रै श्च पर्यायेण धूपिता वर्त्तिः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.14.103",
  "kind": "metre",
  "line": "समाक्षिकं तु रसांजनं प्रतिसारणं ॥",
  "before": "अप्रशांतमेवमर्मवत्साधयेत् ॥",
  "after": "सप्तमे च दिवसे कुकुटांडपालस्फटिकशंखचंदनमनःशिलालैरश्ववराहदशनैश्च वर्त्ति कृत्वाऽंजयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.15.1",
  "kind": "metre",
  "line": "अथातो दृष्टिरोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति संधिसितासितरोगप्रतिषेधो नाम चतुर्दशोऽध्यायः ॥",
  "after": "सिरानुसारिणि मले प्रथमं पटलं श्रिते ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.16.1",
  "kind": "metre",
  "line": "अथातस्तिमिरप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति दृष्टिरोगविज्ञानं नाम पंचदशोऽध्यायः ॥",
  "after": "तिमिरं काचतां याति काचोऽप्यांध्यमुपेक्षया ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.17.7",
  "kind": "metre",
  "line": "शालिशूकाभरांज्यावृतेव राजीमती ॥",
  "before": "अर्कक्षीरलेशेनेव कूचीकापिंडेनेव चाचिता शर्करा ॥",
  "after": "विषमच्छिन्नदग्धाभा सरुक् छिन्नांशुका ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.17.8",
  "kind": "metre",
  "line": "विषमच्छिन्नदग्धाभा सरुक् छिन्नांशुका ॥",
  "before": "शालिशूकाभरांज्यावृतेव राजीमती ॥",
  "after": "कांस्यसमच्छाया चंद्रकसंस्थाना चंद्रकी ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.17.55",
  "kind": "metre",
  "line": "सिराजालवति तु नेत्रे प्राक्सिराजालमपनयेत् ॥",
  "before": "सिराव्यधाद्रक्तागमो विविधाश्च वेदनास्तत्र स्तन्यमधुकविपकेन सर्पिषा परिषेकोऽपांगे च दाहः ॥",
  "after": "ततो लब्धबलं स्निग्धं च व्यध्येत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.17.58",
  "kind": "metre",
  "line": "शलाकाक्षोभणाद्विस्पंदनतोदभेदपरिमंथाः ॥",
  "before": "अथो शलाकाभ्रमणदोषाः क्षोभणमूर्ध्वमधोऽत्यर्थदृष्टिघट्टनमतिदृष्टिप्रेरणं च ॥",
  "after": "तस्मिन्यष्टीमधुकपटोल्या घृतमृदितया सेको जलौकसश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.17.61",
  "kind": "metre",
  "line": "तत्रोपवासो घृतसेकश्च स्पर्शसुखः ॥",
  "before": "ऊर्ध्वप्रणयनाद्रागोऽतिवेदना च ॥",
  "after": "अधोनयनाच्छूलं रक्तागमश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.17.95",
  "kind": "metre",
  "line": "इति लिंगनाशप्रतिषेधो नाम सप्तदशोऽध्यायः ॥",
  "before": "स्रोतोजविद्रुमशिलार्णवफेनतीक्ष्णैरस्यैव तुल्यमुदितं गुणकल्पनाभिः ॥",
  "after": "अथातः सर्वगताशिरोगविज्ञानं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.19.1",
  "kind": "metre",
  "line": "अथातोऽभिष्यंदप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति सर्वाक्षिरोगविज्ञानं नामाष्टादशोऽध्यायः ॥",
  "after": "अथ खलु सर्वाक्षिरोगी शिरोविरेककवलधूमोपवासानासेवेत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.19.31",
  "kind": "metre",
  "line": "शुद्धे च वातप्रतिश्यायवदास्थापयेत् ॥",
  "before": "पुनश्च स्नेेहयित्वा तिल्वकेन संस्कृतं संयुतं वा तिल्वककषायानुपानं सर्पिर्विरेचनं दद्यात् ॥",
  "after": "अनुवासयेच्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.19.71",
  "kind": "metre",
  "line": "क्षतशुक्तोक्तं च तर्पणं पुटपाकश्च ॥",
  "before": "इक्षुरसपिष्टं वा यष्ट्याह्वं ॥",
  "after": "श्लेष्माधिमंथेऽभिष्यंदे च त्र्यहमुपवासस्तीक्ष्णानि धूमकवलनाव नानि ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.19.148",
  "kind": "metre",
  "line": "षाण्मासिक इति योगस्तिमिराम्र्केदकाच कंडूघ्नः ॥",
  "before": "मरिचामलकजलोद्भवतुत्थांजनता प्यधातुक्रमवृद्धैः ॥",
  "after": "पिप्पलीं सतगरोत्पलपत्रां वर्त्तयेत्समधुकाँ सहरिद्रां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.20.2",
  "kind": "metre",
  "line": "शुष्काक्षिपाके वाताभिष्यंदविहितं सर्पिर्विपचेत् ॥",
  "before": "अथातोऽक्षिपाकपिल्लप्रतिषेधं व्याख्यास्यामः ॥",
  "after": "कुलीररससिद्धं क्षीरसिद्धं वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.20.12",
  "kind": "metre",
  "line": "एतच्चूर्णांजनं दाहोषारागाश्रुहरं ॥",
  "before": "मंजिष्ठानतकटंकटेरी निःक्वाथेन लोहस्रोतौंजनचूर्णमापिंडीभावात्पचेत् ॥",
  "after": "ताम्ररजःसैर्यकमुस्तपुंड्राह्वमधुककालानुसारिवाश्छागेन पयसा पिष्ट्वा पिंडांजनं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.20.14",
  "kind": "metre",
  "line": "आनूपवसा शुंठीसैंधवचूर्णान्विता स्नेहांजनं ॥",
  "before": "ताम्ररजःसैर्यकमुस्तपुंड्राह्वमधुककालानुसारिवाश्छागेन पयसा पिष्ट्वा पिंडांजनं ॥",
  "after": "एवमप्यशांतौ मधुकसिद्धः शताह्वाचूर्णयुक्तो घृतमंदस्तथा पयो वा बस्तिः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.20.17",
  "kind": "metre",
  "line": "द्राक्षाभयानिर्यूहस्त्रिवृत्कल्कवान् सघृतो विरेकः ॥",
  "before": "सशोफाल्यल्पशोफयोस्तु स्निग्धस्य सिरां विध्येत् ॥",
  "after": "विरिक्तस्य यथादोषोदयमास्थापनं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.20.18",
  "kind": "metre",
  "line": "विरिक्तस्य यथादोषोदयमास्थापनं ॥",
  "before": "द्राक्षाभयानिर्यूहस्त्रिवृत्कल्कवान् सघृतो विरेकः ॥",
  "after": "ततः पिंडस्विन्नशिरसः सर्षपतैलेन सैंधवयुतेन सर्पिःफणिज्जकचूर्णसंमृष्टेन वा तैलेन शिरोविरेकः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.20.26",
  "kind": "metre",
  "line": "तद्वल्लोहे गोमूत्रघृष्टं घृतधूपितं ॥",
  "before": "शशशिरःकपालं ससैंधवं कांस्ये स्तन्यघृष्टं संधावो वेदनाघ्नः ॥",
  "after": "शिग्रुपल्लवरसश्च ताम्रघृष्टो घृतधूपितः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.20.32",
  "kind": "metre",
  "line": "संधावांजितं चाक्षि स्तन्येन चानु सिंचेत् ॥",
  "before": "नृकपालं कांस्ये तिलोदकघृष्टं घृताक्तानिंबपत्रधूपितं शोफपांडुघर्षाश्रुशूलरागघ्नं ॥",
  "after": "त्रिःपरं च तैर्नीजयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.20.41",
  "kind": "metre",
  "line": "अम्लोषितं पित्ताभिष्यंदवदुपाचरेत् ॥",
  "before": "इत्थमपि शोफानुवृत्तौ पुनरास्रावशिरोविरेकाश्च ॥",
  "after": "पित्तासाधनं चेक्षेत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.20.47",
  "kind": "metre",
  "line": "कुकूणकस्य सिराव्यधः विरिक्तस्य वर्त्मनी लिखेत् ॥",
  "before": "अथ पिल्लाक्षिरोगिणं स्ने हयित्वा वामयेत् ॥",
  "after": "सकृल्लेखनादशुद्धौ पुनर्लेखयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.21.1",
  "kind": "metre",
  "line": "अथातः कर्णरोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इत्यक्षिपाकपिल्लप्रतिषेधो नाम विंशोऽध्यायः ॥",
  "after": "प्रतिश्यायजलक्रीडाकर्णकंडूयनैर्मरुत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.22.28",
  "kind": "metre",
  "line": "पित्तजे तु शूले प्रातः शर्करायुतं सर्पिः पाययेत् ॥",
  "before": "विशेषतः प्रवातशीतांबुपानं शिरः स्नानं च ॥",
  "after": "ततः स्निग्धं विरेचयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.45",
  "kind": "metre",
  "line": "रक्तजे पैत्तिकवत्सिद्धिः सिराव्यधश्च ॥",
  "before": "कफघ्नाँश्च गंडूषान्धारयेत् ॥",
  "after": "पकेषु कर्णमूलेषु पूयप्रवाहिषु यथास्वं धूमनस्यगंडूषवमनान्याचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.22.72",
  "kind": "metre",
  "line": "सश्वयथुपरि स्रावे मंदश्रुतेर्वमनमाचरेत् ॥",
  "before": "अथ कर्णौ मुसाविव भवतस्तत्समीपे यथोक्तां सिरां मोक्षयेत् ॥",
  "after": "प्रतीनाहे स्नेहस्वेदक्किन्नं कर्णं कर्णशोधनेन विशोध्य तैलस्य पूरयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.93",
  "kind": "metre",
  "line": "अयमभ्यंगः पाल्याः परं मांसजननः ॥",
  "before": "शतावर्यरश्वगंधैरंडपयस्याजीवकक्षीरे सिद्धेन वा गोधाप्रतुदविष्किरानूपोदकमांसवसामज्जानं सर्पिः सर्षपतैलं च यथालाभं संसृज्यार्कालर्कबलाऽतिबलानंताविदारिगंधाजलशुकमधुवर्गप्रतीवापं विपचेत् ॥",
  "after": "एवमपि तु या क्षीयते पाली तस्या यद्दुष्टं तच्छित्त्वा विधिवत्संधाय युक्तेनैव क्रमेणोपचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.22.95",
  "kind": "metre",
  "line": "तंत्रिकामपि चैवमेव नस्याभ्यंगादिभिर्यापयेत् ॥",
  "before": "एवमपि तु या क्षीयते पाली तस्या यद्दुष्टं तच्छित्त्वा विधिवत्संधाय युक्तेनैव क्रमेणोपचरेत् ॥",
  "after": "परियोढकेऽप्ययमेवविधिः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.99",
  "kind": "metre",
  "line": "उत्पाते जलौकोभिरपनीतरक्ते शीतैः प्रदेहः ॥",
  "before": "तिलमधुकप्रपौंडरीकसिद्धार्थकक्षीरकृतयोत्कारिकयोपनाहः ॥",
  "after": "तिलमधुकसारिवोत्पलकरो ध्रकदंबबलाऽऽज्रंजू पल्लवैः सधान्याम्लं तैलं साधितमभ्यंगः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.101",
  "kind": "metre",
  "line": "तथा क्षीरसर्पिर्विस्पोक्तानि च घृतानि ॥",
  "before": "तिलमधुकसारिवोत्पलकरो ध्रकदंबबलाऽऽज्रंजू पल्लवैः सधान्याम्लं तैलं साधितमभ्यंगः ॥",
  "after": "उन्मंथे तीक्ष्णैः शिरोविरैकैस्तिक्तसर्षपरोध्रहरिद्राद्वयैः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.22.107",
  "kind": "metre",
  "line": "लाक्षाविडंगविपक्वतैलेनाभ्यंजयेत् ॥",
  "before": "दुःखवर्द्धने जंब्वाम्राशमंतकपत्रक्वाथपरिषिक्तां कर्णपालीं तैलेनाभ्यज्य यष्टीमधुहरिद्राप्रपौंडरीकमंजिष्ठाचूर्णैनावचूर्णयेत् ॥",
  "after": "लेहिकापिडिकां कर्णपालीं बहुशो गोमयपिंडस्विन्नामुरभ्रमूत्रपिष्टैः कृमिघ्नैरालेपयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.22.124",
  "kind": "metre",
  "line": "एभिरेव च यथास्वं स्नेहानभ्यंगार्थे प्रकल्पयेत् ॥",
  "before": "स्राववत्यां मधुमधुकमधुपर्णीभिर्लेपः ॥",
  "after": "अथ रोगतो बलाद्वा छिन्नकर्णमनुसंदध्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.22.133",
  "kind": "metre",
  "line": "यात्वेकैव पाली स्थूला पृथ्वी स्थिरा च स्यात् ॥",
  "before": "अण्वादिविषमयोस्तुपरस्परविपर्ययेण ॥",
  "after": "तां द्विधा पाटयित्वोपरि छित्वा संदध्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.22.134",
  "kind": "metre",
  "line": "तां द्विधा पाटयित्वोपरि छित्वा संदध्यात् ॥",
  "before": "यात्वेकैव पाली स्थूला पृथ्वी स्थिरा च स्यात् ॥",
  "after": "गंडोत्कृत्तेन वासशोणितेन सानुबंधेन मांसेन पालीं कल्पयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.23.1",
  "kind": "metre",
  "line": "अथातो नासारोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति कर्णरोगप्रतिषेधो नाम द्वाविंशोऽध्यायः ॥",
  "after": "अवश्ययाानिलरजोभाष्यातिस्वप्नजागरैः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.23.56",
  "kind": "metre",
  "line": "इति नासारोगविज्ञानीयो नाम त्रयोविंशोऽध्यायः ॥",
  "before": "अष्टादशानामित्येषां यापयेद्दुष्टपीनसं ॥",
  "after": "अथातो नासारोगप्रतिषेधं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.24.36",
  "kind": "metre",
  "line": "रक्तजे पैत्तिकरक्तपित्तयोश्च विधिः ॥",
  "before": "रसांजनातिविषा मुस्तभद्रदारुसाधितं चात्र तैलं नावनं ॥",
  "after": "दुष्टप्रतिश्याये व्योषचित्रकयवक्षारबीजकविडंगत्वक्लवणत्रयीमांसरसप्रतीवापविपक्वं सक्षौद्रं सर्पिः पाययेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.24.38",
  "kind": "metre",
  "line": "जीर्णे घृते जांगलरसेन तैलोपसेकं भोजयेत् ॥",
  "before": "दुष्टप्रतिश्याये व्योषचित्रकयवक्षारबीजकविडंगत्वक्लवणत्रयीमांसरसप्रतीवापविपक्वं सक्षौद्रं सर्पिः पाययेत् ॥",
  "after": "स्निग्धं च प्रतिश्यायवदुपाचरेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.24.41",
  "kind": "metre",
  "line": "विशुद्धघ्राणस्रोतं च पुनरुपस्नेह्य विरेचयेत् ॥",
  "before": "पक्केऽवपीडं व्योषेंद्रयवविडंगसारजीरकसैंधवैर्बस्तमूत्रपिष्टैर्दद्यात् ॥",
  "after": "भृष्टान् यवान् भूस्तृणकाभ्रातकजीरकत्रिवृतायुक्तगोमूत्रे क्वाथयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.24.71",
  "kind": "metre",
  "line": "अर्शांसि विधिवत् क्षारेणाग्निना वा दहेत् ॥",
  "before": "कृतवमनस्य चास्य नस्यधूमौ योजयेत् ॥",
  "after": "स्थूलानि तु शस्त्रेण स्पृष्ट्वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.24.80",
  "kind": "metre",
  "line": "चलं प्रमृष्टं च व्रणं शलाकया दहेत् ॥",
  "before": "छेद्यं चोच्छेदयेत् ॥",
  "after": "तैलेन वाऽग्निदग्धं म्रक्षयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.24.86",
  "kind": "metre",
  "line": "मांसमेदःसन्निपातार्शोऽर्बुदानि च साधयेदिति ॥",
  "before": "तत्रश्च शीताः प्रदेहसेकाः शीतैरेव च साधितान्यभ्यंगनस्यपानानि ॥",
  "after": "भवति चात्र ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.24.90",
  "kind": "metre",
  "line": "इति नासारोगप्रतिषेधो नाम चतुर्विंशोऽध्यायः ॥",
  "before": "गंधाज्ञानं च वीसर्पो मूर्च्छा छिंद्यादतःसमं ॥",
  "after": "अथातो मुखरोगविज्ञानं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.25.1",
  "kind": "metre",
  "line": "अथातो मुखरोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति नासारोगप्रतिषेधो नाम चतुर्विंशोऽध्यायः ॥",
  "after": "मात्स्यमाहिषवाराहपिशितामकमूलकं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.26.20",
  "kind": "metre",
  "line": "स्वेदनस्यधूमकवलांश्च कफघ्नानवचारयेत् ॥",
  "before": "कुष्ठतगरदंतीश्यामाविडहरितालविडंगैर्वा ॥",
  "after": "मेदोने दंतच्छदं स्वेदयित्वा वृद्धिपत्रेण विपाट्य शुद्धमेतदग्निनाऽनु दहेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.44",
  "kind": "metre",
  "line": "उषायां कर्पूरपाटलीत्वक्चूर्णेन प्रतिसारणं ॥",
  "before": "दंतशर्करां दंतमूलान्यपीडयन्दंतलेखनेन विलिख्य क्षारतैलेनावसे चयेत् ॥",
  "after": "सदा च दंतधावनादि निषेवेत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.77",
  "kind": "metre",
  "line": "वृश्चिकाली कुष्ठकटुका यवक्षारैः प्रतिसारणं ॥",
  "before": "दंतविद्रधौ तिक्तकटुकषायोष्णैः समूत्रैः कवलालेपाश्च ॥",
  "after": "पाकं तु रुक्षशीतैरंतर्बहिः प्रयुक्तैर्धारयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.88",
  "kind": "metre",
  "line": "कटुतीक्ष्णैः कवलस्तैलं वा यवक्षारवचूर्णेतं ॥",
  "before": "विद्रद्धं तु बडिशेन मुचुंड्या वा गृहीत्वा मंडलाग्रेण छित्वा तीक्ष्णैः प्रतिसारयेत् ॥",
  "after": "विदर्भे दंतमूलानि शस्त्रेण विशोध्य क्षारं प्रयुज्य घृतमंडं गंडूषे दद्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.90",
  "kind": "metre",
  "line": "रोध्रप्रियंगुमंजिष्ठामधुकचूर्णैः प्रतिसारणं ॥",
  "before": "विदर्भे दंतमूलानि शस्त्रेण विशोध्य क्षारं प्रयुज्य घृतमंडं गंडूषे दद्यात् ॥",
  "after": "काकोलीयष्टीमधुशर्कराविपक्वं तैलं नावनं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.91",
  "kind": "metre",
  "line": "काकोलीयष्टीमधुशर्कराविपक्वं तैलं नावनं ॥",
  "before": "रोध्रप्रियंगुमंजिष्ठामधुकचूर्णैः प्रतिसारणं ॥",
  "after": "दंतनाडी मेषयित्वा संयुतां शस्त्रेण विचारयित्वा तदाश्रितं दंतशेषमुद्धृत्यशलाकया दहेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.115",
  "kind": "metre",
  "line": "तालुसंघाते पुप्पुटे कच्छपे च नवे विधिरयं ॥",
  "before": "सम्यक्छिन्नायां पूर्ववत्प्रतिसारणादै्यः ॥",
  "after": "शस्त्रकर्मणि तु विशेषः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.155",
  "kind": "metre",
  "line": "पर्य्यायशः स्वेदः शोणितावसेचनं च ॥",
  "before": "तीक्ष्णान् वमनादीन् शीलयेत् ॥",
  "after": "तथाऽनुपशमे पाचयित्वा व्रणवदुभावप्युपचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.26.160",
  "kind": "metre",
  "line": "प्रातः प्रातश्चासनादिसाररजो गोमूत्रेण पिबेत् ॥",
  "before": "पूर्वोक्तैः प्रलेपः ॥",
  "after": "एवमशांतौ च शस्त्रेण विदार्य मेदो विशोध्य सीम्येत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.26.169",
  "kind": "metre",
  "line": "तन्निष्ठीवनं सर्वमुखामयनाडीघ्नं ॥",
  "before": "दारुहरिद्राद्वितुलां विंशतिगुणेऽम्भसि श्रपयित्वा तं काथं सगैरिकमादर्वोप्रलेपासाधितं क्षौद्रयुक्तं घृतभाजने निदध्यात् ॥",
  "after": "अयमेव पृथक्कल्पो यष्टीमधुकपतोलीनिंबाटरूषकजातिरोध्रारिमेदत्रिफलाजंबूखदिरत्वचां ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.26.175",
  "kind": "metre",
  "line": "सौरभं सौमनस्यं रुचिं च जनयंति ॥",
  "before": "ता गुलिका वदनस्थाः सर्वान्मुखरोगान् जयंति ॥",
  "after": "एषामेव च कल्ककषायैस्तैलं साधितं कवले नियुंज्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.26.178",
  "kind": "metre",
  "line": "पिप्पल्येलाळवणोत्तमैः प्रतिसारणं ॥",
  "before": "तत्र वातजे मुखपाके दशमूलकंकोलीरास्नामधुकसारिवाकाथेन कुष्ठकल्केन च सिद्धं तैलं नस्यं गंडूषश्च त्रैहिको धूमः ॥",
  "after": "पैत्तिके क्षीरेक्षुरसद्राक्षारसमशर्करोदकैर्गंडूषः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.26.184",
  "kind": "metre",
  "line": "स्थिरासु तु पिटिकासु प्राक् शाकादिपत्रेण लेखनं ॥",
  "before": "कफजे कटुकक्षारलवणैः प्रतिसारणं ॥",
  "after": "मुष्कक पलाशामलकक्षारगोमूत्रैर्गंडूषः ॥",
  "note": "18 aksharas"
 }
]