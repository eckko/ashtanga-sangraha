[
 {
  "id": "04.19.22",
  "kind": "sample",
  "line": "वर्षाभू मयूरकपंचकोलैर्वा ॥",
  "before": "महौषधमुरंगीभ्यां वा ॥",
  "after": "कुंभनिकुंभव्योषामिकैर्वा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.19.48",
  "kind": "sample",
  "line": "घृतक्षीरक्षीरिवृक्षवेतसमंजिष्ठामृणालचन्दनादिभिः शीतवीर्यैः कल्पयेदभ्यंगादीन् ॥",
  "before": "अभयाऽमरदारुमधुककटुकादंतीचंदनवेतसपटोलमूर्वादार्वीत्रायमाणोपकुल्याविशालाक्वाथः ससर्पिरुपयुक्तः श्वयथुविषमज्वरदाहपिपासार्तिसंतापसन्निपातानुपशमयति ॥",
  "after": "कफोत्थे त्वारग्वधादिसाधितं तैलं पिबेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.21.83",
  "kind": "sample",
  "line": "षण्मासांतरितं कुष्ठैः क्रमिमेहैर्विमुच्यते ॥",
  "before": "कषायं तं परिस्त्राव्य निदध्यात्ताम्रभाजने ॥",
  "after": "निंबारिष्ट इति ख्यातो वरुणेनैष निर्मितः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.22.28",
  "kind": "sample",
  "line": "लिंपेत्कामं लेपनाद्द्वे दनायां लेपे योज्यः शंखनाभिर्जलेन ॥",
  "before": "विध्वाऽन्येद्युः स्फोटकान्कंटकैस्तन्बिस्ती सोभिर्घृष्याशुक्रवर्च्या ॥",
  "after": "व्योषसर्षपनिशागृहधूमैर्यवशूकपट्टुचित्रककुष्ठैः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.23.104",
  "kind": "sample",
  "line": "सिद्ध्यति चास्मिंश्छंखानाध्मापयेत् ॥",
  "before": "प्रतिवापश्चात्र हैमवत दक्षिणापथकाश्चगंधावातघ्नानि च द्रव्याणि ॥",
  "after": "दुंदुभीन्वादयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.23.158",
  "kind": "sample",
  "line": "समूलजालं विपचेत्ससारणीं तुलोन्मितां पादघृते घटेंऽभसः ॥",
  "before": "भग्नजर्जरितांगानां पथ्यमग्नेश्च दीपनं ॥",
  "after": "पृथक् सतैलं दधि तत्समं क्षिपेत्समं च ताभ्यां विजयां ततः पचेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.24.106",
  "kind": "sample",
  "line": "कफपित्ताविरुद्धं यद्यच्च वातानुलोमनं ॥",
  "before": "एरंडतैलं वर्चस्थे बस्तिस्नेहाश्च भेदिनः ॥",
  "after": "सर्वस्थानावृतेऽप्याशु तत्कार्यं मातरिश्वनि ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.01.2",
  "kind": "sample",
  "line": "अथातो वमनकल्पं व्याख्यास्यामः ॥",
  "before": "॥ श्रीगणेशाय नमः ॥",
  "after": "इति ह स्माहुरात्रेयादयो महर्षयः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.01.57",
  "kind": "sample",
  "line": "ततस्तस्मिंस्त्रिभागघृते घृतसमानि पिष्ट्वा तुंबीबीजानि तदर्द्धाशिकानि च प्रत्येकं जीमुतमहाजालिनीवत्सककृतवेधनानि क्वाथतुल्यमेव च त्रिकटुकमावपेत् ॥",
  "before": "बिल्वमूलप्रस्थकाथेन वा तुंबीबीजानि काधयेत् ॥",
  "after": "ततः पुनरपि श्रुत्वा लेहं साधयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.04.36",
  "kind": "sample",
  "line": "तान्सर्षपतैलामदनैः सकुष्ठैरक्षप्रमाणैः प्रसृतैश्च युक्तान् ॥",
  "before": "पक्त्वा कुलत्थान् बृहतीं च तोये रसस्य तस्य प्रसृता दश स्युः ॥",
  "after": "क्षौद्रस्य तैलस्य फलाह्वयस्य क्षारस्य तैलस्य च सार्षपस्य ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.04.108",
  "kind": "sample",
  "line": "इति बस्तिकल्पो नाम चतुर्थोऽध्यायः ॥",
  "before": "दद्याद्विशोधनीयान्दोषनिबद्धायुषो ये च ॥",
  "after": "अथातः सिद्धबस्तिकल्पं व्याख्यास्यामः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.05.2",
  "kind": "sample",
  "line": "सिद्धबस्तीन्प्रयुंजीत सर्वदा सर्वदेहिनां ॥",
  "before": "अथातः सिद्धबस्तिकल्पं व्याख्यास्यामः ॥",
  "after": "निर्व्यापदो बहुफलान्वलबुद्धि करान्सुखान् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.05.14",
  "kind": "sample",
  "line": "सकाथो मधु पैंढुंथा शताव्हा हिंगु सैंधवं ॥",
  "before": "एष युक्तरथो बस्तिः सवचापिप्पली फलः ॥",
  "after": "सुरदारु च रास्ना च बस्तिदोषहरः शिवः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.05.94",
  "kind": "sample",
  "line": "शतावरीं सहचरं काकनासां पळांशिकं ॥",
  "before": "गुडूच्यैंरंडभूतीकभार्गीवृषकशेरिषं ॥",
  "after": "यवमाषातसीकोलकुलत्थान्प्रसृतोन्मितान् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.07.77",
  "kind": "sample",
  "line": "अन्योन्यप्रत्यनीकानां रसानां स्निग्धरूक्षयोः ॥",
  "before": "स्वादुतिक्तौ तथा भूयः कषायकटुकौ ततः ॥",
  "after": "व्यत्यासादुपयोगेन क्रमात्तं प्रकृतिं नयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "05.08.38",
  "kind": "sample",
  "line": "स तु भेद्यान्यौषधान्यणुशो भेदयित्वा छेद्यानि च छेदयित्वा प्रक्षाल्योदकेन शुचौ रुक्षायामधःप्रलिप्तायां ताम्रायोमृन्मयान्यतमस्थाल्यां समावाप्य बहुलपानीयग्राहितानामौषधानामाकलथ्य यावता मुक्तरसता स्यात्तावदुदकमासेचयेच्छोषयेच्च ॥",
  "before": "क्वाथो निर्यूहः ॥",
  "after": "अथाग्नावधिश्रित्य महत्यासने सुखोपविष्टः सर्वतः सततमवलोकयन् दर्व्या च विघट्टयन् मृदुना च परितः समुपगच्छता ऽनलेन साधयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.01.63",
  "kind": "sample",
  "line": "बोधयेत्सहसा सुप्तं नो न चैनं समुत्क्षिपेत् ॥",
  "before": "वचा द्यकुष्ठश्रीवेष्टसर्षपैर्धूपयेत्सदा ॥",
  "after": "तथा ह्यस्य समुन्नासो वेगरोधश्च जायते ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.01.180",
  "kind": "sample",
  "line": "नीरुकरूपवत्सायाः संयुक्तं पयसा च गोः ॥",
  "before": "तेन कौंतीवचाकुष्ठकृष्णासर्पेपसैंधवैः ॥",
  "after": "पुष्ययोगे घृतप्रस्थं सहेमशकलं शृतं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.03.64",
  "kind": "sample",
  "line": "हिध्मोद्वेगस्तनद्वेषवैवर्ण्यस्वरतीक्ष्णताः ॥",
  "before": "दृष्टिसादोऽक्षिरुकंडूपोथकीजन्म शूनता ॥",
  "after": "वेपथुर्मत्स्यगंधत्वमथवा साम्लगंधिता ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.05.132",
  "kind": "sample",
  "line": "प्रभुर्मृत्युरलक्ष्मीश्च कालरात्रिश्च सा रतिः ॥",
  "before": "तेजसा चर्षिविप्राणां मयाऽद्य न्हापितो भवान् ॥",
  "after": "लंबा च लोहशंकुश्च पूतना कूटपूतना ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.07.54",
  "kind": "sample",
  "line": "वैद्यं दृष्ट्वा कुप्यंतं अम्रद्धो जिनं बह्वाशिनं भस्मगुंठनशयनं स्त्रियो मार्गे रुंधानं मूत्रपुरीषविमर्द्दिनं निस्तेजसा ॥",
  "before": "सर्वगात्राणि स्पंदयंतं मुहुर्धावंतं भीषणमाणं नवाङ्कुशेन ॥",
  "after": "प्रेताकृतिचेष्टागंधं तृणच्छेदिनं भीरुमाहारद्विषं प्रेतेन ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.08.25",
  "kind": "sample",
  "line": "छायाशुष्का कृता वर्त्तिर्मत्स्यपित्तद्रुतां ऽजनं ॥",
  "before": "मंजिष्ठा द्वे निशे कृष्णा बस्तमूत्रेण पेषयेत् ॥",
  "after": "नक्तमालफलं व्योषं बिल्वस्योनाकयोर्जटा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.14.87",
  "kind": "sample",
  "line": "अनेन संबाधांजनेनांजयेत् ॥",
  "before": "शंखं ताम्रे स्तन्येन प्रघृष्य सघृतैर्यवैः शमीपत्रैश्च धूपयेत् ॥",
  "after": "तद्वत्सुवर्ण रूप्यमयो वा घृष्टं सघृतैर्बदरीपत्रैर्धूपितमंजनं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.16.110",
  "kind": "sample",
  "line": "सारिवापद्मकोशीरमुक्ताशाबरचंदनैः ॥",
  "before": "शीतलेपनसेकादीन् मुखे मूर्द्धनि शीलयेत् ॥",
  "after": "वर्त्तिः शस्ताऽंजने चूर्णस्तथा पद्मोत्पलांजनैः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.16.127",
  "kind": "sample",
  "line": "पत्रपीताभ्रव्योषशीलाल नतसैंधवैः ॥",
  "before": "पीताख्या दिनिशा कुष्ठनतपत्रकणोष्णैः ॥",
  "after": "मनोह्वाशंखसिंधूत्थमरिचैस्तिमिरं जयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.17.55",
  "kind": "sample",
  "line": "सिराजालवति तु नेत्रे प्राक्सिराजालमपनयेत् ॥",
  "before": "सिराव्यधाद्रक्तागमो विविधाश्च वेदनास्तत्र स्तन्यमधुकविपकेन सर्पिषा परिषेकोऽपांगे च दाहः ॥",
  "after": "ततो लब्धबलं स्निग्धं च व्यध्येत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.17.58",
  "kind": "sample",
  "line": "शलाकाक्षोभणाद्विस्पंदनतोदभेदपरिमंथाः ॥",
  "before": "अथो शलाकाभ्रमणदोषाः क्षोभणमूर्ध्वमधोऽत्यर्थदृष्टिघट्टनमतिदृष्टिप्रेरणं च ॥",
  "after": "तस्मिन्यष्टीमधुकपटोल्या घृतमृदितया सेको जलौकसश्च ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.18.31",
  "kind": "sample",
  "line": "शंखदंतकपोलेषु कपाले चातिरुक्कराः ॥",
  "before": "अधिमंथा यथास्वं च सर्वे स्यंदाधिकव्यथाः ॥",
  "after": "वातपित्तोत्तरं घर्षतोदभेदोपदेहवत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.19.13",
  "kind": "sample",
  "line": "एतदवगुंठनं शूलदाहाश्रुश्वयथुकंडूपापकाक्लेदोपदेहहरं ॥",
  "before": "श्वेतररोध्रत्वचं बहिर्विलिखितां निंबत्रकल्कमध्नप्रलिप्तां पुटपाकवत्पक्त्वाऽर्द्धपलोन्मितां मरिचचतुष्टययुक्तां श्लक्ष्णरजीकृतां वस्त्रबद्धामक्षण्यवकिरेत् ॥",
  "after": "तथैव च पोटलिकयाऽऽश्रोतनकालेऽबंतिसोमाप्लुत्याऽऽश्रोतयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.21.16",
  "kind": "sample",
  "line": "पर्यायादुष्णशीतेच्छं जायते श्रुतिजाड्यवत् ॥",
  "before": "शूलं समुदितैर्दोषैः सशोफज्वरतीव्ररुक् ॥",
  "after": "पक्कं सितासितारक्तघ्नपूयप्रवाहि च ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.22.180",
  "kind": "sample",
  "line": "इति कर्णरोगप्रतिषेधो नाम द्वाविंशोऽध्यायः ॥",
  "before": "निवेशिते यथान्यायं सद्यश्छेदेऽप्ययं विधिः ॥",
  "after": "अथातो नासारोगविज्ञानं व्याख्यास्यामः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.26.72",
  "kind": "sample",
  "line": "पृथक्पर्णीविडंगविदारीमधुकपयस्यासुरदारुपक्वं तैलं गंडूषो नस्यं च ॥",
  "before": "मरिचकुष्ठमधुप्रियंगुभिर्वा लाक्षापत्तंगगैरिकर सांजनशुंठीसैंधवैर्मधुघृतमंडयुक्तैः प्रतिसारणं ॥",
  "after": "मधुरसिद्धमेव वा सार्पिः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.26.118",
  "kind": "sample",
  "line": "तालुपाकेऽप्यपक्वस्य श्वयथोः कासीसरसांजनक्षौद्रेण प्रतिसारणं ॥",
  "before": "तत्र हि विलेखनं ॥",
  "after": "मधुरकषायशीतैर्गंडूषः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.27.6",
  "kind": "sample",
  "line": "असात्म्यगंधदुष्टाम्भोभाष्याद्यैश्च शिरोगताः ॥",
  "before": "उपधानमृजाभ्यंगद्वेषार्धःप्रततेक्षणैः ॥",
  "after": "जनयंत्यामयान्दोषास्तत्रमारुत्तोकोपतः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.28.36",
  "kind": "sample",
  "line": "विशेषतस्तु कृष्णतिलशतावरीनीलोत्पलदूर्वापुनर्नवैर्लेपः ॥",
  "before": "विसर्पवच्च ॥",
  "after": "कफजे शिरोभितापे लंघयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.28.142",
  "kind": "sample",
  "line": "कृष्णाप्रलेपो वक्त्रस्य हरिलोमावलीहितः ॥",
  "before": "क्षीरं प्रियालं यष्ट्याह्नं जीवनीयो गणस्तिलाः ॥",
  "after": "तिलाः सामलकाः पद्मकिंजल्को मधुकं मधु ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.48",
  "kind": "sample",
  "line": "ग्राम्यानूपौदकामिषवेसवारकृशरापायसोत्कारिकाभिः स्वेदो योज्यः ॥",
  "before": "श्रुतासृजां च शोफानां व्रणानामपि चेदृशां ॥",
  "after": "सदाहशूलांस्तु तिलानतसीं च भृष्ट्वा पयसि निर्वाप्य तेनैव क्षीरेण पिष्ट्वा प्रलेपयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.62",
  "kind": "sample",
  "line": "पाकाभिमुखे च शोफै यथेष्टमातुरं भोजयेत् ॥",
  "before": "शिग्रुशणफलचित्रककिण्वनिष्पावसर्षपतिलातसीसक्तुकोलगृहधूमैरम्लपिष्टैः सुखोष्णैः स्निग्धैः सलवणैरुत्कारिकां कृत्वा तया प्रलिप्तमैरंडपत्रेणाच्छाद्य बध्नीयात् ॥",
  "after": "पाचनार्थं पाकवेदनाशास्त्रकर्मसहनार्थं च ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.30.130",
  "kind": "sample",
  "line": "द्वावाद्यौ पंचमूलाख्यौ गणौ यश्चानिलापहः ॥",
  "before": "रुजादिमति वक्त्रस्थे यथास्वं कवलो हितः ॥",
  "after": "ते व्रणे वातिके योज्याः कषायादिषु सप्तसु ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.31.56",
  "kind": "sample",
  "line": "मुखबाष्पोष्णचैलेन स्विन्नं नयनमाहतं ॥",
  "before": "स पयस्कैः परं तद्धि सर्वनेत्राभिघातजित् ॥",
  "after": "मरिचेनांबुपिष्टेन पिचुयुक्तेन पूरयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.31.74",
  "kind": "sample",
  "line": "स्नेहसेकं न कुर्वीत तत्र क्लियति हि व्रणः ॥",
  "before": "कार्यश्च गोष्फणाबंधः कट्यामावेश्य पट्टकं ॥",
  "after": "कालानुसार्यगुर्वेलाजातीचंदनपद्मकैः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.32.117",
  "kind": "sample",
  "line": "पक्वमांससिरास्नायुः सं धिः श्लेषं न गच्छति ॥",
  "before": "भग्नं नैति यथा पाकं प्रयतेत तथा भिषक् ॥",
  "after": "वातव्याधिविनिर्दिष्टान्स्नेहान् भग्नस्य योजयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.36.20",
  "kind": "sample",
  "line": "सा विद्धा वातपित्ताभ्यां ताभ्यामेव च गर्दभी ॥",
  "before": "या पद्मकर्णिकाकारा पिटिका पिटिकाचिता ॥",
  "after": "मंडला विपुलोत्सन्ना सरागा पिटिकाचिता ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.36.52",
  "kind": "sample",
  "line": "कृष्णान्वेदनांस्त्वक्स्थान्मपांस्तानेव चोन्नतान् ॥",
  "before": "अंगुल्योऽलसमित्याहुस्तिलाभांस्तिलकालकान् ॥",
  "after": "मेषेभ्यश्चोन्नततरान् चर्मकीलान् सितासितान् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.41.42",
  "kind": "sample",
  "line": "व्यक्तभोगः पुमान्धीरः स्त्री स्यात्तस्माद्विपर्यये ॥",
  "before": "तत्रोर्ध्वदृग्महाकायनेत्रजिह्वशिरः स्वरः ॥",
  "after": "आयता चपला क्लीबः सुकुमारो जडाकृतिः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.46.122",
  "kind": "sample",
  "line": "कृमश्छुच्छुंदरेणोग्रो ग्रीवास्तंभो विसूचिका ॥",
  "before": "काकादनीकाकमाचीस्वरसेन घृतं शृतं ॥",
  "after": "यवनालर्षभीक्षीरं बृहत्यौ छात्र पाययेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.46.142",
  "kind": "sample",
  "line": "निहन्ति विषमालर्कै घनवृन्दमिवानिलः ॥",
  "before": "ऐकध्यं पललं तैलं रूपिकायाः पयो गुडः ॥",
  "after": "लशुनोष्णवैदेहीवचा गोपित्तकल्कितः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.46.146",
  "kind": "sample",
  "line": "स क्वाथः शीतलः पीतः परं श्वविषभेषजं ॥",
  "before": "जलवेतसपत्रत्वङ्मूलं क्षुण्णं पचेज्जले ॥",
  "after": "तत्सिद्धं च घृतं पाननस्याभ्यंजनलेपने ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.47.32",
  "kind": "sample",
  "line": "हिध्मायां शंखकनकटुकास्वर्णगैरिकं ॥",
  "before": "गुडनागरवैदेहीविजयामलकानि च ॥",
  "after": "वेल्लशुंठीकणोशीररजनीद्वितयानि वा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.47.158",
  "kind": "sample",
  "line": "शीतमेव च कुर्वीत विधानं विषरोगिणां ॥",
  "before": "तेजस्वितां च लभते राजकस्यापि मध्यगः ॥",
  "after": "मुक्त्वा कीटविषं तद्धि शीतेनातिप्रबर्द्धते ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.48.11",
  "kind": "sample",
  "line": "विषपीतं च कुशलो दंशयेत्पवनाशिभिः ॥",
  "before": "युंज्यान्मूलविषं तस्माद्दष्टानां पानलेपयोः ॥",
  "after": "न विषप्रतिमं किंचिन्निर्विषीकरणं विषे ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.48.39",
  "kind": "sample",
  "line": "यस्तु संरोपितो भोगी धूमं वक्त्राद्विमुंचति ॥",
  "before": "देहे विषोद्भवे लेपः सक्तुक्षीरघृतैर्हितः ॥",
  "after": "दंडाग्रे पिशितं बध्वा बहुशस्तेन दंशयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.48.121",
  "kind": "sample",
  "line": "विषं सर्पिः. सिताक्षौद्रं तिमिरापहंमंजनं ॥",
  "before": "नष्टशुक्रः पयोद्राक्षाकपिकच्छुवचाविषं ॥",
  "after": "विषं चैकमजाक्षीरकल्कितं विषधूपितं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.49.309",
  "kind": "sample",
  "line": "भांति वृक्षा इव पुनः प्ररूढनवपल्लवाः ॥",
  "before": "कुष्ठिनः शीर्यमाणांगास्ते जातांगुलिना सिकाः ॥",
  "after": "खदिरांभसा पिबेद्वा रविसेवी तया यवागूं वा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.49.523",
  "kind": "sample",
  "line": "पचेत्पलानि द्रोणेऽपां कांचुक्याः पलविंशतिः ॥",
  "before": "शतानि पंचवर्षाणि जीवेद्देवइवोजितः ॥",
  "after": "अष्टांशशिष्टे तु घृतात्प्रस्थं क्षीरसमं पिबेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.49.593",
  "kind": "sample",
  "line": "शिलाभ्यो यच्च यज्जातं धातोस्तत्तद्गुणं वदेत् ॥",
  "before": "सर्वदोषप्रशमनं सर्वरोगविनाशनं ॥",
  "after": "सर्वं च तिक्तकटुकं नात्युष्णं कटुपाकतः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.49.703",
  "kind": "sample",
  "line": "क्षीराहारश्चावलिहानः प्रयतात्मा मृत्युद्वारं शोषमपोह्यचिरेण ॥",
  "before": "सायश्चूर्णं माक्षिकधातुं मधुमिश्रं व्योषोपेतं पर्वतनिर्यासासमैतं ॥",
  "after": "लोहं सर्पिमाक्षिकधातुं मधुमिश्रं धात्रीचूर्ण केसरमंबुप्रभवानां ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.49.732",
  "kind": "sample",
  "line": "लिह्याद्वा मधुसर्पिर्भ्यां धात्रीस्वरसभावितं ॥",
  "before": "लिह्यान्पूर्ववन्मासं शतं जीवेन्महामतिः ॥",
  "after": "क्षीरेण वा पिबन्मासं शतं जीवेदरुक् सुखी ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.49.767",
  "kind": "sample",
  "line": "हरीतकीमागधिकाविडंगशशांकलेखामलकच्छवीनां ॥",
  "before": "सर्पिर्मधुभ्याअदतः शरीरं कालाग्रदूती न जरा दुनोति ॥",
  "after": "सितोपलातैलघृतान्वितानां गदा न लेढारमभिद्रवंति ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "06.49.838",
  "kind": "sample",
  "line": "नाशं नयंते सहसैव देहं सम्यक्प्रयुक्तानि तथैव वृद्धिं ॥",
  "before": "अदेशकालोपहितान्यसात्म्यान्यत्युष्णतीक्ष्णानि यथौषधानि ॥",
  "after": "जित्वा तस्मादिंद्रियादीन्सुदुष्टान्कालोपेतः श्रद्दधानो यथावत् ॥",
  "note": "ordinary line, no flag"
 }
]