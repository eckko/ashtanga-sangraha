[
 {
  "id": "01.07.494",
  "kind": "sample",
  "line": "ऋतुष्वन्यो रसेभ्वन्यो रूक्षस्नेहबलक्रमः ॥",
  "before": "समयोगेऽपि घर्माद्या वातादिचयहेतवः ॥",
  "after": "रसायनीकाकमाची सद्यः पर्युषिता विषं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.08.176",
  "kind": "sample",
  "line": "शीते घर्मो हिमश्चोष्णे मारुतो विषसंयुतः ॥",
  "before": "कलशांतर्गतान् दग्ध्वा प्रक्षिपेत्सबिषेंऽभसि ॥",
  "after": "अभ्रमूर्च्छादिकारी च शिग्वादिस्तन्त्र चेष्यते ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.09.123",
  "kind": "sample",
  "line": "कुर्यात्संज्ञापहां तंद्रां दारुणां मोहकारिणीं ॥",
  "before": "कफोऽल्पो वायुनोद्धूतो धमनीः संनिरुध्य तु ॥",
  "after": "उन्मीलितविनिर्भुग्नेपरिवर्तिततारके ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.10.65",
  "kind": "sample",
  "line": "यथाऽग्निसाम्यं तु प्राक् द्रवमुपशुष्कं वाऽश्नीयात् ॥",
  "before": "मध्ये भोज्यमिति ॥",
  "after": "प्रागेव तु गुरु स्वादुस्निग्धं च ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.12.179",
  "kind": "sample",
  "line": "सर्वे सतिक्तमधुरं चंदनं शिशिरं परं ॥",
  "before": "पित्तास्रविषतृद्दाहक्लमहृद् गुरु रूक्षणं ॥",
  "after": "लघु रक्तं तथोशीरं वालकं पाचनं च तत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.14.18",
  "kind": "sample",
  "line": "कोशातकीदेवदालीसमलाकारवेल्लिकास्वरसा अर्कक्षीरमुष्णोदकं चेत्युभयात्मकानि ॥",
  "before": "क्षीरमस्तुमद्यधान्याम्लमुत्राणिचेति विरेचनोपयोगीनि ॥",
  "after": "बस्तिपु तु तेषु तेष्ववस्थांतरेषु यान्युपयुज्यंते द्रव्याणि तान्येवासंख्येयत्वान्रोपदिश्यंते ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.16.40",
  "kind": "sample",
  "line": "अर्काल्कौ नागदंती विशल्या भार्ङ्गी रास्ना वृश्चिकाली प्रकीर्या ॥",
  "before": "योनिदोषहरः स्तंभी वर्ण्यो विषविनाशनः ॥",
  "after": "प्रत्यक्पुष्पी पीततैलोदकीर्या श्वेतायुग्मंतापसानां च वृक्षः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.20.129",
  "kind": "sample",
  "line": "निद्रातंद्रोपलेपांश्च हृद्रोगं गात्रगौरवं ॥",
  "before": "सन्निुरुध्यात्तदा कुर्यान्मंदाग्नित्वंशिरोपहं ॥",
  "after": "ष्ठीवनं पित्तकफयोर्नखादीनां च पीततां ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.21.64",
  "kind": "sample",
  "line": "विज्ञाय कर्मभिः स्वैस्वैर्दोषोद्रेकं यथाबलं ॥",
  "before": "स्वाशये तु प्रदुष्टानां स्थितैवं ह्याशुकारिता ॥",
  "after": "भेषजं योजयेत्तत्र तंत्रीकुर्यान्नतु क्रमं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.22.49",
  "kind": "sample",
  "line": "यथावा कृत्स्नं विकारजातं वैश्वरूप्येण व्यवस्थितं गुणत्रयमव्यतिरिच्यवर्तते ॥",
  "before": "यथैव शकुनिः सर्वतः परिपतन् दिवसं स्वां छायां नातिवर्तते ॥",
  "after": "तथैवेदमपि कृत्स्नं विकारजातं दोषत्रयमिति ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.24.46",
  "kind": "sample",
  "line": "दौर्गंध्यं गद्गदत्वं च भवेन्मेदोतिपुष्टितः ॥",
  "before": "आयासाक्षमताजाड्यमल्पायुर्बलवेगता ॥",
  "after": "स्रोतस्सु मेदोरुद्धेषु वायुः कोष्ठे विशेषतः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.25.46",
  "kind": "sample",
  "line": "ह्रस्वा पेया सुखा सा हि परिहारे नुं वर्त्तते ॥",
  "before": "अपथ्यरिक्तकोष्ठैश्च ज्वरातीसारकासिभिः ॥",
  "after": "चिराच्च बल्या न रुजे व्यापन्नाऽपि प्रकल्पते ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.25.148",
  "kind": "sample",
  "line": "सिद्धांश्च चतुरः स्नेहान् बदरत्रिफलारसैः ॥",
  "before": "घृतं च सिद्धंतुल्यांशं सद्यःस्नेहनमुत्तमं ॥",
  "after": "योनिशुक्रामयहरान्सद्यःस्नेहान्प्रयोजयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.27.62",
  "kind": "sample",
  "line": "हीनवेगस्तु पिप्पल्यामलकसर्षपकल्कलबणोष्णोदकै: पुन: पुन: प्रवर्त्तयेत् ॥",
  "before": "यावत्कफच्छेद: केवलौषधप्रवृत्ति:पित्तदर्शनं वा ॥",
  "after": "अभूतवमनासहिष्णुर्द्व्यहं त्र्यहं वा विश्रम्य ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.27.101",
  "kind": "sample",
  "line": "बहुवातः क्रूरः सदुर्विरेच्यस्त्रिफलातिल्वकत्रिवृच्चीलिनीफलादिभिरपि ॥",
  "before": "स विरिच्यते क्षीरेक्षुरसाम्लतक्रमस्तुगुडद्राक्षारसर्पिर्निषमयोग्णोदकपीलुद्राक्षापूगफलादिभिरपि ॥",
  "after": "बहुश्लेष्मासमदोषश्र्व मध्यः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.28.106",
  "kind": "sample",
  "line": "न च तमनुवासयेत् ॥",
  "before": "नैव चानागतस्नेहमपि द्वितीये ऽहनि ॥",
  "after": "आगमनकालस्तु परो यामत्रयं ततः परम्नागच्छंतमहोरात्रमुपेक्षेत ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.28.134",
  "kind": "sample",
  "line": "तीर्यक्प्रणीतेहि न याति धारा गुदे व्रणः स्याच्चलिते च नेत्रे ॥",
  "before": "अपि च ॥",
  "after": "दत्तः शनैर्नाशयमेति बस्तिः कंठं प्रधावेदनिपीडितस्तु ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.29.4",
  "kind": "sample",
  "line": "नासाहि शिरसो द्वारं तत्रावसेचितमौषधं स्त्रोतःशृंगाटकं प्राप्य व्याप्यमूर्द्धानं नेत्रश्रोत्रकंठदिसिरामुखानि च मुंजादिषीिकामिवासक्तामूंर्ध्वजत्रुगतां वैकारिकीमशेषामाशु दोषसंहतिमुत्तमांगादपकर्षति ॥",
  "before": "नावनं नस्तःकर्मेति च संज्ञां लभते ॥",
  "after": "तन्त्रिधा विरेचनं बृंहणं शमनं च ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.32.45",
  "kind": "sample",
  "line": "ताम्रमयआयसे वा कषायं ॥",
  "before": "वैदूर्यमयेऽश्ममये वा कटुकं ॥",
  "after": "नलप्लक्षपद्मकस्फटिकशंखान्यतमे शीतं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.36.85",
  "kind": "sample",
  "line": "एवं साधु वहति ॥",
  "before": "पृष्ठमध्ये चातुरं पीडयेत् ॥",
  "after": "सम्यक्प्रवृत्ते तु कफानिलोपशमक्ताविच्छेदार्थमुष्णलवणतैलविंदुभिः सिरामुखं सिंचेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.38.49",
  "kind": "sample",
  "line": "स्त्रीणां तु स्मृतिसंस्पर्शदर्शनैश्चलिते शुक्रे ॥",
  "before": "विशेषतश्च दिवास्वप्नाद्व्रणे शोफकंडूरागरुक्यूप्यवृद्धिः ॥",
  "after": "शुक्रे व्यवायजान्दोषानसंसर्गेप्यवामुयात् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.02.35",
  "kind": "sample",
  "line": "तथा च द्विहृदयां नारीं दौर्हदिनीत्याचक्षते ॥",
  "before": "तस्मात्तयोस्ताभिः श्रद्धा संपद्यते॥",
  "after": "अन्ये तु पक्षत्रयात्प्रभृत्यापंचमान्मासाद्दौर्हदकालमाहुः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.03.25",
  "kind": "sample",
  "line": "नेति षंढकाथो गर्भस्यपैंगल्याबाधभयात् ॥",
  "before": "अष्टमे क्षीरयवागूं सर्पिष्मतीं पिबेत् ॥",
  "after": "अस्ति पैंगल्याबाधस्तथाप्येवं कुर्वीत ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.03.92",
  "kind": "sample",
  "line": "महावृक्षक्षीरं वा मूर्ध्न्यनुषेचयेत् ॥",
  "before": "लाङ्गलीमुलकल्केन वा पाणिमुदरं चालिम्पेत् ॥",
  "after": "कुष्ठताली सकल्कं बिल्वबिल्वजयूषमैरेयासवसुरामन्दान्यतमेन व्योषतीक्ष्णोष्णेन वाऽम्लेन कुलत्थरसेन मधुकपिप्पलीसंपाकेन वा पाययेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.03.105",
  "kind": "sample",
  "line": "तेन च पूतेन स्नेहवता फलादियुक्तेन यथोक्तास्थापनद्रव्यसिद्धेन कटुतैलेनोत्तरबस्तिं दद्यात् ॥",
  "before": "सिद्धार्थककुष्ठलाङ्गलीमहावृक्षक्षीरमिश्रेण वा सुरामण्डेन शाल्मलीवृन्तानि वा स्त्रिञ्चान्यापोथ्यपञ्चमूलकषाये विमर्दयेत् ॥",
  "after": "शिग्रुसुमुखमरिचाजाजिचित्रककल्कक्षीरगोमूत्रसिद्धेन वा कटुतैलेनाऽनुवासयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.05.6",
  "kind": "sample",
  "line": "भूतानामेवच दृष्टादृष्टविविधकर्मवशादनेकरूपात् सन्निवेशविशेषादाकृतिप्रमाणस्नेहदीप्तिस्वरादीनां सारूप्यमसारूप्यं वा सूक्ष्मस्थूलतारतम्यभेदभिन्नमतिबहुप्रकारं निष्पद्यते ॥",
  "before": "महागुणमयेभ्यश्चखपवनतेजोजलभूम्यारुनेभ्यो महाभूतेभ्यश्चेतनाधिष्ठितेभ्योऽभिनिर्वृत्तिः ॥",
  "after": "तत्र सत्वबहुलमाकाशं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.05.55",
  "kind": "sample",
  "line": "पंचमी पुरीषधरानाम मा ह्यंत्रामपक्वाशयाश्रिता कोष्ठांतरुंदुकस्थं मलं विभजति ॥",
  "before": "चतुर्थी श्लेष्मधरा नाम तस्तस्थेन हि श्लेष्मणाऽऽश्लेषिताः सर्वसंधयो दृढा भवंति सोपांगावाक्षाः ॥",
  "after": "षष्ठी पित्तधरा नाम पक्वामाशयमध्यस्था सा ह्यन्तरग्न्यधिष्ठानतयाऽऽमाशयात्पक्वाशयोन्मुखमन्नं बलेन विधार्य्य पित्ततेजसा शोषयंतीपचति पक्कं च विमुंचति ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.05.219",
  "kind": "sample",
  "line": "तत्र दशस्तनयोः तासां यौवने परिवृद्धिर्भवति ॥",
  "before": "स्त्रीणां तु विंशतिरधिका ॥",
  "after": "दश योनौ ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.06.41",
  "kind": "sample",
  "line": "एष विभागः पित्तश्लेष्मशुद्धरक्तेष्वपि ॥",
  "before": "तासां यथास्वं तुर्यांशविभागेन पंचसप्तत्यधिकं शतकमनिलरक्तं वहति ॥",
  "after": "स्थिता ह्येवं देहमनुगृह्णंति दोषाः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.06.106",
  "kind": "sample",
  "line": "अन्ये पुनराचक्षते ॥",
  "before": "तत्र पित्तविशेषः पाचकसंज्ञोऽग्निरिति प्रागभिहितः ॥",
  "after": "दोषधातुमलसन्निपातजनितोऽन्तरूष्मा यथानिर्दिष्टाधिष्ठानकर्माऽग्निरिति ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.08.79",
  "kind": "sample",
  "line": "प्रमाणं पुनः स्वांगुलैः ॥",
  "before": "तद्विपरीतस्त्वसारः मध्यो मध्यगुणः ॥",
  "after": "पादांगुष्ठप्रदेशिन्यौ द्व्यंगुलायते तिस्रोऽन्याः क्रमेणोत्तरोत्तरं पंचमभागहीनास्तन्नखहीना वा॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.10.8",
  "kind": "sample",
  "line": "महर्षीणां समीपस्थांयो न पश्यत्यरुंधतीं ॥",
  "before": "रूपं व्याकृति तद्वच्च यः पश्यति स नश्यति ॥",
  "after": "ध्रुवमाकाशगंगां वा न स पश्यति तां समां ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.10.69",
  "kind": "sample",
  "line": "॥ इति विकृतेहाविज्ञानीयो नाम दशमोऽध्यायः ॥",
  "before": "रिष्टज्ञानादृतस्तस्मात्सर्वदैव भवेद्भिषक् ॥",
  "after": "अथातो विकृतव्याधिविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "02.11.24",
  "kind": "sample",
  "line": "मस्तु लुंगमषीपूयवेसवारंबुमाक्षिकैः ॥",
  "before": "तुल्यस्तैलघृतक्षीरदधिमज्जवसासवैः ॥",
  "after": "अति रक्तासितस्निग्धपूत्यच्छघनवेदनः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.02.33",
  "kind": "sample",
  "line": "काले यथास्वं सर्वेषां प्रवृत्तिर्वृद्धिरेव वा ॥",
  "before": "अंगेषु शीतपिटकास्तंद्रोदर्द्दः कफोद्भवे ॥",
  "after": "निदानोक्तानुपशयो विपरीतौपशायिता ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.03.47",
  "kind": "sample",
  "line": "क्षिपन्निवाक्षिणी पृष्ठमुरःपार्श्वे च पीडयन् ॥",
  "before": "वाहिनीर्गलमूर्द्धस्थास्ततोऽंगान्युत्क्षिपन्निव ॥",
  "after": "विवृतवान्मुखेनैति भिन्नकंस्योपमध्वनिः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.06.11",
  "kind": "sample",
  "line": "निरंकुश इव व्यालो न किंचिन्नाचरेज्जडः ॥",
  "before": "मध्यमोत्तमयोः संधिं प्राप्य राजसतामसः ॥",
  "after": "इयं भूमिरवद्यानां दौःशील्स्येदमस्पदं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.08.63",
  "kind": "sample",
  "line": "॥ इत्यतीसारग्रहणीनिदानं नामाष्टमॊऽध्यायः ॥",
  "before": "अर्शांसि ग्रहणीत्यष्टौ महारोगाः सुदुस्तराः ॥",
  "after": "अथातो मूत्रघातनिदानं व्याख्यास्यामः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.11.9",
  "kind": "sample",
  "line": "आंतरो दारुणतरो गंभीरो गुल्मवद्धनः ॥",
  "before": "बाह्योऽत्र तत्र तत्रांगे दारुणो ग्रंथितोन्नत: ॥",
  "after": "वल्मीकवत्समुच्छ्रायी शीघ्रघात्यग्निशस्त्रवत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.11.83",
  "kind": "sample",
  "line": "स्वदोषाधिष्ठानश्च सर्वो भवति गुल्मः ॥",
  "before": "गुल्मएव च वर्द्धते न कुक्षिः ॥",
  "after": "तस्माच्चिरेण नैव पाकमैति ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.12.76",
  "kind": "sample",
  "line": "ततःस्यादुदरं तृष्णागुदस्रुतिरुजान्वितं ॥",
  "before": "वर्द्धयेतां तदेवांबु तत्स्थानादुदराश्रितौ ॥",
  "after": "कासश्वासारुचियुतं नानावर्णसिराततं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.13.56",
  "kind": "sample",
  "line": "विसूच्यलसकच्छर्दिगर्भविसर्पपांडवः ॥",
  "before": "श्वासकासातिसारार्शोजठरप्रदरज्वराः ॥",
  "after": "अन्ये च मिथ्योपक्रान्तास्तैर्दोषा वक्षसि स्थिताः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.14.2",
  "kind": "sample",
  "line": "मिथ्याहारविहारेण विशेषेण विरोधिना ॥",
  "before": "अथातः कुष्ठकृमिनिदानं व्याख्यास्यामः ॥",
  "after": "साधुनिंदावधांन्यस्वरहरणाद्यैश्च सेवितैः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.14.20",
  "kind": "sample",
  "line": "सर्वैः स्यात्काकणं पूर्वं त्रिकं दद्रुसकाकणं ॥",
  "before": "पुंडरीकं सविस्फोटं पामा चर्मदलं तथा ॥",
  "after": "पुंडरीकषर्जिन्हे च महाकुष्ठानि सप्त तु ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "03.14.35",
  "kind": "sample",
  "line": "श्लक्ष्णपीताभपर्यंतं मंडलं परिमंडलं ॥",
  "before": "अन्योन्यसक्तमुत्सन्नं बहुकंडूश्रुतिकृमि ॥",
  "after": "सकंडूिपडिका श्यावा लसीकाढ्या विचर्चिका ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.01.136",
  "kind": "sample",
  "line": "शालिपर्णीबलाद्राक्षासारिवाच्छिन्नसंभवाः ॥",
  "before": "कृष्णापुनर्नवाद्राक्षाशताव्हागुडसा रिवाः ॥",
  "after": "आरग्वधो बला रास्त्रा काश्मर्यं मधुकं गुडः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.04.136",
  "kind": "sample",
  "line": "पाठाशुंठीशठीमूर्वागवाक्षीपिप्पलीघनं ॥",
  "before": "रोचनं दीपनं स्वर्यं पीनसश्वासकासजित् ॥",
  "after": "पिष्ट्वा घर्मांबुना हिंगुसैंधवाभ्यां युतं पिबेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.229",
  "kind": "sample",
  "line": "सिद्धेऽस्मिंश्चूर्णीतौ क्षारौ पंचैवलवणानि च ॥",
  "before": "पिष्टैः कर्कटशृंग्या च समैः सर्पिर्वि पाचयेत् ॥",
  "after": "दत्वा युक्त्या पिबेन्मात्रां क्षयकासनिपीडितः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.05.262",
  "kind": "sample",
  "line": "खादेन्मधुघृताभ्यां वा लिह्यात्कासहरं परं ॥",
  "before": "बला रास्ना च तच्चूर्णं समुस्तं समशर्करं ॥",
  "after": "तद्वन्मरिचचूर्णं वा सघृतक्षौद्रशर्करं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.06.94",
  "kind": "sample",
  "line": "घृतमाक्षिकतै लैर्वा व्यूषणं क्षारसंयुतं ॥",
  "before": "लिह्याद्वा पिप्पलीद्राक्षापथ्याशृंगीदुरालभाः ॥",
  "after": "पिप्पलीक्षौद्रयुक्तौ वा रसौ धात्रीकपित्थयोः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.23",
  "kind": "sample",
  "line": "ऊर्ध्वमेव हरेत्पित्तं स्वादुतिक्तैर्विशुद्धिमान् ॥",
  "before": "सर्पिर्वा तैल्वकं योज्यं वृद्धं च श्लेष्मघाममं ॥",
  "after": "पिबेन्मंडं यवागूं वा लाजैः समधुशर्करं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.08.175",
  "kind": "sample",
  "line": "तृळि क्ष्मान्मांसरसं मंथं वा ससितं पिबेत् ॥",
  "before": "अञ्चात्यधान्मंडमुष्णं हिमं मंथं च कालवित् ॥",
  "after": "आतपात्ससितं मंथं यवकोलजसक्तुभिः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.09.15",
  "kind": "sample",
  "line": "यौगिकं विधिवद्युक्तं मद्यमेव निहंति तान् ॥",
  "before": "जीर्णाममचदोषस्य प्रकाँक्षालाघवे सति ॥",
  "after": "क्षारो हियाति माधुर्यं शीघ्र मम्लोपसंहितः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.09.127",
  "kind": "sample",
  "line": "पिबेदालोड्य दुग्धेन सूक्ष्मतांतवनाळितं ॥",
  "before": "मधुकयष्टीत्वक्कष्णाकेसरं श्लक्ष्णचूर्णितं ॥",
  "after": "नाविक्षोभ्य मनो मद्यं शरीरमविहन्च वा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.11.15",
  "kind": "sample",
  "line": "तद्वच्चाऽभयाविडंगपाठाशुंठीबिडलवणानि वा ॥",
  "before": "जलजलदबिल्वपेशिकाशुंठीधानकानां वा वचादिवर्गे वा कथितं चूर्णितं वा ॥",
  "after": "मुस्तापिप्पलीद्वयवपाठातेजोवतीर्वा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.12.112",
  "kind": "sample",
  "line": "एष सारश्चिकित्साया यदग्नेः परिरक्षणं ॥",
  "before": "अग्निमूलं बलं पुंसां बलमूलं च जीवितं ॥",
  "after": "इति ग्रहणीदोषचिकित्सितं नाम द्वादशोऽध्यायः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.13.26",
  "kind": "sample",
  "line": "एलाश्मभेदकशिलाजतुपिप्पलीनां चूर्णानि तंडुलजलाुलितानि पीत्वा ॥",
  "before": "अपिच ॥",
  "after": "तद्वद्गुडेन सहितान्युपयुज्यमानान्यसन्नमृत्यु रपि जीवति मूत्रकृच्छ्री ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.14.11",
  "kind": "sample",
  "line": "अत्यपतर्पणेन हि प्रमेहिणो विशेषेण मूत्रकृच्छ्रबस्तिमेंढ्रशूलगुल्मातिकाश्यंभ्रमादीनां संभवः ॥",
  "before": "ततश्च जांगलरसैः क्रमेण संतर्पयेत् ॥",
  "after": "ततोऽनुबंधरक्षणार्थं शमनार्हस्य च शमनमवचारयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.14.22",
  "kind": "sample",
  "line": "पित्तप्रमेहेषु रोध्रसेव्यार्जुनचंदनानां निंबामृतामलकपटोलानां वा ॥",
  "before": "पाठामिग्नमंथचविकात्रिफलानां वा ॥",
  "after": "शिरीषसर्जार्जुनकेसरागां वा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "04.18.82",
  "kind": "sample",
  "line": "हारिद्रनेत्रमूत्रत्वक् श्वेतवर्चास्तदा नरः ॥",
  "before": "कफसंमूर्च्छितो वायुर्यदापित्तं बहिः क्षिपेत् ॥",
  "after": "भवेत्साटोपविष्टंभो गुरुणा हृदयेन च ॥",
  "note": "ordinary line, no flag"
 }
]