  "note": "18 aksharas"
 },
 {
  "id": "01.09.27",
  "kind": "metre",
  "line": "पिप्पलीमरिचाभ्यां मधुना गुडेन वा काकमाचीं ॥",
  "before": "दघ्ना तक्रेण तालफलेन वा कदलीफलं ॥",
  "after": "तामेव मत्स्यपचने श्रृंगबेरपचने वा भाजने सिद्धामन्यत्र नाभ्यवहरेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.09.34",
  "kind": "metre",
  "line": "सुराकृशरापायसाश्चैकध्यं विरुद्धाः ॥",
  "before": "अंगारशूल्यो भासः ॥",
  "after": "मधुसर्पिर्वसातैलोदकानि समधुतानि द्विशस्त्रिशः समस्तानि वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.09.41",
  "kind": "metre",
  "line": "उपोदका तिलकल्करसिद्धा हेतुरतिसारस्य ॥",
  "before": "पायसो मंधानुपानो विरुद्धः श्लेष्माणं चातिकोपयति ॥",
  "after": "बलाका वारुण्या कुल्माषैश्च विरुद्धा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.09.43",
  "kind": "metre",
  "line": "सैव वराहवसापरिभृष्टा सद्यो व्यापादयति ॥",
  "before": "बलाका वारुण्या कुल्माषैश्च विरुद्धा ॥",
  "after": "गोधालावितित्तिरि मयूरकपिंजलाश्चैंरंडदार्वभिसिद्धा ऐंरंडतैलसंमूर्च्छिताः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.09.48",
  "kind": "metre",
  "line": "शीतोष्णं नवपुराणमामपक्वं च नैकध्यमद्यात् ॥",
  "before": "तथा मत्स्यानिस्तलनसिद्धाः पिप्पल्यः ॥",
  "after": "सलिलाऽभ्यवगाहः सहसोष्णाभितप्तस्य त्वग्दृष्ट्योहरुपघाताय तृष्णाऽभिवृद्धये च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.09.55",
  "kind": "metre",
  "line": "तद्विरोधः पुनरतिप्रसंगभ्यान्नोक्तः ॥",
  "before": "भेषजद्रव्याणां तु यथोपदेशमेव प्रयोगो न्याय्यतरः ॥",
  "after": "न च तद्विज्ञानमेकांतभद्रकं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.09.75",
  "kind": "metre",
  "line": "तद्भेदांतरस्तद्विरोधोऽपि निवर्त्तते ॥",
  "before": "योगादिभेदाद्यद्यद्वा पथ्यानामप्यपथ्यता ॥",
  "after": "पादांशेन त्यजेत्सात्म्यमहितं हितमाचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.8",
  "kind": "metre",
  "line": "क्षीरेक्षुव्रीहिमाषानूपामिषादयो गुरव इति ॥",
  "before": "तत्र स्वभावतो दिव्यौदकरक्तशालिषष्टिकमुद्गैणलावादयो लघवः ॥",
  "after": "ते खल्वपि संयोगादिविशेषैरन्यथात्वंप्रतिपद्यंते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.10.10",
  "kind": "metre",
  "line": "तत्र संयोगो नाम द्वयोर्बहूनां वा संहतीभावः ॥",
  "before": "ते खल्वपि संयोगादिविशेषैरन्यथात्वंप्रतिपद्यंते ॥",
  "after": "स विशेषमारभते यन्नैकशो नैकदोषार्णि द्रव्याणि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.10.14",
  "kind": "metre",
  "line": "देशोद्रव्यस्योपयोक्तुश्चोत्पत्यवस्थानं ॥",
  "before": "मात्रापुनः पिंडपरिमाणतः समुदायेन प्रतिद्रव्यापेक्षया चाहारराशिः ॥",
  "after": "तत्र पुनरुपयोक्ता स्वस्थातुरत्वतःप्रकृतिभेदतश्च परीक्ष्यः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.36",
  "kind": "metre",
  "line": "सात्म्यविपरीतमनुपशयादसात्म्यं ॥",
  "before": "तत्र सात्म्यं नाम सहात्मना भवत्यतस्तदौचित्यादुपशेतइत्येके ॥",
  "after": "अन्ये पुनः प्रकृतिवयोदेशर्तुदोषव्याधिवशेन सात्म्यं बहुविधमिच्छंति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.55",
  "kind": "metre",
  "line": "रागरखांडवसंढकान्वज्रवैडूर्यविचित्रेषु ॥",
  "before": "खलकं रकांवलकान्कांस्येषु ॥",
  "after": "घृतमायसे ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.10.58",
  "kind": "metre",
  "line": "पानीयपानकानि च मृद्धेमरस्फटिकमयेषु ॥",
  "before": "पयः सुशीतं ताम्रमये ॥",
  "after": "ओदनं च विस्तीर्णे मनोरमे स्थाने ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.10.68",
  "kind": "metre",
  "line": "अंते रुक्षं द्रवमितररसंयुक्तं च ॥",
  "before": "मध्येऽम्ललवणं ॥",
  "after": "तत्रमंदाग्नेर्द्वोभेन समुत्तेजितोष्मणोऽन्यदुपयुक्तं सम्यक्रूपाकमैति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.72",
  "kind": "metre",
  "line": "उष्णं पिष्टमयेष्वन्येषु च दुर्जरेषु हेमंते च ॥",
  "before": "तच्छीतं दधिमधुगोधूममद्यविशेषेषु सर्वेषु च विदाहिषु शरद्ग्रीष्मयोश्च ॥",
  "after": "द्रवद्रव्यविज्ञानीयं चेक्षेत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.10.79",
  "kind": "metre",
  "line": "मस्त्वेव वा दध्नि कुच्चीकाकिलाटयोश्च ॥",
  "before": "त्रिफलोदकं तु सक्षौद्रं श्लेष्मणिप्रायशश्चाक्षिगलरोगेषु ॥",
  "after": "धान्याम्ल मस्तु तक्रं वा शाकावरान्नेषु ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.80",
  "kind": "metre",
  "line": "धान्याम्ल मस्तु तक्रं वा शाकावरान्नेषु ॥",
  "before": "मस्त्वेव वा दध्नि कुच्चीकाकिलाटयोश्च ॥",
  "after": "मद्यं मांसेषु फलाम्लमंबुवाऽऽसवांश्च विविधान् विभज्य प्रयोजयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.92",
  "kind": "metre",
  "line": "समासेनान्नविपरीतमविरोधि च ॥",
  "before": "अपिच ॥",
  "after": "अनुपानं खलु तर्पयति प्रीणयत्यूर्जयति बृंहयति देहस्य पर्याप्तिमभिवर्द्धयति भुक्तमवसादयत्यन्नसंघातं भिनत्ति मार्दवमापादर्ति क्लेदयति सुखपरिणामिनामाशुव्यवायितां चाहारमुपनयति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.96",
  "kind": "metre",
  "line": "पीत्वा च भाष्यगेयाध्वस्वाप्नान्न शीलयेत् ॥",
  "before": "तेषां हि प्रदूष्यामाशयमुःकंठस्थितमाहारजं श्लेहमासाद्य तदभिष्यंदाग्निसादाच्छर्द्यादीनामयान्विदध्यात् ॥",
  "after": "पानं तु प्रक्लिन्नदेहमेहकंठअक्षिरोगव्रणिनइति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.10.100",
  "kind": "metre",
  "line": "यानप्लवनवाहनान्यातपांश्च भुक्तवान्वर्जयेत् ॥",
  "before": "द्रवोत्तरभोजनस्तु शय्यां नातिसेवेत ॥",
  "after": "आहारपरिणामकराः पुनरूष्मा वायुःक्लेदः स्नेहः कालः समयोगश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.10.140",
  "kind": "metre",
  "line": "॥ इत्यन्नपानविधिर्नाम दशमोऽध्यायः ॥",
  "before": "तनुमपि तनुजां रुजं त्वनाप्य व्रजति नरः स समाशतस्य पारं ॥",
  "after": "अथातो मात्राशितीयमध्यायं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.11.47",
  "kind": "metre",
  "line": "रास्त्राकटफलपडुंयथारहनीद्वयजोंगकैः ॥",
  "before": "क्वाथं सुखोष्णं लवणप्रगाढं विसूचिकाऽजीर्णविषादमर्दनं ॥",
  "after": "गुग्गुल्वतिविपाकुष्टपत्रव्याघ्रनखांबुदैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.11.76",
  "kind": "metre",
  "line": "बहुदोषाणां पुनर्दोषअवसेचनमेव कार्यं ॥",
  "before": "लंघनपाचनाभ्यां मध्यमलो वातांतपाभ्यां पांसुभस्मावकिरणैरिव चानतिमहान्सलिलाशयः ॥",
  "after": "न ह्यस्त्राविते पल्बलोदकौघेशाल्यादिपुष्टिर्भवति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.11.127",
  "kind": "metre",
  "line": "॥ इति मात्राशितीयो नामैकादशोऽध्यायः ॥",
  "before": "जायेतदुष्टा तु ततो बुभुक्षा या मंदबुद्धीन्विषवन्निहंति ॥",
  "after": "अथातो विविद्यौषधविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.12.2",
  "kind": "metre",
  "line": "द्विविधमौषधमूर्जस्करं रोगघ्नं च ॥",
  "before": "अथातो विविद्यौषधविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "after": "उभयमपि चोभयात्मकं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.12.5",
  "kind": "metre",
  "line": "तत्रोर्जस्करं द्विविधं रसायनं वाजीकरणं च ॥",
  "before": "बाहुल्येन तुनिर्देशः ॥",
  "after": "रोगघ्नपि द्विविधं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.12.12",
  "kind": "metre",
  "line": "तेषु वक्ष्यमाणेहेमादिलवणांतं प्रायेण भौमं ॥",
  "before": "भौममौद्भिदं जंगममिति ॥",
  "after": "औद्भिदं तु पुनर्वनस्पतिवानस्पत्यवीरुदौषधिभेदेन चतुर्विधं भवति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.12.17",
  "kind": "metre",
  "line": "जंगमोद्भवं तु मधुघृतादि जंगमं द्रव्यमाहुः ॥",
  "before": "वल्लीगुल्मं वीरुत् फलपाकांतात्वौषधिशिति ॥",
  "after": "अद्रव्यंपुनरुपवासानिलातपच्छायामंत्रसांत्वदानभयोत्रासक्षोभणहर्षणभर्त्सनस्वप्नजागरणसंवाहनादि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.12.227",
  "kind": "metre",
  "line": "॥ इति विविद्यौषधविज्ञानीयो नाम द्वादशोऽध्यायः ॥",
  "before": "अनौषधं द्रव्यमिहावबोधो रूपस्य तेषां वनगोचरेभ्यः ॥",
  "after": "अथातोऽग्यसंग्रहमध्यायं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.1",
  "kind": "metre",
  "line": "अथातोऽग्यसंग्रहमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति विविद्यौषधविज्ञानीयो नाम द्वादशोऽध्यायः ॥",
  "after": "श्रेष्ठमुदकमाश्वासनस्तंभनक्लेदनानां ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.13.32",
  "kind": "metre",
  "line": "पुष्करमूलं हिध्माश्वासकासपार्श्वशूलहराणां ॥",
  "before": "नागबलाभ्यासःक्षयक्षतघ्नां ॥",
  "after": "अजापयः शोफघ्नस्तन्यकररक्तसंग्रहणप्रशमनानां ॥",
  "note": "18 aksharas"
 }
]