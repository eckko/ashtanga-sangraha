  "note": "18 aksharas"
 },
 {
  "id": "01.07.394",
  "kind": "metre",
  "line": "कृमिगुल्मोदरप्लीहार्शःकफवातजित् ॥",
  "before": "कटुपाकरसं पीलु तीक्ष्णोष्णं भेदि पित्तलं ॥",
  "after": "सतिकं स्वादु यत्पीलु नात्युष्णं तन्त्रिदोषजित् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.08.51",
  "kind": "metre",
  "line": "स्नेहलवणयोगादपि चाग्निरित्थं स्यात् ॥",
  "before": "धूममेव वाऽपामार्गविडंगबलाद्वयचित्रकमेषशृंगीपुष्पस्र् मनःक्षारकटुका द्राक्षाघृतगुडकृतं पिबेत् ॥",
  "after": "अतो वैयोभिःपरीक्षेत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.08.82",
  "kind": "metre",
  "line": "मधुकशिरीषचंदनैश्चैनमालिंपेत् ॥",
  "before": "परिणतायांच तस्यां त्रिकटुकसिद्धेन मुद्गयूषेण किंचिल्लवणेन ससर्पिष्केण मृदुमोदनं भोजयेत् ॥",
  "after": "पक्वाशयगतं तृड्दाहमदमूर्च्छातीसाराटोपतंत्रेंद्रियविकृतिबलभ्रंशकार्श्यपांडुत्वोदराणि जनयति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.08.89",
  "kind": "metre",
  "line": "अनेन जिह्वानिर्लेखनकवलगंडूषा न्याख्याताः ॥",
  "before": "दाडिमकरमर्द्भव्यान्नाम्र्रातककोलवदरसं क्षौद्रयुतं गंडूषं ॥",
  "after": "अंजनप्रयुक्तेऽश्रुदूषिकोपदेहदाहरागवेदनादृष्टिविभ्रमाभवंत्यांध्यं च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.08.119",
  "kind": "metre",
  "line": "तत्रानंतरोक्तो विधिर्बाष्पोदितश्चेति ॥",
  "before": "सविषपुष्पाघ्राणाच्छिरोव्यथा साश्रुनेत्रत्वं गंधाज्ञानं च ॥",
  "after": "भवति चात्र ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.09.1",
  "kind": "metre",
  "line": "अथातो विरुद्धान्नविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "before": "इत्यन्नरक्षा० नामाष्टमोऽध्यायः ॥",
