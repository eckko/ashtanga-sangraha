  "note": "18 aksharas"
 },
 {
  "id": "01.06.1",
  "kind": "metre",
  "line": "अथातो द्रवद्रव्यविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "before": "इति रोगानुत्पादनीयो नाम पंचमो ऽध्यायः ॥",
  "after": "जीवनं तर्पणं णं हृद्यं ल्हादि बुद्धिप्रबोधनं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.07.1",
  "kind": "metre",
  "line": "अथातोऽन्नस्वरूपविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "before": "इति द्रवद्रव्यविज्ञानीयोनाम षष्ठोऽध्यायः ॥",
