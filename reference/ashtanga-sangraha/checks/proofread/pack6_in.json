 },
 {
  "id": "01.04.135",
  "kind": "metre",
  "line": "मासराशिखरूपारुथमृतोर्यरुलक्षणत्रयं ॥",
  "before": "निर्द्दिश्यतेऽन्यरूपेषु विरुद्धज्ञानिको विधिः ॥",
