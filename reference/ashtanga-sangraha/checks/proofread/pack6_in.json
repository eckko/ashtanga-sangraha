[
 {
  "id": "01.11.55",
  "kind": "typo?",
  "line": "विसूच्यामतिवृद्धायां पाष्र्ण्योर्दाहः प्रशस्यने ॥",
  "before": "नाम्यमानानि चांगानि भृशं स्विन्नानि वेष्टयेत् ॥",
  "after": "दिक्षारजीर्णपिण्याककुष्ठारुष्करपत्रकैः ॥",
  "note": "प्रशस्यने (1x) is close to प्रशस्यते (24x)"
 },
 {
  "id": "02.01.144",
  "kind": "typo?",
  "line": "ततः प्रजास्थापनारख्या महौषधीः शिरसा दक्षिणेन च पाणिना धारयेत ॥",
  "before": "यच्चान्यदपि ब्राह्मणा वृद्धस्त्रियो वाब्रूयुस्तच्च कुर्यात् ॥",
  "after": "एताभिश्च सिद्धं पयो घृतं वा पिबेत्॥",
  "note": "धारयेत (1x) is close to धारयेत् (24x)"
 },
 {
  "id": "02.02.114",
  "kind": "typo?",
  "line": "देवतारक्षोऽनुपचयपरिरक्षणार्थं न रक्त्तानि वासांसि धारयेन्न यानमधिरोहेन्न मद्यमांसमश्रीयात् ॥",
  "before": "तथा ॥",
  "after": "यच्चान्यदपि वृद्धस्त्रियो ब्रूयुः ॥",
  "note": "धारयेन्न (1x) is close to धारयेत् (24x)"
 },
 {
  "id": "02.03.90",
  "kind": "typo?",
  "line": "तदेववा भक्षयेत् ॥",
  "before": "गुडनागरकल्केन वा ॥",
  "after": "लाङ्गलीमुलकल्केन वा पाणिमुदरं चालिम्पेत् ॥",
  "note": "तदेववा (1x) is close to तदेव (24x)"
 },
 {
  "id": "04.23.49",
  "kind": "typo?",
  "line": "तसायां वा रथकारमुख्यां चुल्यां शिलायां वा सुरापरिषिक्तायां शाययेत्पलाशावच्छन्नं स्वेदयेद्वा पिंडेन ॥",
  "before": "बलीयसि च वाते सुखोष्णकरीषपूर्णे कूपे निषन्यादामुखं ॥",
  "after": "मूलकोरुबुकस्फूर्जार्जिकार्कसप्तलांशंखिनीस्वरससिद्धं वा तैलमभ्यंगादिषूपयोज्यं ॥",
  "note": "स्वेदयेद्वा (1x) is close to स्वेदयेत् (24x)"
 },
 {
  "id": "06.26.30",
  "kind": "typo?",
  "line": "प्रतिसारयेच्च प्रियंगुजंब्वस्थिदाडिमत्वक्त्रिफलारसांजनसैंधवशंठीमुस्तकचूर्णैर्मधुयुतैः ॥",
  "before": "शीतदंतस्योष्णां बुस्विन्नस्य व्रीहिमुखेन पालीं लिखित्वा पिचुतैलेन दहेत् ॥",
  "after": "क्षीरिवृक्षकषायैर्गंडूषः ॥",
  "note": "प्रतिसारयेच्च (1x) is close to प्रतिसारयेत् (23x)"
 },
 {
  "id": "02.01.7",
  "kind": "typo?",
  "line": "तदा हि तौ प्राप्तवीर्यौ वीर्यान्वितमपत्यं जनयतः ॥",
  "before": "तस्यां षोडशवर्षीयां पंचविंशतिवर्षः पुरुषः पुत्रार्थं प्रयतेत ॥",
  "after": "ऊनपंचविंशतिवर्षेणोनषोडशवर्षीयामाहितो गर्भःकुक्षिस्य एव विनाशमाप्नुयादल्पायुर्बलारोग्यविभवो वा स्याद्विक्लेंद्रियो वा ऋतावाद्ये च रात्रित्रये तथा दुष्टे शुक्रार्तवहति ॥",
  "note": "जनयतः (1x) is close to जनयति (20x)"
 },
 {
  "id": "06.21.50",
  "kind": "typo?",
  "line": "लेह्याख्याः पिटिकास्ता हि लिह्युः पालीमुपेक्षिताताः ॥",
  "before": "कफासृक्कृमिजाः सूक्ष्माः सकंडूक्लेदवेदनाः ॥",
  "after": "पिप्पलीसर्वजं शूलं विदारीकूचिकर्णकाः ॥",
  "note": "पिटिकास्ता (1x) is close to पिटिका (20x)"
 },
 {
  "id": "06.30.40",
  "kind": "typo?",
  "line": "वेदनायाः प्रशांत्यर्थं पाकस्याप्राप्तयेऽपि च ॥",
  "before": "सविषे च विशेषेण जलौकाद्यैर्हरेदसृक् ॥",
  "after": "निर्वापणां पुनश्चात्र न्यग्रोधाद्यैः सुशीतलान् ॥",
  "note": "वेदनायाः (1x) is close to वेदना (20x)"
 },
 {
  "id": "01.28.160",
  "kind": "typo?",
  "line": "विशेषस्तु सम्यगनुवासिते किंचित्कालं स्थित्वा स्नेहः सपुरीषोऽनिलानुगतः प्रवर्त्तत इति ॥",
  "before": "तस्य हीनसम्यगतियोगाः स्नेहपीतवत् ॥",
  "after": "भवंतिचात्र ॥",
  "note": "विशेषस्तु (2x) is close to विशेषतः (39x)"
 },
 {
  "id": "04.05.15",
  "kind": "typo?",
  "line": "रसायनविधानेन पिप्पलीर्वा प्रयोजयेत् ॥",
  "before": "चूर्णमामलकानां वा क्षीरे पक्कं घृतान्वितं ॥",
  "after": "कासी पर्वास्थिशूली च लिह्यात्सघृतमाक्षिकाः ॥",
  "note": "पिप्पलीर्वा (2x) is close to पिप्पली (27x)"
 },
 {
  "id": "01.07.232",
  "kind": "typo?",
  "line": "हंति दोषत्रयं कुष्ठंवृष्या सोष्णा रसायनी ॥",
  "before": "ग्रहण्यर्शोविकारघ्नो वर्चोभेदि तु वास्तुकं ॥",
  "after": "काकमाची सरा स्वर्या चांगैर्यम्ला ऽग्निदीपनी ॥",
  "note": "रसायनी (2x) is close to रसायनं (26x)"
 },
 {
  "id": "06.02.50",
  "kind": "typo?",
  "line": "यदा पुनर्धानुसञ्निपातप्रकोपमान्यासेवेत तदाऽस्यास्त्रयो मला युगपद्दक्षोभिप्रपन्नाः क्षीरावहा रसायनो: समनुश्रित्य संकीर्णलिंगं स्तन्यमावहं ति ॥",
  "before": "तत्पाठाव्योषकल्केन पंचकोलचूर्णेन वा क्षौद्रघृताप्लुतेन दोषोपक्रमणीयं चेक्षेत ॥",
  "after": "तच्चेदमविज्ञानात्सततमप्रत्यवेक्षणात्प्रमादाद्द्वा मातुः कुमारः पिबति ततः स तेन सलिलोपममच्छं विच्छिन्नमामं दुर्गंधि नानावर्णवेदनं फेनिलमतिसार्य्यते पीतश्वेतमूत्रताविष्टंभतृष्णाज्वरच्छर्द्दिद्विजृंभिकाशुष्कोद्गारारुचिभ्रमांगभंगविक्षेपकूजनघ्राणाक्षिमुखपाककृच्छ्रयुपप्लवस्वरसादादयश्चास्य प्रादुर्भवंति ॥",
  "note": "रसायनो (2x) is close to रसायनं (26x)"
 },
 {
  "id": "05.06.26",
  "kind": "typo?",
  "line": "बस्तिमस्य विदध्याच्च समूत्रं दाशमूलिकं ॥",
  "before": "पिष्ट्वा कुष्ठं च मूत्रेण पिबेत्क्षारांश्च दीपनान् ॥",
  "after": "युक्तोल्पवीर्यो दोषाढ्ये रूक्षे क्रूराशये ऽथवा ॥",
  "note": "विदध्याच्च (2x) is close to विदध्यात् (25x)"
 },
 {
  "id": "04.18.35",
  "kind": "typo?",
  "line": "अर्द्धतुलां दशमूलस्य त्रिफलायाः पृथगद्विप्रस्थं कुटजत्वचश्चकुडवांश्यान् मुस्तारुष्करकृमिघ्नेद्रयवान् पालिकान् पाठादंतीमधुरसारांन्नाशंठीचित्रकान् मृद्वीकाप्रस्थं च षोडशगुणपादशेषमंभसि विपाच्य रसमादद्दीत ॥",
  "before": "गंडीरतरोः समूलपुष्पशाखस्य तुलामाहरेत् ॥",
  "after": "तं पूतशीतं सितोपलातुलाद्वयेन चूर्णप्रस्थेन च युक्तं मागधिकाद्र्धप्रस्थेन श्लक्ष्णपिष्टेन ग्रंथिकपलेनाद्र्धपलिकैश्च मरिचविडंगैलवालुकैः प्रलिप्ते घृतकुंभे निधापयेत् ॥",
  "note": "त्रिफलायाः (2x) is close to त्रिफला (24x)"
 },
 {
  "id": "02.11.76",
  "kind": "typo?",
  "line": "मलान्बस्तिशिरोनाभि विबद्ध्य जनयन् रुजं ॥",
  "before": "गृहीत्वा पायुहृदये क्षीणदेहस्य वा बली ॥",
  "after": "कुर्वन् वंक्षणयोः शूलं तृष्णांभिन्नपुरीषतां ॥",
  "note": "जनयन् (2x) is close to जनयति (20x)"
 },
 {
  "id": "06.14.91",
  "kind": "typo?",
  "line": "मसूरा निस्तुषाः स्तन्यपिष्टास्तरुणदर्भांकुरा घृतमाजं गोक्षीरं शरश्चायसे ताम्रेण घृष्टा अभ्यंजनं वेदनाघ्नं ॥",
  "before": "मधुकसारश्च मधुना बिभीतकास्थिमज्जा वा ॥",
  "after": "यवगोधूमजीवनीयामांसीचूर्णेन सघृतशर्क रोत्कारिका स्वेदोपनाहे प्रणीता वेदनामपनयति शुक्रं चोत्सादयति ॥",
  "note": "वेदनाघ्नं (2x) is close to वेदना (20x)"
 },
 {
  "id": "06.26.184",
  "kind": "typo?",
  "line": "स्थिरासु तु पिटिकासु प्राक् शाकादिपत्रेण लेखनं ॥",
  "before": "कफजे कटुकक्षारलवणैः प्रतिसारणं ॥",
  "after": "मुष्कक पलाशामलकक्षारगोमूत्रैर्गंडूषः ॥",
  "note": "पिटिकासु (2x) is close to पिटिका (20x)"
 },
 {
  "id": "01.01.14",
  "kind": "metre",
  "line": "इति ह स्माहुरात्रे यादयो महर्षयः ॥",
  "before": "अथात आयुष्यकामीयमध्यायं व्याख्यास्यामः ॥",
  "after": "आयुःकामयमानेन धर्मार्थसुखसाधनं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.01.107",
  "kind": "metre",
  "line": "द्रवान्नज्ञान संरक्षाधिरुद्धाज्ञानभोजपानिकाः ॥",
