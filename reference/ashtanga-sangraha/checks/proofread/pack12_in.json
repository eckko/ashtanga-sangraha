[
 {
  "id": "04.13.11",
  "kind": "metre",
  "line": "समाक्षिकं वा दार्बीमामलकरसेन ॥",
  "before": "मधुकदार्बीकरुबीजानि वा तंडुलघावनेन ॥",
  "after": "मृद्वीकाकल्कं वा पर्युषितांभसा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.13.47",
  "kind": "metre",
  "line": "घनीभवति च तस्मिन् व्यूषणोषकादिचूर्णं दद्यात् ॥",
  "before": "अश्मरीभेदजानां घृताक्तानामंतर्धूमदग्धानां क्षारं च ग्राम्यपशुशकृत्क्षारं च गोमूत्रेण बहुकृत्वो गालयित्वा तमच्छमग्नौ साधयेत् ॥",
  "after": "दर्वीप्रलेपि चावतारयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.13.65",
  "kind": "metre",
  "line": "बिभीतकबीजं सुरया विहंगपिशितोपदंशं ॥",
  "before": "वारुणीक्षीरोष्णोदकान्यतमेन त्रिफला कल्कं वा ससैंधवं सुखांभसा केवलमेव वा ॥",
  "after": "निर्गदमदिशमं डमार्कमासवान्वा विविधान् पिबेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.13.85",
  "kind": "metre",
  "line": "तच्चूर्णमल्पमप्यवस्थितं पुनःपरिवृद्धिमेति ॥",
  "before": "यथा न भिद्यते चूर्ण्यते वा तथा प्रयत्नेन ॥",
  "after": "तस्मात्समग्रमग्रवक्त्रेणा ददीत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.13.93",
  "kind": "metre",
  "line": "न तु द्विधाभिन्नबस्तिरश्मरीमानपि ॥",
  "before": "क्रियाभ्यासाच्छास्त्राभिहितच्छेदान्निष्पंदपरिवृत्तत्वाच्च शल्यस्येति ॥",
  "after": "उद्धृतशल्यं तूष्णोदकद्रोण्यामवगाह्य स्वेदयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.13.94",
  "kind": "metre",
  "line": "उद्धृतशल्यं तूष्णोदकद्रोण्यामवगाह्य स्वेदयेत् ॥",
  "before": "न तु द्विधाभिन्नबस्तिरश्मरीमानपि ॥",
  "after": "तथा बस्तिरसृजा न पूर्यते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.13.96",
  "kind": "metre",
  "line": "पूर्णे तु क्षीरिवृक्षकषायं पुष्पनेत्रेण विदध्यात् ॥",
  "before": "तथा बस्तिरसृजा न पूर्यते ॥",
  "after": "स हि तथा बस्तिगतमश्मरीचूर्णं रक्तं च निर्हरति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.13.98",
  "kind": "metre",
  "line": "मूत्रशुद्ध्यर्थं च गुडसौहित्यं कारयेत् ॥",
  "before": "स हि तथा बस्तिगतमश्मरीचूर्णं रक्तं च निर्हरति ॥",
  "after": "उत्थाप्य चैनं मघुघृताभ्यक्तव्रणं मूत्रविशोधनद्रव्यसिद्धां यवागूं सघृतां पाययेदुभयकालं त्रिरात्रं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.13.119",
  "kind": "metre",
  "line": "इति मूत्राघातचिकित्सितं नाम त्रयोदशोऽध्यायः ॥",
  "before": "शस्त्रपाणिर्ध्रुवं हंति साहसात्केवलो यथा ॥",
  "after": "अथातः प्रमेहचिकित्सितं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.14.1",
  "kind": "metre",
  "line": "अथातः प्रमेहचिकित्सितं व्याख्यास्यामः ॥",
  "before": "इति मूत्राघातचिकित्सितं नाम त्रयोदशोऽध्यायः ॥",
  "after": "प्रायेण हि प्रमेहिणोऽभिष्यन्जदेहत्वादुपहताग्नेर्भक्ष्यादिपंचविधमप्यन्नमुपयुक्तं मूत्राय मेदसे च विपरिणमते ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.14.17",
  "kind": "metre",
  "line": "तद्वद्गुडूच्याः स्वरसमामलकानां वा ॥",
  "before": "असनचित्रकत्रिफलादार्वीकलिंगकानां वा सक्षौद्रं ॥",
  "after": "विशेषतस्तु कफप्रमेहेषु कट्फलमुस्तारोध्राभयानां समाक्षिकं कषायं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.14.21",
  "kind": "metre",
  "line": "पाठामिग्नमंथचविकात्रिफलानां वा ॥",
  "before": "चंदनागुरुकुष्ठदेवदारूणां वा ॥",
  "after": "पित्तप्रमेहेषु रोध्रसेव्यार्जुनचंदनानां निंबामृतामलकपटोलानां वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.14.36",
  "kind": "metre",
  "line": "पित्तानुगतेषु च घृतानि यमकं वा प्रयुंजीत ॥",
  "before": "कफानुगतेषु तु वसादिमेहेषु यथास्वंकषायेण साधितानि तैलानि ॥",
  "after": "एतेन शेषेष्वपि मेहेषु स्नेहविकल्पउक्तो वेदितव्यः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.14.60",
  "kind": "metre",
  "line": "पिबेद्वा सुखोदकेन त्रिफलांभसा वा ॥",
  "before": "मुस्तामृतागांडीरद्विहरिद्रासारिवा द्विदंर्भवर्षाभूद्वित्रिकंटकन्यो षफल्गुरोहिषपल्लवश्यामासुरदारुकालाविडंगपाठाकंपिल्लकभार्गीनि दिग्धिकादंतीचित्रककटुकैरंडमूलानि समान्येकध्यं चूर्णयित्वाऽयश्चूर्णं द्विगुणं श्लक्ष्णमावाप्यमध्यानुपानं मधुनाऽवलिह्यात् ॥",
  "after": "तेन मेहप्लीहहलीमकपांडुरोगश्वयथुदुर्नामगुल्मोदराणि शीघ्रमुपशाम्यंति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.14.66",
  "kind": "metre",
  "line": "गोभिर्वा तन्मूत्रशकृद्वृत्तिः परिभ्रमेत् ॥",
  "before": "श्यामाकनीवारमतिंदुककपित्थाश्मंतकफलमूलाहारो वा मृगैः सह वसेत् ॥",
  "after": "तडागानि वा खनेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.15.8",
  "kind": "metre",
  "line": "मधुशिग्रुं च पानभोजनलेपनेषु ॥",
  "before": "आस्थापनमनुवासनं च ॥",
  "after": "शिलाह्वयं वा कल्पविधिनोपयुंजीत गुग्गुलुं वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.15.9",
  "kind": "metre",
  "line": "शिलाह्वयं वा कल्पविधिनोपयुंजीत गुग्गुलुं वा ॥",
  "before": "मधुशिग्रुं च पानभोजनलेपनेषु ॥",
  "after": "यथादोषं च सर्वशो गुल्मवदुपक्रमेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.15.15",
  "kind": "metre",
  "line": "तच्छीतं मधुशर्करापादयुक्तं समानं पूर्वैग ॥",
  "before": "द्राक्षामधुकखर्जूराभीरुविदारीपरूषकत्रिफलाक्वाथे क्षीरेक्षुधात्रीस्वरससमेतमभ्यागर्भ सर्पिर्विपाचयेत् ॥",
  "after": "भृशं च शृंगादिभिः शोणितमवसेचयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.15.30",
  "kind": "metre",
  "line": "पच्यमानं यथेष्टभोजनेन पाचयेत् ॥",
  "before": "स्तनविद्रधिमपि व्रणविशोधनेनोपचरेत् ॥",
  "after": "न पुनरुपनाहयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.15.52",
  "kind": "metre",
  "line": "मूत्रवृद्धिं स्निग्धैः स्वेदयित्वा बस्त्रपट्टेन वेष्टयेत् ॥",
  "before": "आभ्रणसंधानाच्च स्नेहस्वेदौ ॥",
  "after": "ततोऽधस्तात्सेवन्या दकोदरवद्धीहिमुखेन विद्ध्वा नाड्या स्रावयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.15.63",
  "kind": "metre",
  "line": "एतद्गंधर्वहस्ततैलं तुल्यं पूर्वेण ॥",
  "before": "कल्कपिष्टं चात्र दद्यात्पुनर्गंधर्वहस्तमूलकुडवं शुंठीपलं च ॥",
  "after": "भवति चात्र ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.16.15",
  "kind": "metre",
  "line": "दाधिकाख्यमेतल्सर्पिः समानं पूर्वेण ॥",
  "before": "तेन पृथक् समातुलुंगदाडिमाम्रानकरसशुक्ततुषोदकारनालं घृतप्रस्थं दध्याढकोपेतं वचाकारवीशताव्हाद्विक्षारत्रिलवणत्रिकटुकरास्नाकुंभनिकुंभयवानी यवानक हिंस्राऽम्लवेतसनीलिनी फलविडंगदा डिमहिंगुपाषाणभेदकोषकवृषकहपुषा भार्गीश्वदंष्ट्रात्रपुसैवारुबीजाजाजीसासिवोपकुंचिकाग्रंथिककुस्तुंबरीतुंबरुफलमूर्वाचित्रकसुरसागजपिप्पली गर्भ साधयेत् ॥",
  "after": "मूत्रघातोन्मादापस्मारखातव्याधिहरं च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.16.46",
  "kind": "metre",
  "line": "विरिक्तस्यापि संतापानुवृत्तौ रक्तमवसेचयेत् ॥",
  "before": "अत्युद्रिक्तपित्तस्त्रिफलां त्रायमाणां वा क्षीरेण ॥",
  "after": "विड्बंधे चोदावर्त्तक्रमं कुर्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.16.66",
  "kind": "metre",
  "line": "कल्पोदितानि वा विरेचनानि युंजीत ॥",
  "before": "द्राक्षाऽभयारसं वा सगुडं पिबेत् ॥",
  "after": "रूक्षोष्णसमुद्भूते पुनः संशमार्थं तिक्तकं वासाघृतं वा पिबेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.16.75",
  "kind": "metre",
  "line": "एवमसिद्धौ विदाहपूर्वरूपेषु चामृक् स्रावयेत् ॥",
  "before": "मणिकनकरजतताम्रभाजनानि च शिशिरवारिपूर्णानि गुल्मदेशस्योपरि धारयेन्मुक्तावलीश्च सुशीताः ॥",
  "after": "श्रुतरक्ते च जांगलरसैर्लब्धबलमर्तिशोषनाशाय पुनः सर्पिरभ्यास्येत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.16.80",
  "kind": "metre",
  "line": "लंघितस्योष्णकटुतिक्तदीपनं संसर्गामाचरेत् ॥",
  "before": "श्लेष्मगुल्मिनं प्रागेव विधिवद्वामयेदवम्यमुपवासयेत् ॥",
  "after": "तथा स्वेदनानि वातगुल्मोक्तादीनि च घृतानि द्विगुणहिंगुक्षाराम्लवेतसानि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.17.1",
  "kind": "metre",
  "line": "अथात उदरचिकित्सितं व्याख्यास्यामः ॥",
  "before": "इति गुल्मचिकित्सितं नाम षोडशोऽध्यायः ॥",
  "after": "सर्वमेवोदरमतिमात्रदोषसंचयानुबंधेन स्त्रोतोमुखनिरोधाद्व्याकुलानिलतया यत्प्रजायते तस्मादभीक्ष्णमुदरी विरेचनान्युपयुंजीत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.17.8",
  "kind": "metre",
  "line": "तद्भावितेन वा कृष्णाऽभयाचूर्ण कासरगुग्गुलुं ॥",
  "before": "पिप्पलीसहस्रं वा स्नुहीक्षीरभावितं सेवेत ॥",
  "after": "सैंधवाजमोदयुक्तं वा निंबतैलं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.17.21",
  "kind": "metre",
  "line": "जीर्णे च पेयाऽनुपो रसोदनाशी वा स्यात् ॥",
  "before": "पटोलमूलरजनीविडंगत्रिफलाः कर्षांशाः कंपिल्लकनीलिनीफलत्रिवृतानां क्रमाद्वित्रिचतुर्भिः कर्षैर्युक्ताश्चूर्णयित्वा मूत्रेण पिबेत् ॥",
  "after": "ततः षडरात्रं सव्योषणं पयसाऽश्नीयात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.17.37",
  "kind": "metre",
  "line": "आनाहोदावर्त्तयोर्यथास्वं प्रतिकुर्यात् ॥",
  "before": "सलिलं च वर्जयेत् ॥",
  "after": "वातकृतेषु तु पार्श्वशूलोपस्तंभहृद्ग्रहेषु बिल्वक्षारांभसा तैलं पाययेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.17.57",
  "kind": "metre",
  "line": "दुर्बलं तु प्रागेवानुवास्य क्षीरबस्तिभिः शोधयेत् ॥",
  "before": "पित्तोदरिणं मधुरकविपक्केन सर्पिषोपस्नेह्य श्यामात्रिवृत्त्रिफलाविपक्केनानुलोम्य मधुघृतसिताढ्येन न्यग्रोधादिनिर्यूहेणास्थापयेदनुवासयेच्च ॥",
  "after": "संजातबलाग्निं च स्निग्धं पुनः क्षीरेण सत्रिवृत्कल्केनोरुबूकशृतेन वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.17.59",
  "kind": "metre",
  "line": "सातलात्रायमाणाभ्यां वाऽऽरग्वधेन वा ॥",
  "before": "संजातबलाग्निं च स्निग्धं पुनः क्षीरेण सत्रिवृत्कल्केनोरुबूकशृतेन वा ॥",
  "after": "सश्लेष्मणि पित्ते समूत्रेण ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.17.63",
  "kind": "metre",
  "line": "एभिरेवच क्षीरैर्विदार्यादिशृतेन वा भोजयेत् ॥",
  "before": "बस्ति कर्म चाचरेत् ॥",
  "after": "पायसेन चोपनाहयेदुदरं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.17.68",
  "kind": "metre",
  "line": "स्त्यानकफोदरं क्षारमरिष्टांश्च तीक्ष्णान्वां पाययेत् ॥",
  "before": "कुलत्थयूषेण व्योषवता क्षीरेण वा भोजयेत् ॥",
  "after": "सततं च स्वेदयेत्किण्वसर्षपमूलकबीजकल्कैर्जठरमुपनाहयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.17.72",
  "kind": "metre",
  "line": "सर्वस्य सर्वात्मकत्वात्कृच्छ्रतमत्वाच्च ॥",
  "before": "सर्वमेवेत्येके ॥",
  "after": "दोषोद्रेकतस्तु प्रतिकुर्वीत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.17.92",
  "kind": "metre",
  "line": "तैलसंमृष्टं शोभांजनकनिर्यूहं वा ॥",
  "before": "पारिजातककेशवाकपामार्गक्षारं वा ॥",
  "after": "पिप्पलीचित्रकसैंधवयुक्तमम्लश्रुतं वा बिडमागधिकापूतिकरंजक्षारं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.17.106",
  "kind": "metre",
  "line": "संसनानि चान्नान्युदावर्त्तहराणि च ॥",
  "before": "बद्धोदरे स्विन्नाय सतैललवणमूत्रतीक्ष्णं निरूहमनुवासनं च दद्यात् ॥",
  "after": "तीक्ष्णं च विरेचनं यच्च किंचिद्वातघ्नं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.17.107",
  "kind": "metre",
  "line": "तीक्ष्णं च विरेचनं यच्च किंचिद्वातघ्नं ॥",
  "before": "संसनानि चान्नान्युदावर्त्तहराणि च ॥",
  "after": "छिद्रोदरे स्नेहवर्जं कफोदरवदाचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.18.29",
  "kind": "metre",
  "line": "घनन्हीवेरशुंठीसाधितं पित्तोत्तरे ॥",
  "before": "भोजनं तु सात्म्यतः शालियवगोधूममुद्गजांगलमांसानि पयो घृतं इषपटोलवेत्रपर्पटकशाकं द्राक्षादाडिमुखर्जूरआमलकानि पानमनु पंचमूलसिद्धं वारि वाताधिके ॥",
  "after": "श्लेष्मण्यरिष्टसीधुमार्द्धिकासवाः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.18.34",
  "kind": "metre",
  "line": "गंडीरतरोः समूलपुष्पशाखस्य तुलामाहरेत् ॥",
  "before": "अयं बीजकसारारिष्टः पांडुकामलामेहहृद्रोगवातशोणितविषमज्वरारोचककासश्वासान्निहर्हति ॥",
  "after": "अर्द्धतुलां दशमूलस्य त्रिफलायाः पृथगद्विप्रस्थं कुटजत्वचश्चकुडवांश्यान् मुस्तारुष्करकृमिघ्नेद्रयवान् पालिकान् पाठादंतीमधुरसारांन्नाशंठीचित्रकान् मृद्वीकाप्रस्थं च षोडशगुणपादशेषमंभसि विपाच्य रसमादद्दीत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.18.40",
  "kind": "metre",
  "line": "ततो यवपल्लस्थं पक्षमुपेक्ष्य यथाबलं पिबेत् ॥",
  "before": "अथवा चव्यकुष्ठप्रलिप्ते भाजने मस्तुद्रोणं गुडतुलां पिप्पलीप्रस्थं त्रिफलाप्रस्थत्रयं विडंगप्रस्थत्रयं कुडवांशांश्च मरिचपरूषकद्राक्षाकाश्मर्यफलेंद्रयवान् द्विपलिकानि च दंतीचित्रकभल्लातकानि चूर्णितानि प्रक्षिपेत् ॥",
  "after": "एष मस्त्वरिष्टः पांडुरोगमेहमेदोऽर्शोग्रहणीप्लीहशोफोदरभंगदरहरः परमं चाम्निदीपनइति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.18.103",
  "kind": "metre",
  "line": "पांडुरोगेषु कुशलः शोफोक्तं च क्रियाक्रममिति ॥",
  "before": "पयसा च प्रयुंजीत यथादोषं यथाबलं ॥",
  "after": "इति पांडुरोगचिकित्सितं नामाष्टादशोऽध्यायः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.19.1",
  "kind": "metre",
  "line": "अथातः श्वयथुचिकित्सितं व्याख्यास्यामः ॥",
  "before": "इति पांडुरोगचिकित्सितं नामाष्टादशोऽध्यायः ॥",
  "after": "श्वयथुषु दोषजेषु सर्वेषु सर्वसरेष्वामानुबद्धेषु लंघनपाचनशोधनान्यादौ योजयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.19.18",
  "kind": "metre",
  "line": "आर्द्रकरसं वा शालिक्षीराहारः पिबेत् ॥",
  "before": "मासमयं प्रयोगः शोफशोषार्शःश्वासकासप्रसेकपीनसालसकाम्निसादगुल्मोदरप्रमेहपांडुकामलामनोविकारानपहरति ॥",
  "after": "निवृत्तामदोषः शृतानि पयांसि सर्पीषि च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.19.20",
  "kind": "metre",
  "line": "त्रिकटुकैरंडश्यामामूलैः सिद्धं क्षीरं ॥",
  "before": "निवृत्तामदोषः शृतानि पयांसि सर्पीषि च ॥",
  "after": "महौषधमुरंगीभ्यां वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.19.25",
  "kind": "metre",
  "line": "गोमूत्रं महिषीमूत्रं वा सक्षीरं क्षीराशनः पिबेत् ॥",
  "before": "करभीक्षीरवृत्तिर्वा स्यात् ॥",
  "after": "दाडिमयवानीयानकधनिकापाठाऽम्लवेतसमरिचपंचकोल बिल्वफल्यावशूकानक्षमात्रान्सलिलाढके विपाच्य तत्कषायेण घृतप्रस्थं साधयेच्छोफार्शोगुल्ममेहाग्निसादहरं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.19.43",
  "kind": "metre",
  "line": "वातहराभ्यंगस्वेदोपनाहांश्च कुर्यात् ॥",
  "before": "एरंडतैलमेव च विद्वातसंगे प्राग्भक्तं पयसा रसैर्वा ॥",
  "after": "विशेषेण चैकांगे मातुलुंगाम्लमथुशुंठीदेवदार्वहिंस्राप्रलेपः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.19.55",
  "kind": "metre",
  "line": "अयमष्टशतारिष्टः समानः पूर्वेण ॥",
  "before": "त्रिफलामरिचद्राक्षापिप्पलीकाश्मर्यफलानां प्रत्येकं शतं गुडतुलामुदकद्रोणं मधूपलिसभाजनस्थं सप्ताहमुष्णे काले द्विसप्ताहं शीते धारयेत् ॥",
  "after": "पुराणपिण्याककृष्णाशिग्रुत्वगतसीसिकतामूत्रपिष्टाः सुखोष्णाः प्रलेपे दद्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.20.1",
  "kind": "metre",
  "line": "अथातो विसर्पचिकित्सितं व्याख्यास्यामः ॥",
  "before": "इति श्वयथुचिकित्सितं नामैकोनविंशोऽध्यायः ॥",
  "after": "॥ पूर्वरूपेष्वेव सर्वविसर्प।णां लंघनं रूक्षणं सिरामोक्षमुल्लेखनं च कुर्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.20.8",
  "kind": "metre",
  "line": "अनिले ह्रस्वपंचवल्लीकंटकपंचमूलानि च ॥",
  "before": "मुस्तदेवदारुकुष्ठशताह्वावाराहीधान्यकृष्णगंधाऽश्वगंधावंशार्तगलान् लेपसेकेषु ॥",
  "after": "पित्ते तुकमलोत्पलशैवालकंदूर्वामृणालकशृंगाटकेसेरुकशर्करा न्हीबेरचंदनमु स्तामगिरिकपयस्याप्रपौंडरीकमधुकपद्मकघृतक्षीराणि न्यग्रोधादि च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.20.29",
  "kind": "metre",
  "line": "जत्रूर्ध्वगते तीक्ष्णधूमवमनानि च ॥",
  "before": "गिरिजजतुवा गुल्मभेदनं वा तसलोहोपलादिपीडनं ॥",
  "after": "तथाप्यभेदे क्षारेणाग्निना वा दहेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.20.32",
  "kind": "metre",
  "line": "विदग्धं वा रक्तं नीयापनीय पुनः पुनः स्वेदयेत् ॥",
  "before": "पाटयित्वा वा शस्त्रेण परिशोधयेत् ॥",
  "after": "एवं पर्यायेण रक्तपित्ते वातश्लेष्मणि चोतिष्ठेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.20.33",
  "kind": "metre",
  "line": "एवं पर्यायेण रक्तपित्ते वातश्लेष्मणि चोतिष्ठेत् ॥",
  "before": "विदग्धं वा रक्तं नीयापनीय पुनः पुनः स्वेदयेत् ॥",
  "after": "सर्वस्मिन् विसर्पेपर्यागते विदारिते च व्रणवतैलं च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.20.37",
  "kind": "metre",
  "line": "असृक्क्क्लेदाद्धि त्वङ्मांससिरास्नावसंक्लेदो भवन्ति ॥",
  "before": "कर्दमके शीघ्रतरं सुतरां च वमनादीनि कृत्वा पुनर्जलोको भिरसृगवसेचयेत् ॥",
  "after": "पिबेच्च कषायं घनपटोलपिचुमंदानां मुस्तोशीरमलकसारिवाणां चंदनोरपलयोः पटोलादिवर्गस्य वा घृतमिश्रं वा दार्बीत्वकृत्तिक्तापटोलयष्ट्याहारिष्टमसूरत्रिफलात्रायमाणानां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.2",
  "kind": "metre",
  "line": "पूर्वरूपेष्वेव कुष्ठिनं स्नेहपानेनोपक्रमेत ॥",
  "before": "अथातः कुष्ठचिकित्सितं व्याख्यास्यामः ॥",
  "after": "तत्र वातोत्तरे मेषशृंगीशाङ्गेष्टैरण्डगुडूचीद्विपंचमूलसिद्धं तैलं घृतं वा पानाभ्यंगयोर्विदध्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.13",
  "kind": "metre",
  "line": "भल्लातकपथ्याक्रमिघ्नसिद्धं वा हविः ॥",
  "before": "सर्वेषु च भल्लातक्तुवरकसिद्धार्थकान्यतमतैलं ॥",
  "after": "ततः स्निग्धस्य यथादोषं यथाबलं च संशोधनादि प्रयुंजीत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.21.16",
  "kind": "metre",
  "line": "अंतरांऽतरा च पुनः पुनः स्नेहं पिबेत् ॥",
  "before": "सिरां च बलापेक्षी विध्येदेकां द्वे तिस्रः चतस्रः पंच वा ॥",
  "after": "दुर्बलं च शून्यकोष्ठं कुष्ठिनं वायुरभिभवति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.21.17",
  "kind": "metre",
  "line": "दुर्बलं च शून्यकोष्ठं कुष्ठिनं वायुरभिभवति ॥",
  "before": "अंतरांऽतरा च पुनः पुनः स्नेहं पिबेत् ॥",
  "after": "वमने त्वस्य मधुककुठजबीजर्निबपटोलपत्राणि विदध्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.32",
  "kind": "metre",
  "line": "शिरोविरेकः सूत्रस्थानोक्तैः वैरेचनिकधूमश्च ॥",
  "before": "दंन्तीमरीचफणिज्जकार्द्रककरंजबीजपिप्पलीविडंङ्गसैंधवैरूर्ध्वजत्रुगते कुष्ठे क्रमिषु च ॥",
  "after": "ततः सर्वतो विशुद्धस्यांतर्बहिः शमनानि प्रयुंजीत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.62",
  "kind": "metre",
  "line": "प्रशांतं च लोहपात्रे स्वनुगुप्तं दद्यात् ॥",
  "before": "ततश्चतुर्भागावशिष्टेऽवतीर्णे भूयोऽग्नितप्तमयःपिंडं तस्मिन्प्रक्षिपेत् ॥",
  "after": "इयमयस्कृतिर्दुः साधनमपि कुष्ठं मेहं वा साधयति स्थूलं कर्शयति पांडुशोफमपहंति सन्नमग्निमुद्धरति ॥",
  "note": "14 aksharas"
 }
]