[
 {
  "id": "04.21.99",
  "kind": "metre",
  "line": "दार्बीरसामंजनं वा गोमूत्रेण प्रबाधते कुष्ठं ॥",
  "before": "रोहितकं सुराहं च खदिरोदकपायिनः ॥",
  "after": "अभया प्रयोजिता वा मासं सव्योषगुडतैला ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.107",
  "kind": "metre",
  "line": "संचूर्ण्य वस्त्रपूतं रसे प्लुतं खादिरेऽनले शुष्कं ॥",
  "before": "प्रत्याहरेत्समस्तं कृतमाळतरोश्च तत्तद्वत् ॥",
  "after": "चित्रकघनभल्लातकगोक्षुरकमहौषधत्रिफलाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.171",
  "kind": "metre",
  "line": "स्तब्धानि सुप्तसुप्तान्यस्वेदनकंडूलानि कुष्ठानि ॥",
  "before": "पीतागदस्य कार्यो विषैः समंत्रागदैश्चानु ॥",
  "after": "कूर्चैर्द्दतीत्रिवृताकरवीरकरंजकुटजानां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.172",
  "kind": "metre",
  "line": "कूर्चैर्द्दतीत्रिवृताकरवीरकरंजकुटजानां ॥",
  "before": "स्तब्धानि सुप्तसुप्तान्यस्वेदनकंडूलानि कुष्ठानि ॥",
  "after": "जात्यर्कनिंबजैर्वा पत्रैः शस्त्रैः समुद्रफेनेनेन ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.173",
  "kind": "metre",
  "line": "जात्यर्कनिंबजैर्वा पत्रैः शस्त्रैः समुद्रफेनेनेन ॥",
  "before": "कूर्चैर्द्दतीत्रिवृताकरवीरकरंजकुटजानां ॥",
  "after": "घृष्टानि गोमयैर्वा ततः प्रदेहैः प्रदिश्यामि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.207",
  "kind": "metre",
  "line": "वायसजंघामूलं वमनीपत्राणि मूलकाद्बीजं ॥",
  "before": "तेनांभसा कंगुलिनोत्थतैलं सिद्धं परं सिध्मनिबर्हणाय ॥",
  "after": "तक्रेण भौमवारे लेपः सिध्मापहः सिद्धः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.211",
  "kind": "metre",
  "line": "देयः समधूच्छिष्टो विपादिका तेन शाम्यतेऽभ्यक्ता ॥",
  "before": "एष घृततैलपाकः सिद्धः सिद्धे च सर्जरसः ॥",
  "after": "चर्मैककुष्ठकिटिभं कुष्ठं शाम्यत्यलसकं च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.224",
  "kind": "metre",
  "line": "जातिप्रबालसर्षपळशुनविडंगं करंजत्वक् ॥",
  "before": "कनकक्षीरीशैलाभाङ्ग्रेदंत्याः फलानि मूलंच ॥",
  "after": "समच्छदाईपल्लवमूलत्वक्निंबचित्रकास्फोताः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.225",
  "kind": "metre",
  "line": "समच्छदाईपल्लवमूलत्वक्निंबचित्रकास्फोताः ॥",
  "before": "जातिप्रबालसर्षपळशुनविडंगं करंजत्वक् ॥",
  "after": "गुंजैरण्डकबृहतीमूलकमुसरार्जुनकफलानि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.229",
  "kind": "metre",
  "line": "हरिताळमवाक्पुष्पी तुत्थं कंपिल्लकोऽमृतासंगः ॥",
  "before": "एडगजकुटजशिग्रुव्यूषणभल्लातकक्षवकाः ॥",
  "after": "सौराष्ट्रीकासीसं दार्बीत्वक्स्वर्जिकालवणं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.233",
  "kind": "metre",
  "line": "कटुकालाबुन्यस्तं नित्याभ्यंगेन वातकफकुष्ठं ॥",
  "before": "करवीरमूलपल्लवतोयेन विपाचीतं जयति ॥",
  "after": "दद्रूमंडलकोठरुक्रमिपामविचर्चिकाः सुतरां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.236",
  "kind": "metre",
  "line": "पामाकिटिभविचर्चिषु साधितमभ्यंजने श्रेष्ठं ॥",
  "before": "सिक्थकतुत्थकगुग्गुलुसिंदुरसांजनैः कटुकतैलं ॥",
  "after": "शैलेयकंपिल्लकपर्दिकारव्यसुराष्ट्रजासर्जरसोपलानि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.240",
  "kind": "metre",
  "line": "क्रमिपामसिद्धमदद्रूमंडलकुष्ठं शमं याति ॥",
  "before": "एडगजकुष्ठसैंधवसिद्धार्थविडंगकांजिकैर्लिप्तं ॥",
  "after": "लाक्षाव्योषं प्रापुन्नाटं च बीजं सश्रीवेष्टाः कुष्ठसिद्धार्थकश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.251",
  "kind": "metre",
  "line": "क्षारेण गवां मूत्रश्रुतेन तेनास्य मंडलान्याशु ॥",
  "before": "चूर्णीकृतमप्ताहं भावयितव्यं पलाशस्य ॥",
  "after": "भिद्यंते बिलं यंति च लिप्तान्पर्कमितानि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.256",
  "kind": "metre",
  "line": "दार्बी सप्तपर्णा स्न्नानं सिद्धार्थकं नाम ॥",
  "before": "मुस्तं त्रिफला मदनं करंज आरग्वधः कलिंगयवाः ॥",
  "after": "एष कषायो वमनं विरेचनं वर्णकस्तथो हर्षः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.21.260",
  "kind": "metre",
  "line": "मूत्रे दार्बीलेपः क्वाथो लेपेन कुष्ठघ्नः ॥",
  "before": "करवीरनिंबकुटजाच्छम्याकाच्चित्रकाच्च मूलानां ॥",
  "after": "श्वेतकरवीरमूलं कुटजकरंजात्पलं त्वचो दार्भ्याः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.21.272",
  "kind": "metre",
  "line": "कुष्ठेषु हितान्याहुस्तैलं श्रेष्ठं च खदिरसारस्य ॥",
  "before": "सर्षपकरंजकोशातकानि तैलान्यथेंगुदीनां च ॥",
  "after": "शीताः प्रदेहसेकास्तिक्तं सर्पिः सिराविरेकश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.277",
  "kind": "metre",
  "line": "एडगजः सविडंगो मूलान्यारग्वधस्य कुष्ठानां ॥",
  "before": "सद्योदुग्धं दुग्धं षण्मासात्कारभं जयेत्समधु ॥",
  "after": "उद्दालनश्च दंता गोश्व वराहोष्ट्रदंताश्व ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.21.281",
  "kind": "metre",
  "line": "शिवत्राणां सविशेषं योक्तव्यं सर्वतो विशुद्धानां ॥",
  "before": "कुष्ठोत्सादनमग्र्यं सपिप्पलीपाकलं योज्यं ॥",
  "after": "उत्सन्नेषु च लेपाः सवर्णकरणस्तथाऽभ्यंगाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.2",
  "kind": "metre",
  "line": "कुष्ठादपि बीभत्सं यच्छीघ्रतरं च यात्यसाध्यत्वं ॥",
  "before": "अथातः श्वित्रकृमिचिकित्सितं व्याख्यास्यामः ॥",
  "after": "श्वित्रमतस्तच्छ शांत्यै यतेत दीप्ते यथा भवने ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.3",
  "kind": "metre",
  "line": "श्वित्रमतस्तच्छ शांत्यै यतेत दीप्ते यथा भवने ॥",
  "before": "कुष्ठादपि बीभत्सं यच्छीघ्रतरं च यात्यसाध्यत्वं ॥",
  "after": "मद्यंत्या सप्रायस्या सुरभ्या प्रग्रहस्य च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.14",
  "kind": "metre",
  "line": "सविसर्पशोषपवनव्याधीन्विषमज्वरान् हन्यात् ॥",
  "before": "गलगंडगुल्मगंडार्बुदशोफप्रमेहगलरोगान् ॥",
  "after": "संशोधनं विशेषात्पीतस्नेहस्य योजयेदनु च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.15",
  "kind": "metre",
  "line": "संशोधनं विशेषात्पीतस्नेहस्य योजयेदनु च ॥",
  "before": "सविसर्पशोषपवनव्याधीन्विषमज्वरान् हन्यात् ॥",
  "after": "श्वित्रे संसनमग्र्यं मलपूरस इष्यते सगुडः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.16",
  "kind": "metre",
  "line": "श्वित्रे संसनमग्र्यं मलपूरस इष्यते सगुडः ॥",
  "before": "संशोधनं विशेषात्पीतस्नेहस्य योजयेदनु च ॥",
  "after": "तं पीत्वाऽभ्यक्ततनुर्यथाबलं सूर्यपादसंतापं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.17",
  "kind": "metre",
  "line": "तं पीत्वाऽभ्यक्ततनुर्यथाबलं सूर्यपादसंतापं ॥",
  "before": "श्वित्रे संसनमग्र्यं मलपूरस इष्यते सगुडः ॥",
  "after": "सेवेदिविरिक्तश्च त्र्यहं त्र्यहं पिपासुः पिबेत्पेयां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.18",
  "kind": "metre",
  "line": "सेवेदिविरिक्तश्च त्र्यहं त्र्यहं पिपासुः पिबेत्पेयां ॥",
  "before": "तं पीत्वाऽभ्यक्ततनुर्यथाबलं सूर्यपादसंतापं ॥",
  "after": "श्वित्रेऽंगे ये स्फोटा जायंते कंटकेन तान् भिंद्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.33",
  "kind": "metre",
  "line": "मार्कवमथवा खादेद्दृष्टं तैलेन लोहपात्रस्थं ॥",
  "before": "पक्षादूर्ध्वं श्वित्रिणा पेयमेवत्कार्यं चास्मै कुष्ठदृष्टं विधानं ॥",
  "after": "बीजकश्रुतं च दुग्धं तदनु पिबेच्छ्वित्रनाशाय ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.34",
  "kind": "metre",
  "line": "बीजकश्रुतं च दुग्धं तदनु पिबेच्छ्वित्रनाशाय ॥",
  "before": "मार्कवमथवा खादेद्दृष्टं तैलेन लोहपात्रस्थं ॥",
  "after": "पूतीकार्कव्याधिघातस्नुहीनां मूत्रैः पिष्टाः पल्लवा जातिजाश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.47",
  "kind": "metre",
  "line": "काकोडुंबरिकावासावल्गुजचित्रकाः सगोमूत्राः ॥",
  "before": "गोपित्तयुक्तमथवा चपलांजनयुग्मलोहरजः ॥",
  "after": "कदलीक्षारयुतं वा खरा स्थिदग्धं सगोरुधिरं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.48",
  "kind": "metre",
  "line": "कदलीक्षारयुतं वा खरा स्थिदग्धं सगोरुधिरं ॥",
  "before": "काकोडुंबरिकावासावल्गुजचित्रकाः सगोमूत्राः ॥",
  "after": "नीलोत्पलं सकुष्ठं ससैंधवं हस्तिमूत्रपिष्टं वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.49",
  "kind": "metre",
  "line": "नीलोत्पलं सकुष्ठं ससैंधवं हस्तिमूत्रपिष्टं वा ॥",
  "before": "कदलीक्षारयुतं वा खरा स्थिदग्धं सगोरुधिरं ॥",
  "after": "हस्तिमदाध्युषितो वा मालत्याः कोरकक्षारः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.51",
  "kind": "metre",
  "line": "सिद्धार्थकाबृहत्यौ करं जकोशातकीफलं गुंजा ॥",
  "before": "हस्तिमदाध्युषितो वा मालत्याः कोरकक्षारः ॥",
  "after": "शुकनासा सगवाक्षी स्वर्णक्षीरी निकुंभश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.62",
  "kind": "metre",
  "line": "मषतिलकचर्मकील ग्रंथ्यर्बुदसर्वकुष्ठघ्नी ॥",
  "before": "श्वित्रं घृष्टं लिप्तं त्रीन्नालेपांस्तथा न लंघयति ॥",
  "after": "कुडवोऽवल्गुजबीजाद्धरितालचतुर्थभागसंमिश्रः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.22.73",
  "kind": "metre",
  "line": "शुद्घ्या शोणितमोक्षैर्वरूक्षणैर्भक्षणैश्च सक्तूनां ॥",
  "before": "कुष्ठे किलासे तिलकालकेषु मषेषु दुर्नामसु चर्मकीले ॥",
  "after": "श्वित्रं कस्य चिदेव हि प्रशाम्यति क्षीणपापस्य ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.23.8",
  "kind": "metre",
  "line": "स्निग्धा बस्तयो नावनानि च प्रयोज्यानि ॥",
  "before": "बिडालनकुलोष्ट्रशृगालादिचर्मभिर्बंधः ॥",
  "after": "दो षोपक्रमणीयं चेक्षेत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.23.31",
  "kind": "metre",
  "line": "रक्ते शीतप्रदेहाविरेकरक्तमोक्षाः ॥",
  "before": "त्वचि स्थितेऽभ्यंगस्वेदनिर्वातानि ॥",
  "after": "मांसमेदसोर्विरेका स्थापनशमनानि ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.23.58",
  "kind": "metre",
  "line": "कुक्कुटकुलीरशिशुमारवराहवसाः पाययेत् ॥",
  "before": "तथाऽनल्पश्लेष्मापगमेन श्वसनविमोक्षात्संज्ञापुनःपुनर्नौपरुध्यते ॥",
  "after": "यवकोलकुलत्थमूलकदधिघृततैलसिद्धां च यवागूं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.23.63",
  "kind": "metre",
  "line": "तिलवकस्नेहविधिरेवाऽशोकर्म्यकयोर्द्रष्टव्यः ॥",
  "before": "एतत्तिलवकसर्पिः स्नेहविरेचनमनिलरोगेपु ॥",
  "after": "शुद्धवातागतानकविधानमेतत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.23.72",
  "kind": "metre",
  "line": "तत्पीतं परमपतन्त्रकश्वासहिध्माह्रद्रोगघ्नं ॥",
  "before": "शुंठीचित्रकभार्गीशुकनासानीचुलमहावलीबृहतीद्वयकाकमाचीपुनर्नवैरक्षमात्रैर्घृतप्रस्थं साधयेत् ॥",
  "after": "पध्याशतार्द्धकल्केन वा सौवर्चलपलद्वययुक्तं चतुर्गुणक्षीरं घृतप्रस्थं विपाचयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.23.91",
  "kind": "metre",
  "line": "क्षीरानुगमे चावर्ताय शीतं मंथयेत् ॥",
  "before": "तथा महातृणपंचमूले विदार्यादिजीवनीयानि मेद्यमांसान्यौदककंदांश्च द्विगुणोदके क्षीरद्रोणे क्षीरशेषं निःकाध्य परिस्राव्य तैलप्रस्थेनोन्मिश्र्य पुनरधिश्रयेत् ॥",
  "after": "ततः स्नेहादाय पूर्ववद्विपचेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.23.101",
  "kind": "metre",
  "line": "एतदप्यणुतैलं नावनात्सर्ववातव्याधिहरं ॥",
  "before": "तामनुगततैलां मृत्तिकामादाय पंचमूलेन सह काथयेत् तमपि काथपरिस्रुत मष्टगुणेन पयसा तैलावशेषं पाचयेत् ॥",
  "after": "तद्वच्च पंचमूलकाष्ठैर्द्घृत्वा भस्मापनीय विदार्यादिसिद्धेन तैलेन शतशो निषिच्य पूर्ववन्मृदमादायोष्णोदकवति कटाहेऽभ्यासिंच्य तैलं पाणिना पिचुना वा गृहीत्वा व्याधिहरौषधकाथमांसरसक्षीराम्लभागसहस्रेण सहस्रपाकं साधयेद्यावत्कालेन शकुयात्पक्तुं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.23.115",
  "kind": "metre",
  "line": "स्थलान्युत्लंघयेत् प्रतिस्रोतः सरितम्मव्यालां तरेत् ॥",
  "before": "व्यायामैश्च विविधैर्मेदः क्षपयेत् ॥",
  "after": "एवमूरुग्रहो शुष्के श्लेष्मणि प्रशाम्यतीति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.23.231",
  "kind": "metre",
  "line": "पित्तं वा दर्शयेद्रूपं बस्तिभिस्तं विनिर्जयेदिति ॥",
  "before": "स्नेहैः स्वेदैर्द्दुतः श्लेष्मा यदा पक्वाशये स्थितः ॥",
  "after": "॥ इति वातव्याधिचिकित्सितं नाम त्रयोविंशोऽध्यायः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.23.232",
  "kind": "metre",
  "line": "॥ इति वातव्याधिचिकित्सितं नाम त्रयोविंशोऽध्यायः ॥",
  "before": "पित्तं वा दर्शयेद्रूपं बस्तिभिस्तं विनिर्जयेदिति ॥",
  "after": "अथातो वातशोणितचिकित्सितं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.24.11",
  "kind": "metre",
  "line": "बल्यं वर्ण्य वृष्यं चक्षुष्यं पुत्रप्रदं च ॥",
  "before": "एतज्जीवनीयाख्यं सर्पिः सर्ववातपित्तविकारान् विशेषतश्च पांडुरोगज्वरापस्मारभगंदरश्वासकासहिक्मास्वरभेदपार्श्वशूलयक्ष्मप्लीहमूत्रसंगाश्मरीवातशोणितसर्वैकांगरोगानपहरति ॥",
  "after": "तैलसात्म्यौ वा क्षीरसिंतोपेतं तैलं पिबेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.24.34",
  "kind": "metre",
  "line": "गोधूमचूर्णी वा छागक्षीरयुक्तो लेपः ॥",
  "before": "मुस्तोनशीरप्रपुंडरीकदार्वीमधुकमंजिष्ठाचंदनप्रलपद्मकैर्वा सक्तुभिः सघृतशर्करैः प्रदेहो दाहरागरुग्विसर्पशोफहरः ॥",
  "after": "तिलाश्च पयसा पिष्टा भृष्टा कंगाले पुनः पयसि प्रक्षिप्य निर्वापिताः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.24.39",
  "kind": "metre",
  "line": "मधुकशृंगबेराभयाकटुरोहिणीनिर्यूहं वा ॥",
  "before": "त्रिफला कषायं वा ॥",
  "after": "यथार्हस्नेहपीतं च मृदु वामयेद्विरुक्षयेच्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.24.40",
  "kind": "metre",
  "line": "यथार्हस्नेहपीतं च मृदु वामयेद्विरुक्षयेच्च ॥",
  "before": "मधुकशृंगबेराभयाकटुरोहिणीनिर्यूहं वा ॥",
  "after": "नच्चातिसेकलेपान्दद्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.24.48",
  "kind": "metre",
  "line": "संसर्गे मिश्रं यथोद्रेकं वा प्रतिकुर्यात् ॥",
  "before": "कैंबुकस्कंधसिद्धैः क्षारोदकतैलमूत्रैः सेकः ॥",
  "after": "सर्वेषु च यथायथं गुडूचीं गुडहरीतकीं पिप्पलीबर्द्धमानं वा शीलयेद्वस्तिकर्म चाभीक्ष्णमिति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.24.119",
  "kind": "metre",
  "line": "समानं शमयेद्द्द्विधा व्यानं च योजयेत् ॥",
  "before": "उदानं योजयेदूर्ध्वमपानं चानुलोमयेत् ॥",
  "after": "प्राणो रक्ष्यश्चतुर्भ्योऽपि तत्स्थितौ देहसंस्थितिः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.01.3",
  "kind": "metre",
  "line": "इति ह स्माहुरात्रेयादयो महर्षयः ॥",
  "before": "अथातो वमनकल्पं व्याख्यास्यामः ॥",
  "after": "वमनद्रव्याणां मदनजीमूतकक्ष्वेवाकुक्कृतिकाशातकीकुटजफलानि च श्रेष्ठानि ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.01.6",
  "kind": "metre",
  "line": "दोषदृष्यादिवशाच्चैषामेतत्कल्पनानां प्राधान्यं ॥",
  "before": "तेष्वपि मदनफलं ॥",
  "after": "दोषादीनामेव चातिबहुवस्थाभेदाद्वमनादिषु कल्यानां व्यापदां साधनानां च यदसंख्येयत्वं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.01.25",
  "kind": "metre",
  "line": "अन्नपानेषु वा तं लेहमवचारयेत् ॥",
  "before": "फलपिप्पलीनां वा भल्लातकविधिश्रुतं स्वरसमादर्वीप्रलेपात्पक्त्वा लेहयेत् ॥",
  "after": "तत्कषायैरेव चान्नपानानि कल्पयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.01.26",
  "kind": "metre",
  "line": "तत्कषायैरेव चान्नपानानि कल्पयेत् ॥",
  "before": "अन्नपानेषु वा तं लेहमवचारयेत् ॥",
  "after": "फलमज्जाक्वाथं वा वत्सकादिप्रतिवापं निंबार्कान्यतरकषायोपसर्जनं संतर्पणोत्थसर्वश्लेष्मव्याधिहरं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.01.29",
  "kind": "metre",
  "line": "एतेन सर्वमाल्यगंधप्रावरणपटा व्याख्याताः ॥",
  "before": "फलपिप्पलीनां वा फलादिनिर्यूहेणैकविंशतिकृत्वः सुभावितानां कुसुमरजःसदृशेन चूर्णेनावचूर्णयेत् सरसि सरोरुहं बृहत सायान्हे तद्रात्रिमुषितं प्रभाते पुनरुपचूर्णितमुद्धृत्य हरिद्राक्रसराक्षीरयवागूनामन्यतमं सैंधवगुडफाणितोपेतमाकंठं पीतवानुपजिघ्रन् सुकुमारः समुचितगंधसंपदुत्क्लिष्टकफपित्तो भेषजद्वेषी च तथा सुखेन च्छर्दयति ॥",
  "after": "एवमेव च फलाभावे मदनपुष्पाणि शलाटूनि च कल्पयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.01.40",
  "kind": "metre",
  "line": "तदेवोष्णेन वातकफजे कफजे वा ॥",
  "before": "जीमूतकचूर्णं कल्कं वा शीतेनांबुना पित्तजे ॥",
  "after": "जीवकर्षभकेक्षुशतावरीणामन्यतमस्य स्वरसेन वा पित्तजे ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.01.52",
  "kind": "metre",
  "line": "तदेव वा मध्यं सगुडपलं भक्षयेत् ॥",
  "before": "सद्रिपकं वा तक्रं समधुसैंधवं ॥",
  "after": "इक्ष्वाकुफलतैलं वा पिबेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "05.01.56",
  "kind": "metre",
  "line": "बिल्वमूलप्रस्थकाथेन वा तुंबीबीजानि काधयेत् ॥",
  "before": "इक्ष्वाकुकल्कं मांसरसेन वातकफगुल्मप्रसक्तज्वरेषु ॥",
  "after": "ततस्तस्मिंस्त्रिभागघृते घृतसमानि पिष्ट्वा तुंबीबीजानि तदर्द्धाशिकानि च प्रत्येकं जीमुतमहाजालिनीवत्सककृतवेधनानि क्वाथतुल्यमेव च त्रिकटुकमावपेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.01.70",
  "kind": "metre",
  "line": "बीजेनानेन मतिमानन्यांनपि विकल्पयेदिति ॥",
  "before": "वमनां दिगित्येषा सुतरामुपयोगिनां ॥",
  "after": "॥ इति वमनकल्पो नाम प्रथमोऽध्यायः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "05.01.71",
  "kind": "metre",
  "line": "॥ इति वमनकल्पो नाम प्रथमोऽध्यायः ॥",
  "before": "बीजेनानेन मतिमानन्यांनपि विकल्पयेदिति ॥",
  "after": "अथातो विरेचनकल्पं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 }
]