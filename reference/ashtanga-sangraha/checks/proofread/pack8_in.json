[
 {
  "id": "01.23.41",
  "kind": "metre",
  "line": "कालश्च भेषजस्ययोग्यतामादधाति ॥",
  "before": "तत्र प्राज्ञएवदोषादिगुरुलाघवेन सम्यगध्यवस्येदन्यतरनिष्ठायां ॥",
  "after": "सतु क्षणलवमुहूर्त्तादिभेदेनातुरवस्थया च द्विधोक्तः प्राक् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.23.60",
  "kind": "metre",
  "line": "ततश्चासावपथ्यतामुपगतो ध्रुवमयोगाय ॥",
  "before": "अपरिसंस्थिततया च क्षितिमलप्रायाभिरम्लविपाकाभिः खगमृगसरीसृपादिशवधातुमूत्रपुरीषसंस्पृष्टाभिरद्भिः सलिलसीकरानुविद्धशिशिरपवनसंपृक्तेन च धराधरोष्मणा कोमलत्वादपरिणतस्यास्य सुतरां विदाहोजन्यते ॥",
  "after": "प्रथमसंगृहीतमपि चौषधं तोयदतोयानुगतमारुतोपहतं जगतीति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.23.68",
  "kind": "metre",
  "line": "आतुरअवस्थासु तु कालाकालसंज्ञा ॥",
  "before": "आत्ययिके तु कृत्रिमगुणोपधानेनयथर्त्तुगुणविपरीतेन संयोगसंस्कारप्रमाणविकल्पैश्चोपपाद्यौषधमवहितोऽवचारयेत् ॥",
  "after": "तद्यथा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.23.131",
  "kind": "metre",
  "line": "॥ इति भेषजावचारणीयो नाम त्रयोविंशोऽध्यायः ॥",
  "before": "एकाग्रमनसा युक्तं भैषज्यममृतायते ॥",
  "after": "अथातो द्विविधोपक्रमणीयमध्यायं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.24.1",
  "kind": "metre",
  "line": "अथातो द्विविधोपक्रमणीयमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति भेषजावचारणीयो नाम त्रयोविंशोऽध्यायः ॥",
  "after": "उपक्रम्यस्यहि द्वित्वाद्विधैवोपक्रमो मतः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.24.136",
  "kind": "metre",
  "line": "॥ इतिद्विविधोपक्रमणीयो नाम चतुर्विंशोऽध्यायः ॥",
  "before": "उपक्रमा न तु द्वित्वाद्विच्चा अपि गदा इव ॥",
  "after": "अथातः स्नेहविधिमध्यायं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.25.1",
  "kind": "metre",
  "line": "अथातः स्नेहविधिमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इतिद्विविधोपक्रमणीयो नाम चतुर्विंशोऽध्यायः ॥",
  "after": "स्नेहादिषूपयोगाय तद्यापच्छमनाय च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.25.110",
  "kind": "metre",
  "line": "स्नेहेन पैत्तिकस्याग्निर्यदा तीव्रीकृतः ॥",
  "before": "विरूक्षणेलंघनवत् कृतातिकृतलक्षणं ॥",
  "after": "स्नेहमाशु जरां नीत्वा पुनरोजोऽभितश्चरन् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.25.123",
  "kind": "metre",
  "line": "स्निग्धद्र्वोष्णधन्वोत्थरसभुक् स्वेद्माचरेत् ॥",
  "before": "सर्व ह्यनुरुजं देहं हत्वा संज्ञां च मारयेत् ॥",
  "after": "स्निग्धस्यहं स्थितः कुर्याद्विरेकं वमनं पुनः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.25.159",
  "kind": "metre",
  "line": "॥ इति स्नेहविधिर्नाम पंचविंशोऽध्याय: ॥",
  "before": "दृढेंद्रियो मंदजर: शतायु: स्नेहोपसेवी पुरुष: प्रदिष्ट: ॥",
  "after": "अथात: स्वेदविधिमध्यायं व्याख्यास्याम: ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.26.1",
  "kind": "metre",
  "line": "अथात: स्वेदविधिमध्यायं व्याख्यास्याम: ॥",
  "before": "॥ इति स्नेहविधिर्नाम पंचविंशोऽध्याय: ॥",
  "after": "चतुर्विधोऽग्निस्वेदो भवति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.26.25",
  "kind": "metre",
  "line": "अथ जेंताकं चिकीर्षुर्भुमिंपरीक्षेत ॥",
  "before": "कुटींमात्युच्चविस्तारां वृत्तामच्छिद्रामुपनाहकल्कघनप्रदिग्धकुड्यां सर्वतोविधूमप्रदीप्तखदिरांगारपूर्णहसंतिकासमूहपरिवृतां विधाय तन्मध्ये चशय्यां तत्रस्थं स्वेदयेदिति कुटीस्वेद: ॥",
  "after": "पूर्वस्यामुत्तरस्यां वा दिशि गुणवति प्रशस्तभूमिभागे देशेकृष्णमृत्तिके सुवर्णवर्णमृत्तिकेवा परीवाहपुष्करिण्यादीनां जलाशयानामन्यतमस्य कूले दक्षिणे पश्चिमे वा सुतीर्थे सममुविभक्तभूमिभागेसर्राष्टौ वाऽरत्नी: परिक्रम्योदकात्प्राङ्मुखमुदङ्मुखं वाऽभिमुखतीर्थेकूटागारं कारयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.26.44",
  "kind": "metre",
  "line": "अनाग्नेयं पुनर्भेद: कफावृत्ते वायौ ॥",
  "before": "उपनाहमनिले किंचत्पित्तसंसृष्टे ऽन्यतरस्मिन् द्रवमिति ॥",
  "after": "निवातसदनगुरुप्रावरणमुद्दुर्मद्यपानक्षुद्धायामातप नियुद्धाध्वभारहरणमर्षमयै: ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.26.67",
  "kind": "metre",
  "line": "स्तंभित: स्याद्वले लब्धे यथोक्तामयनात् ॥",
  "before": "प्रायस्तिक्त कषायं च मधुरं च समासतः ॥",
  "after": "स्तंभत्वक्कुन्तायुसंकोचकपहृद्गाग्हनुग्रहै: ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.26.73",
  "kind": "metre",
  "line": "पीतदुग्धदधिस्नेहमद्यशूनक्षतविरेचनान् ॥",
  "before": "तिमिरोदरवीसर्पकुष्ठरोगाण: ॥",
  "after": "अश्चदग्धगुडग्लानिक्रोधशोकभयार्दितान् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.27.14",
  "kind": "metre",
  "line": "अन्यकार्यव्यग्रस्यौषधं न प्रवर्त्तते ॥",
  "before": "सुकुमारस्य हृदयविकर्षणादूर्ध्वमधो वा रुधिरप्रवृत्ति: ॥",
  "after": "कृच्छ्रेण वा प्रवर्त्तमानमयोगाद्दोषान्कुर्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.27.37",
  "kind": "metre",
  "line": "लंघितादयो भेषजवेगं न सहेरन् ॥",
  "before": "क्षतगुदस्य गुदे प्राणोपरोधकरीं रुजं जनयेत् ॥",
  "after": "राजयक्ष्माार्तस्य क्षीणधातुतया मलत्रलत्वं तदभावाद्देहनाश: स्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.27.67",
  "kind": "metre",
  "line": "वेगांश्चास्य प्रविग्राहगतानवेक्षेत ॥",
  "before": "सर्वेषु च वमनेषु सैंधवं मधु च विदधात्कफविलयनविच्छेद्वनार्थं ॥",
  "after": "तत्राप्रवृत्ति: केवलस्य वा भेषजस्य प्रवृत्तिर्विबंधो वा वेगानामयोगलक्षणं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.27.105",
  "kind": "metre",
  "line": "तत्र कषायमधुरैः पित्ते विरेचनं ॥",
  "before": "ये च स्निग्धास्तच्छ्रपानेन प्रायशस्त्रिसप्तपंचरात्रैरिति ॥",
  "after": "मूत्रकटूष्णैः कफे ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.27.112",
  "kind": "metre",
  "line": "अप्रवृत्तौ भेषजोत्तेजनार्थमुष्णोदकं पाययेत् ॥",
  "before": "यथा च वमने स्वेदप्रसेकौषधककपित्तानिलाः क्रमेण प्रवर्तते तथा विरेचने वातमूत्रपुरीषपित्तकफाः पुनभ्रांतो वायुः दोषाणां हि देहे तथःस.न्निवेशान्मार्गवैपरीत्याच्चशोधनयोरिति ॥",
  "after": "पाणितापैश्च जठरं स्वेदयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.27.125",
  "kind": "metre",
  "line": "सम्यग्विरेकाद्याध्युपशमो यथोक्तविपर्ययश्च ॥",
  "before": "तत्रासम्यग्विरेकात्कुक्षिहृदयाविशुद्धिराध्मानमरुचिः प्रसेकः कफपित्तोत्क्लेशछर्द्दिभ्रमाः कंडूः पिटका विदाहो गौरवमग्निसादस्तंद्रा स्तैमित्यं प्रतिश्यायो वातमूत्रसंगश्र्व ॥",
  "after": "अति.वैरक्कात्तु केबलं दोषरहितमुदकं रक्तं वा मेदोमांसधावनोपमं कृष्णं वा प्रवर्त्तते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.28.1",
  "kind": "metre",
  "line": "अथातो बस्तिविधिमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति बमनविरेचनविधिर्नामसप्तविंशोऽध्यायः ॥",
  "after": "बस्तिरनिलप्रधानेषु प्रयुज्यते ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.28.9",
  "kind": "metre",
  "line": "आस्थापमनुवासन उत्तरबस्तिश्च ॥",
  "before": "स तु बस्तिस्त्रिविधः ॥",
  "after": "तत्रास्थापनं दोषदूष्यानुसारेणनानाद्रव्यसंयोगादिनिर्वृत्तं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.28.14",
  "kind": "metre",
  "line": "तद्य्यःस्थापनादोषस्थापनाद्वाऽऽस्थापनमित्युच्यते ॥",
  "before": "तेषां नामभिरेव स्वरूपमाख्यातं ॥",
  "after": "शरीररोहणादोषनिर्हरणादचिंत्यवीर्यप्रभावतयाचास्मिन्नूहासंभवान्निरूह इति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.28.16",
  "kind": "metre",
  "line": "अनुवासनं यथार्हौषधसिद्धः स्नेहनार्थे स्नेहः ॥",
  "before": "शरीररोहणादोषनिर्हरणादचिंत्यवीर्यप्रभावतयाचास्मिन्नूहासंभवान्निरूह इति ॥",
  "after": "स्नेहविधौ स चतुर्धाऽभिहितः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.28.31",
  "kind": "metre",
  "line": "स्नेहबस्तिस्तु सद्योऽग्निमवसाद्य श्लेष्मामयाय स्यात् ॥",
  "before": "कृतवमनविरेकयोस्तु रिक्तंदेहं क्षतं क्षार इव दहेत् ॥",
  "after": "कृतनस्यस्यास्य विभ्रंशं भृशविवृतोर्ध्वस्त्रोतस्तयाकुर्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.28.36",
  "kind": "metre",
  "line": "स्नेहः पुनरर्शास्यभिष्यंद्याध्मानाय स्यात् ॥",
  "before": "अर्शसस्यावृतमार्गत्वादनागच्छन्बस्तिः प्राणाद्धिंस्यात् ॥",
  "after": "बद्धोदरायाध्मातानां भृशतरमाध्मानामृत्युः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.28.42",
  "kind": "metre",
  "line": "रूक्षोतिदीप्ताग्नयः केवलानिलार्ताश्र्व बिशेषेण ॥",
  "before": "य एवास्थाप्यास्तएवानुवास्याः ॥",
  "after": "ते हि परमनुवासनेनाप्याय्यंते मूलसेकेन वृक्षवत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.28.84",
  "kind": "metre",
  "line": "रूक्षाशिनो विष्टंभं बलवर्णहानिंवा ॥",
  "before": "अतिस्निग्धाशिनो ह्युभयमार्गसंसर्गात्स्नेहो मदमूर्च्छाभिसावह्लासानुजनयति ॥",
  "after": "अल्पमात्रद्रवाशिनो विसृष्टविण्मूत्रस्य चान्नावृतेन तदाबरणाद्यापदं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.28.91",
  "kind": "metre",
  "line": "आतुरोऽपि तदनुलोममवलंबेत ॥",
  "before": "ततो घृताभ्यक्ते पायौवामहस्तप्रदेशिन्याऽभ्यक्तप्रवेशप्रदेशमपनीतवर्त्युत्तानवामहस्तांगुष्ठोदरपिहिताग्रं मध्यमाप्रदेशिन्युपगृहीतकर्णिकमृज्वनुपृष्ठवंशमनुसुखमेकमना लाघवेन निष्कंपमद्रुतमविलंबितं नेत्रमाकर्णिकं प्रवेशयेत् ॥",
  "after": "ततश्र्व वैद्यो बस्तिमुखं दक्षिणहस्तांगुष्ठप्रदेशिनीभ्यामुंमुच्यनेत्रमचालयन् हस्तद्वयेनोत्तानेनैकग्रहणेनैवानिलाधिष्ठानभूतं किंचिदबशेषयन् न शनैर्वेगमनुपीडयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.28.95",
  "kind": "metre",
  "line": "अन्ये तु त्रिंशन्मात्राः पीडनकालमाहुः ॥",
  "before": "ताः ससाधना सिद्धिषु वक्ष्यंते ॥",
  "after": "न च बस्तौ दीयमानेक्षवकासहासजृंभास्पंदनान्यचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.29.1",
  "kind": "metre",
  "line": "अथातो नस्यविधिमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति बस्तिविधिर्नामाष्टाविंशोऽध्यायः ॥",
  "after": "नासायां प्रणीयमानमौषधं नस्यं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.29.3",
  "kind": "metre",
  "line": "नावनं नस्तःकर्मेति च संज्ञां लभते ॥",
  "before": "नासायां प्रणीयमानमौषधं नस्यं ॥",
  "after": "नासाहि शिरसो द्वारं तत्रावसेचितमौषधं स्त्रोतःशृंगाटकं प्राप्य व्याप्यमूर्द्धानं नेत्रश्रोत्रकंठदिसिरामुखानि च मुंजादिषीिकामिवासक्तामूंर्ध्वजत्रुगतां वैकारिकीमशेषामाशु दोषसंहतिमुत्तमांगादपकर्षति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.29.5",
  "kind": "metre",
  "line": "तन्त्रिधा विरेचनं बृंहणं शमनं च ॥",
  "before": "नासाहि शिरसो द्वारं तत्रावसेचितमौषधं स्त्रोतःशृंगाटकं प्राप्य व्याप्यमूर्द्धानं नेत्रश्रोत्रकंठदिसिरामुखानि च मुंजादिषीिकामिवासक्तामूंर्ध्वजत्रुगतां वैकारिकीमशेषामाशु दोषसंहतिमुत्तमांगादपकर्षति ॥",
  "after": "तेषां विरेचनं जत्रूर्ध्वगतेऽधिगौरवशोफोपदेहकंडूस्तंभाभिष्यंदस्त्रावप्रसेकवैरस्यारोचकस्वरभेदकमिप्रतिश्यायापस्मारगंधाज्ञानग्रंथ्यर्बुददद्रुकोठादिषु श्लेष्मजेषु तीक्ष्णेन स्नेहेन शिरोविरेचनद्रव्यैर्वा सिद्धेन तेषां वा क्वाथचूर्णस्वरसैस्तैरेव वा यथाऽर्हद्रव्यश्लक्ष्णकृतालोडितैर्मधुसैंधवासवपित्तमूत्रैर्यथास्वं चोपदिष्टैर्योज्यं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.29.7",
  "kind": "metre",
  "line": "तत्र भीरुस्त्रीकृशसुकुमारेषु स्नेहः ॥",
  "before": "तेषां विरेचनं जत्रूर्ध्वगतेऽधिगौरवशोफोपदेहकंडूस्तंभाभिष्यंदस्त्रावप्रसेकवैरस्यारोचकस्वरभेदकमिप्रतिश्यायापस्मारगंधाज्ञानग्रंथ्यर्बुददद्रुकोठादिषु श्लेष्मजेषु तीक्ष्णेन स्नेहेन शिरोविरेचनद्रव्यैर्वा सिद्धेन तेषां वा क्वाथचूर्णस्वरसैस्तैरेव वा यथाऽर्हद्रव्यश्लक्ष्णकृतालोडितैर्मधुसैंधवासवपित्तमूत्रैर्यथास्वं चोपदिष्टैर्योज्यं ॥",
  "after": "गलरोगसन्निपातज्वरातिनिद्रामनोविकारकृमिशिरोरोगाक्षिस्पंदनतिमिरकच्छ्रविषाभिपन्नाभिष्यंदसर्पदष्टविसंज्ञेषु शेषौ ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.29.18",
  "kind": "metre",
  "line": "तत्र पुनस्तीक्ष्णो वैशेषिकी शिरोविरेचनसंज्ञा ॥",
  "before": "कल्कीकृतादौषधादवपीडितः स्रुतो रसोऽवपीड इत्यपरेषां ॥",
  "after": "तथाऽन्ये सर्वमेव विरेचनं नस्यमित्याहुः सद्यःश्लेष्मविरेचनसामान्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.29.79",
  "kind": "metre",
  "line": "पुनश्च तृतीयेऽह्नि नस्यमवसेचयेत् ॥",
  "before": "अतिद्रवपानं च वर्जयेत् ॥",
  "after": "हिध्मास्वरोपघातमन्यास्तंभापतानकेषुशिरसि चानिलात्र्त्याद्यभिभूते प्रत्यहं सायं प्रातरुभयकालं वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.29.87",
  "kind": "metre",
  "line": "एषां ह्युदीर्णदोषत्वात्तावता दोषोत्क्लेशो भवति ॥",
  "before": "न तु दुष्टप्रतिश्यायबहुदोषकृमिशिरोमद्यपीतदुर्बलश्रोत्रेषु ॥",
  "after": "तस्य पंचदशकालास्तेषां च गुणाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.29.90",
  "kind": "metre",
  "line": "विण्मूत्रशिरोभ्यंगांजनकवलांते दृष्टिप्रसादः ॥",
  "before": "प्रातर्दत्ते भुक्तवतश्वांते स्त्रोतोविशुद्धिः शिरोलाघवं मनःप्रसादश्चभवति ॥",
  "after": "दंतधावनांते दंतदृढता सौगंध्यं च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.29.114",
  "kind": "metre",
  "line": "॥ इति नस्यविधिर्नामैकोनत्रिंशोऽध्यायः ॥",
  "before": "अन्वासमानात्राबस्ती च तद्वदेव विनिर्दिशेत् ॥",
  "after": "अथातो धूमपानविधिमध्यायं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.30.7",
  "kind": "metre",
  "line": "तथा कासघ्नो वामनो व्रणधूपनश्च ॥",
  "before": "शमनो बृंहणः शोधनश्च ॥",
  "after": "तत्र शमनः प्रायोगिको मध्यमइति पर्यायाः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.30.20",
  "kind": "metre",
  "line": "पंच तीक्ष्णस्यनस्यांजनछर्दितस्नानाहः स्वप्नान्ताः ॥",
  "before": "एकादशमृदोः क्षुतन्यवाय हसितचिरासितजृंभितमूत्रशकृद्दंतधावनतर्पण पुटपाक शस्त्रकर्मान्ताः ॥",
  "after": "एषु हि कालेषु वातकफोत्क्लेशोभवति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.30.29",
  "kind": "metre",
  "line": "मुखेन तु मुखेनैव न नासया दृग्विघातभयात् ॥",
  "before": "अथ धूमाई: सुमना ऋजूपविष्टः प्राक्कृतोच्छ्वासनिश्वासो विवृतौष्ठदशनो नेत्राग्रनिविष्टदृष्टिः पर्यायेणैकैकं नासापुटंपिधायेतरेणाक्षिप्य मुखेनोत्सृजेत् ॥",
  "after": "तत्र प्रायोगिकं द्वौ द्वौ त्रींस्त्रीन्वाऽऽपानांस्त्रींश्च पर्यायान्कंठोर्ध्वमुत्क्लिष्टे दोषे पूर्वं नासया ततोमुखेन कंठे तु पूर्वमास्येन परं चाहोरात्रस्य द्विः पिबेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.30.46",
  "kind": "metre",
  "line": "॥ इति धूमपानविधिर्नामत्रिंशोध्यायः ॥",
  "before": "बृंहणो मारुते शस्तो धूमः संशोधनः कफे ॥",
  "after": "अथातो गंडूषादिविधिमध्यायं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.31.3",
  "kind": "metre",
  "line": "तेषामाद्यास्त्रयः क्रमेण वातपित्तकफामयघ्नाः ॥",
  "before": "चतुर्विधो भवति गंडूषः स्नेहिकः शमनः शोधनो रोपणश्च ॥",
  "after": "रोपणस्त्वास्यव्रणघ्नः शमनः स्तंभनःप्रसादनो निर्वापण इतिपर्यायाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.31.21",
  "kind": "metre",
  "line": "कवले तु पर्यायेण कपोलौकंठं च संचारयेत् ॥",
  "before": "अथ निवाते सातपे सुखोपविष्टस्तन्मनाःस्विन्नमृदितगलकपोलललाटदेशो वरमध्यावरं क्रमादर्द्धार्द्धत्रिभागचतुर्भागपूरणीं द्रवमात्रां कल्कं वा कोलप्रमाणं किंचिदुन्नभितास्यो ऽनभ्यवहरन्धारयेत् ॥",
  "after": "अयमेव च कवलगंडूषयोर्विशेषः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.31.26",
  "kind": "metre",
  "line": "एवमुत्क्लिष्टः कफो वक्रं प्रतिपद्यते ॥",
  "before": "पुनश्चास्य स्वेदमर्दनान्याचरेत् ॥",
  "after": "तावच्च धार्योयावत्कफपूर्णकपोलता स्रवद्घ्राणनेत्रता भेषजस्य वा ऽनुपहतिः कफेन ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.31.28",
  "kind": "metre",
  "line": "एवं त्रीन्पंच सप्त वा गंडूषान्धारयेत् ॥",
  "before": "तावच्च धार्योयावत्कफपूर्णकपोलता स्रवद्घ्राणनेत्रता भेषजस्य वा ऽनुपहतिः कफेन ॥",
  "after": "यावद्वा सम्यग्धूमपीतलिंगोत्पत्तिः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.32.1",
  "kind": "metre",
  "line": "अथात आश्योतनांजनविधिमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति गंडूषादिविधिर्नामैकत्रिंशोऽध्यायः ॥",
  "after": "आश्योतनंसर्वाक्षिरोगेष्वाद्य उपक्रमः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.32.9",
  "kind": "metre",
  "line": "आश्योलितं च मृदुना चैलेन शोधयेत् ॥",
  "before": "एवमनासन्नाबिंदुपातेनाक्षिताडनाद्वागादयो जायंते ॥",
  "after": "अन्येन चोष्णांबुप्रुतेन वातकफयोः स्वेदयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.32.21",
  "kind": "metre",
  "line": "न दोषवेगोदयेन चानिर्हृतदोषे ॥",
  "before": "यदा चाश्चोतनेन पित्तश्लेष्मशोणितोत्थेषु नयनामयेषु संशोधनैर्विशुद्धस्य दृषिकाधनत्वपैच्छिल्यकंडूद्वेकश्वयथुम्लानतारागविच्छेदैः पक्वलिंगमुपलक्षितं भवति तदा नेत्रमात्राश्रये व्याधावंजनं प्रयोज्यं ॥",
  "after": "तत्र हि दोषोत्क्लेशेन रागादिद्वद्धिः शुक्रपा कतिमिरोत्पत्तिश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.32.24",
  "kind": "metre",
  "line": "तत्राम्लादिभीरसैः पंचभिः शुक्राद्मादिषु लेखनं ॥",
  "before": "तत्त लेखनं रोपणं स्नेहनं प्रसादनमिति चतुर्विधं भवति ॥",
  "after": "तिक्तकषायैः सस्नेहैरभिष्यंदेष्णु रोपणं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.33.14",
  "kind": "metre",
  "line": "यथादोषोत्कर्ष संसर्गसन्निपातयोः ॥",
  "before": "अनेन विधिना प्रत्यहं वायावेकांतंरंरक्तपित्तयोर्द्वंतरं कफे स्वस्थे च ॥",
  "after": "एवमेकाहं त्र्यहं पंचाहं वा कुर्यादातुरामेवां ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.33.15",
  "kind": "metre",
  "line": "एवमेकाहं त्र्यहं पंचाहं वा कुर्यादातुरामेवां ॥",
  "before": "यथादोषोत्कर्ष संसर्गसन्निपातयोः ॥",
  "after": "तृसातृमातितृप्तलिंगानितु क्रमात्स्वास्थ्यवातपित्तकफविकारैरादिशेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.33.33",
  "kind": "metre",
  "line": "बद्धाक्षश्च मालतीमल्लिकाकुसुमैर्निशां निवसेत् ॥",
  "before": "द्विगुणश्च तर्पणपुटपाकयोः परिहारः ॥",
  "after": "तथा पक्कातिसारेऽपि पुटपाकस्यायमेव विधिरिति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.34.6",
  "kind": "metre",
  "line": "अतःकर्मवशात्तेषामियत्ताऽवधारणमशक्यं ॥",
  "before": "अन्यान्यापि चानेकरूपाण्यनेककार्याणि स्वस्थातुरोपकरणानि ॥",
  "after": "अन्ये पुनरेकोत्तरं यंत्रशतमित्याचक्षते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.34.31",
  "kind": "metre",
  "line": "द्विच्छिद्रं दर्शनार्थमेकच्छिद्रं कर्मणि ॥",
  "before": "षडंगुलानि स्त्रीणां ॥",
  "after": "तथाहि ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.34.36",
  "kind": "metre",
  "line": "भगंदरे तु छिद्रादूर्ध्वमोष्ठमपनोप कुर्वीत ॥",
  "before": "तृतीयं तु तादृशमेव शाम्याख्यं पार्श्वच्छिद्ररहितं पीडनार्थं ॥",
  "after": "तद्वच्च घ्राणार्शोऽर्बुदयंत्रं नाड्याकारं द्व्यंगुलायतमेकच्छिद्रंप्रदेशिनीपरिणाहं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.34.62",
  "kind": "metre",
  "line": "तद्वदेव कर्णेऽष्टांगुलनवांगुले द्वे ॥",
  "before": "तेषामपि दृढसन्नघ्नावणोपयोगिनी षट्सप्तांगुले द्वे ॥",
  "after": "पोयौ दशद्वादशांगुले द्वे ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.34.66",
  "kind": "metre",
  "line": "शलाकाश्चस्थूलसूक्ष्मदीर्घ ह्रस्वमध्याः ॥",
  "before": "तथा क्षारानिकर्मार्थं जांबवौष्ठानि द्वादशदशाष्टांगुलानि क्रमाद्वंगुलांगुलाद्वर्धांगुलफलानि ॥",
  "after": "अंत्रवृद्धावर्द्धेंदुवक्रा मध्योर्ध्वनिर्गतशलाकाग्रग्रहणा ॥",
  "note": "14 aksharas"
 }
]