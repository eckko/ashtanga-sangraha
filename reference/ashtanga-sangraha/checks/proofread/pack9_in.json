[
 {
  "id": "01.34.88",
  "kind": "metre",
  "line": "तेषामाराव्रीहिमुखे भेदने छेदने ॥",
  "before": "कुठारिकादीनि षद्व्यधने ॥",
  "after": "सूच्यः सीवने ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.34.134",
  "kind": "metre",
  "line": "पाशस्योपरि मध्येसंदंशं कर्त्तरीं च ॥",
  "before": "मूलेष्वाहरणार्थानि ॥",
  "after": "शेषाण्यपि यथायोगं क्रियासौकर्येण ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.34.135",
  "kind": "metre",
  "line": "शेषाण्यपि यथायोगं क्रियासौकर्येण ॥",
  "before": "पाशस्योपरि मध्येसंदंशं कर्त्तरीं च ॥",
  "after": "निशानी तु तेषां सुश्लक्ष्णशिलिका माषमुद्गप्रभा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.34.136",
  "kind": "metre",
  "line": "निशानी तु तेषां सुश्लक्ष्णशिलिका माषमुद्गप्रभा ॥",
  "before": "शेषाण्यपि यथायोगं क्रियासौकर्येण ॥",
  "after": "धारासंस्थापनं चशाल्मलीफलकं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.35.18",
  "kind": "metre",
  "line": "पंचाहान्त्र तद्विधएव घटांतरे ताः संचारयेत् ॥",
  "before": "लालादिकोथपरिहारार्थमेव च त्र्यहात्त्र्यहात्पूर्वमन्नपानमपनीयान्त्यत्प्रक्षिपेत् ॥",
  "after": "तासां तुदुष्टशोणितासम्यग्वमनातप्रतपातनाच्च मूर्च्छा भवति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.35.25",
  "kind": "metre",
  "line": "यथा च हंसः क्षीरोदकात्क्षीरमादत्ते ॥",
  "before": "सेचयेच्चांभसामल्पालपं ॥",
  "after": "तद्वदुत्क्लिष्टे रक्ते जलौकाः प्राग् दुष्टमसृक् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.36.30",
  "kind": "metre",
  "line": "चतुर्थकेस्कंधाधोगतानामन्यतरपार्श्वाश्रयां ॥",
  "before": "विद्रधौ पार्श्वशूले च पार्श्वकक्षान्तन्तरस्थाः ॥",
  "after": "तृतीयकेंऽसयोरंतरे त्रिकसंधिमध्यगतां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.36.42",
  "kind": "metre",
  "line": "एवमेव च दक्षिणबाहौ यकृद्दाल्ये ॥",
  "before": "विशेषतस्तु वामबाहोरभ्यंतरतो बाहुमध्ये प्लीहोदरे ॥",
  "after": "तथा कासश्वासयोरप्यादिशंति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.36.66",
  "kind": "metre",
  "line": "उदरोरसोः प्रसारितोरस्कस्योन्नमितशिरसः ॥",
  "before": "ग्रीवासिरासु स्तनयोरुपरि यंत्रं ॥",
  "after": "बाहुभ्यामालंबमानस्य पार्श्वयोः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.36.73",
  "kind": "metre",
  "line": "तत्र मांसेष्ववकाशेषु यवमात्रं व्रीहिमुखेन ॥",
  "before": "तत्रतत्रच तैस्तैरुपायैर्विकल्प्य यंत्रयेत् ॥",
  "after": "अतोऽन्यथाऽर्द्धयवमात्रं व्रीहिमात्रं वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.36.74",
  "kind": "metre",
  "line": "अतोऽन्यथाऽर्द्धयवमात्रं व्रीहिमात्रं वा ॥",
  "before": "तत्र मांसेष्ववकाशेषु यवमात्रं व्रीहिमुखेन ॥",
  "after": "अस्थ्नामुपरि कुठारिकयाऽर्द्धयवमात्रं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.36.90",
  "kind": "metre",
  "line": "पुनःपुनर्मूर्च्छत्यपरेद्युरुद्यहे वा ॥",
  "before": "यस्य तु स्त्रवति रक्ते मूर्च्छा जायतेतस्य विमुच्य यंत्रं शीतसलिलार्द्रपाणिस्पर्शेन व्यजनवायुनाश्रोत्रसुखेन वचसा समाश्वासयन्नुपशमय्य मूर्च्छा पुनः स्रावयेत् ॥",
  "after": "परमं तु रुधिरावसेचनप्रमाणं प्रैस्थः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.36.109",
  "kind": "metre",
  "line": "सर्वथा चानवतिष्ठमाने पाचनाय क्षारं दद्यात् ॥",
  "before": "व्यधादनंतरं वा पुनस्तामेव सिरांविध्येत् ॥",
  "after": "संकोचयितुं वा सिरामुखं तप्तशलाकया दहेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.36.110",
  "kind": "metre",
  "line": "संकोचयितुं वा सिरामुखं तप्तशलाकया दहेत् ॥",
  "before": "सर्वथा चानवतिष्ठमाने पाचनाय क्षारं दद्यात् ॥",
  "after": "न च क्षणमप्युपेक्षेत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.37.7",
  "kind": "metre",
  "line": "पेश्यंतरस्थे शोफवर्जं मांसप्राप्तवत् ॥",
  "before": "मांसगते शोफाभिवृद्धिः शल्यमार्गानुपसंरोहः पीडनासहिष्णुता चोषः पाकश्च ॥",
  "after": "सिरागते सिराध्मानंशूलं च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.37.10",
  "kind": "metre",
  "line": "स्त्रोतोगते स्त्रोतसां स्वकर्मगुणहानिः ॥",
  "before": "स्नायुगे स्नायुजालाक्षेपणं संरंभश्चोग्ररुक् ॥",
  "after": "धमनीस्थे सफेनं रक्तमीरयत्यनिलः सशब्दो निर्गच्छत्यंगपीडा हृल्लासश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.37.18",
  "kind": "metre",
  "line": "शुद्धदेहाणामनुलोमसन्निविष्टान्युपरुध्यंते ॥",
  "before": "सुक्ष्मगतिषु शल्येष्वेतान्येवलक्षणान्यविस्पष्टानि भवंति ॥",
  "after": "दोषप्रकोपन्यथाभिघातेभ्यश्च पुनः प्रचलितानि पुनराबाधयंति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.37.46",
  "kind": "metre",
  "line": "श्वयथुग्रस्तवारंगमुत्पीड्य श्वयथुं ॥",
  "before": "दुर्बलं वारंगं वा कशाभिर्बध्वा ॥",
  "after": "अदेशोसुंडितमश्ममुद्गरप्रहारेण बिचाल्य यथामार्गमेव ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.37.51",
  "kind": "metre",
  "line": "वातविण्मूत्रगर्भसंगं प्रवाहणेन ॥",
  "before": "पक्वाशयगतं विरेचनेन ॥",
  "after": "दुष्टवातविषस्तन्यास्यविषाणादिचूषणेन ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.38.47",
  "kind": "metre",
  "line": "तथा स्नेहोक्तं दिनचर्योक्तमाचारमनुवर्त्तेत ॥",
  "before": "गुग्गुल्वादिभिरेवं शयनासनादि द्विरन्हो धूपयेत् ॥",
  "after": "विशेषतश्च दिवास्वप्नाद्व्रणे शोफकंडूरागरुक्यूप्यवृद्धिः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.38.52",
  "kind": "metre",
  "line": "एवमस्य सम्यगशितं जरामुपैति ॥",
  "before": "भोजयेच्चैनं यथासात्म्यं समातीतशालिषष्टिकयवगोधूमान्यतमं मुद्गमसूराढकी सतींनयूषजांगलरसोपेतं जीवंतीमुनिषण्णतंडुलीय कवास्तुकवार्त्ताकपठोलकारवेल्लकबालमूलकशाकयुक्तं दाडिमामलकसैंधवसहितं सर्पिःस्निग्धं लघ्वल्पमुष्णोदकोत्तरंच ॥",
  "after": "अजीर्णादानिलादीनां विप्रमो बलवान्भवेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.38.75",
  "kind": "metre",
  "line": "सीवनविकल्पास्तुसमासेन चत्वारः ॥",
  "before": "शणाश्मंतकमूर्वात्सीनां वा वल्कैः ॥",
  "after": "गोष्फणिका तुन्नसेवन्या वेल्लितकं ग्रंथिबंधनमिति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.39.15",
  "kind": "metre",
  "line": "वृक्षं नलोभात्र क्रोधाद्ब्राह्मणार्थे विशेषत इति ॥",
  "before": "भेषजार्थं ग्रहीष्यामि सर्वप्राणभृतामिमं ॥",
  "after": "तथाऽपरेयुस्तत्र यद्यद्भुतं वैकृतंवा किंचिन्न पश्येत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.39.25",
  "kind": "metre",
  "line": "मृदौ शर्करादीन्निर्वाप्यापनयेन्न तु पिष्ट्वा क्षिपेत् ॥",
  "before": "एष मध्यमः क्षारः ॥",
  "after": "तीक्ष्णे तु दंतीचित्रकलंगलिकापूतीक प्रवालतालपत्रीबिडसर्जिकारकनकक्षीरीहिँगुवचाऽतिविषाः श्लक्ष्णचूर्णीकृता दग्धाश्च शंखशुक्तयः पूर्ववत् प्रतिवापं दद्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.39.47",
  "kind": "metre",
  "line": "तिलाः समधुका रोपणाश्चास्य पूजिताः ॥",
  "before": "यथाव्याधिदोषं च व्रणमुपक्रमेत् ॥",
  "after": "तत्र पंकजां बवसंकाशमबसन्नमीषद्यथास्वविकारोपशांतौ सम्यग्दग्धं भवति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.39.61",
  "kind": "metre",
  "line": "ज्वरातिसारतृणमोहमूर्च्छा हृद्देहद नार्तिभिः ॥",
  "before": "यात्याशु स्वादुतां तस्मादम्लैर्निर्वापयेत्तरं ॥",
  "after": "कक्षं दहत्यग्निरिवशरीरं क्षारविभ्रमः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.01.4",
  "kind": "metre",
  "line": "इति ह स्माहुरात्रेयादयो महर्षयः ॥",
  "before": "अथातः पुत्रकामियं शारीरंव्याख्यास्यामः ॥",
  "after": "अथ खलुपुमानेकविंशतिवर्षः कन्यामतुल्यगोत्रामतुल्याभिजनामसंचारिरोगकुलप्रसूतां रूपशीललक्षणसंपन्नामनूनामविनष्टदंतौष्ठकर्णनखकेशस्तनींमृदुमरोगाप्रकृतिमकपिलामपिंगलामहीनाधिकांगीं द्वादशवर्षदेशीयाममरभुजगसरिच्चलवृक्षपक्षिनक्षत्रान्यप्रेक्ष्यभीषणकनामान्यनुद्वहंतीमनघामनिंद्या मनिंद्येन विधिनादुद्वहेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.27",
  "kind": "metre",
  "line": "एवं हिसमानगुणतया शुक्रार्तवमाप्यायते ॥",
  "before": "विशेषतस्तु घृतक्षीरवद्भिर्मधुरौषधसंस्कारैः पुरुषं तैलेन नारीं पित्तलैश्च मांसैः ॥",
  "after": "वातपित्तश्लेष्मकुणपगंधिग्रंथिपूयक्षीणमूत्रपुरीषरेतांसि त्वबीजानि भवंति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.01.47",
  "kind": "metre",
  "line": "क्षीरकुलीररसरससिद्धं तैलमुत्तरबस्तिः ॥",
  "before": "मधुकभद्रदारुसिद्धं तैलमनुवासनं ॥",
  "after": "पैत्तिके कांडेंक्षुश्वदंष्ट्रागुडूचीसिद्धं मूर्वामधुकप्रतीवापंसर्पिःपानं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.01.54",
  "kind": "metre",
  "line": "दंतीविडंगचूर्णस्तैललीढो विरेकः ॥",
  "before": "मदनफलकषायो वमनं ॥",
  "after": "राजवृक्षमदनफलकषायप्रगाढमास्थापनं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.60",
  "kind": "metre",
  "line": "सरलमुद्गपर्णीकषायः प्रक्षालनं ॥",
  "before": "प्रियंगुतिलकल्कं वा योनौ धारयेत् ॥",
  "after": "पित्तजे काकोलीद्वयविदारीमूलक्वाथमुत्पलपद्मकक्वाथं मधुकपुष्पकाश्मर्यफलक्वाथं वासशर्करं पिबेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.69",
  "kind": "metre",
  "line": "समाक्षिकं वा क्षीरिवृक्षभवालकाथं ॥",
  "before": "श्लैष्मिके कुटजकटुकाऽश्वगंधाक्वाथं पिबेत् ॥",
  "after": "एतेषामेव वा चूर्ण मधुघृताभ्यां लिह्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.85",
  "kind": "metre",
  "line": "शुद्धयोनिगर्भाशयार्तवाया मासमपि तु केचित् ॥",
  "before": "षोडशरात्रमित्यन्ये ॥",
  "after": "तद्वददृष्टार्तवोऽप्यस्तीत्यपरे ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.01.108",
  "kind": "metre",
  "line": "स्त्री च पुरुषाकृतिर्दुर्बलाहीनांगी वा ॥",
  "before": "यदि त्वाहारानुरोधादयुग्मासु शुक्रस्याधिक्यता युग्मासु च न्यूनता स्यात् ततःपुमान् स्त्र्याकृतिर्दुर्बलो हीनांगो वा जायते ॥",
  "after": "एकादशीत्रयोदश्योस्तु नपुंसकं स्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.109",
  "kind": "metre",
  "line": "एकादशीत्रयोदश्योस्तु नपुंसकं स्यात् ॥",
  "before": "स्त्री च पुरुषाकृतिर्दुर्बलाहीनांगी वा ॥",
  "after": "अथोपाध्यायः पुत्रीयं विधानमाचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.110",
  "kind": "metre",
  "line": "अथोपाध्यायः पुत्रीयं विधानमाचरेत् ॥",
  "before": "एकादशीत्रयोदश्योस्तु नपुंसकं स्यात् ॥",
  "after": "शुद्धायास्तु मंत्रवर्जित ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.119",
  "kind": "metre",
  "line": "भगोऽथ मित्रावरुणौ वीरं दधतु मे सुतमिति ॥",
  "before": "ब्रह्मा बृहस्पतिर्विष्णुः सोमः सूर्यस्तथाऽश्विनौ ॥",
  "after": "ततः परस्परं सामभिरभिसांत्व्य सहर्षमनुकूलं संवेसेतां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.01.128",
  "kind": "metre",
  "line": "वामपार्श्वगायास्तद्वत्पित्तं विदहति रक्तशुके ॥",
  "before": "दक्षिणपार्श्वगायाः श्लेष्मा पीडितश्च्युतो ऽपिदधाति गर्भाशयं ॥",
  "after": "दस्मादुत्ताना बीजंगृह्णीयात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.01.130",
  "kind": "metre",
  "line": "तथािह यथास्थानमेव तिष्ठंति दोषाः ॥",
  "before": "दस्मादुत्ताना बीजंगृह्णीयात् ॥",
  "after": "लब्धगर्भांचैनां विदित्वा प्रागव्यक्तीभावादृर्भस्य पुष्ये पुंसवनादि प्रयुंजीत ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.01.169",
  "kind": "metre",
  "line": "॥ इति पुत्रकामीयोनाम प्रथमोऽध्यायः ॥",
  "before": "गर्भस्य तन्न किंचित्तु करोतीति न चिंत्यते ॥",
  "after": "अथातो गर्भावक्रांतिशारीरं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.02.73",
  "kind": "metre",
  "line": "यदा स्त्रीपुंसयोः सममर्थो निष्पद्यते ॥",
  "before": "बहूनि वा वर्षाण्युदरे तिष्ठति ॥",
  "after": "बीजं वा तयोः समांशं संमुखं च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.02.102",
  "kind": "metre",
  "line": "श्लेष्मा तु कुष्ठकिलाससदंतवादीनि ॥",
  "before": "तथा वायुवत्पित्तमपि खलतिपलितश्मश्रुहीनत्वक्छ्रनखे शपैंगल्यादीनि ॥",
  "after": "त्रिवर्गौमिश्रान्विकारान् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.02.124",
  "kind": "metre",
  "line": "स्वप्नशीला निद्रालुमबुधमल्पाग्निं वा ॥",
  "before": "अमर्षणा चंडमौपधिकंवा ॥",
  "after": "मद्यनित्या तृष्णालुमल्पस्मृतिमनवस्थितं वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.02.151",
  "kind": "metre",
  "line": "इतिगर्भावक्रांतिर्नाम द्वितीयोऽध्यायः ॥",
  "before": "वायोर्मार्गनिरोधाच्च न गर्भस्थः प्ररोदिति ॥",
  "after": "अथातो गर्भोपचरणीयं शारीरं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.03.7",
  "kind": "metre",
  "line": "विशेषेण द्वितीये मधुरौषधसिद्धं पयः पिबेत् ॥",
  "before": "यथोक्तानि च दोषकराणि परिहरेदार्पचमान्मासात् ॥",
  "after": "तृतीये तदेव सर्पिर्मधुभ्यां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.03.24",
  "kind": "metre",
  "line": "अष्टमे क्षीरयवागूं सर्पिष्मतीं पिबेत् ॥",
  "before": "मधुरं चाहारमल्पमल्पस्नेहलवणमल्पोदकानुपानं भुंजीत ॥",
  "after": "नेति षंढकाथो गर्भस्यपैंगल्याबाधभयात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.03.26",
  "kind": "metre",
  "line": "अस्ति पैंगल्याबाधस्तथाप्येवं कुर्वीत ॥",
  "before": "नेति षंढकाथो गर्भस्यपैंगल्याबाधभयात् ॥",
  "after": "नीरुजं बलवर्णसत्त्वसंहननसंपदुपेतं ज्ञातीनामग्रगण्यमपत्यं जनयतीति भगवान्आत्रेयः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.03.30",
  "kind": "metre",
  "line": "अनुलोमे हिमारुते सुखमनुपद्रवा प्रसूते ॥",
  "before": "पुराणविद्विश्शुत्त्यर्थं मधुकादिमधुरौषधसिद्धेन च तैलेनानुवासयेदनुलोमनाय वायोः ॥",
  "after": "गर्भिणीं तु न्युब्जामास्थापयेदनुवासयेद्वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.03.42",
  "kind": "metre",
  "line": "स्वल्पेऽपि च विण्मूत्रविबंधे फलवर्तीः प्रणिदध्यात् ॥",
  "before": "तत्रानुकूलेषु नक्षत्रादिषु पुण्याहशब्देन गोब्राह्मणवृद्धान्त्वाऽऽवर्तमाना प्रदक्षिणं प्रविश्यबहुशः प्रसूताभिरनुक्ताभिरविपादाभिः क्लेशक्षमाभिः परितृता स्वस्त्ययनपराऽनुलोमनेराहारविहारैरनुलोमितवातम्त्रपुरीषा प्रसवकालमुदीक्षेत ॥",
  "after": "तत्रासन्नप्रसवायाः क्लमो ग्लानिर्मुक्तबंधने इवाक्षिणी निष्टीविकामूत्रपुरीषबाहुल्यं शिथिलकुक्षिताऽधोगुरुत्वमन्नानभिलाषो वेदनोदरत्हृदयकटीबस्तिवंक्षणेषु तोदभेदशूलस्फुरणस्त्रवणानि च योन्याभवंति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.03.61",
  "kind": "metre",
  "line": "अन्या तु वामकर्णेऽस्या मंत्रमिमं जपेत् ॥",
  "before": "ब्रूयाच्च सुभगे शनैः शनैः प्रवाहयस्व सुप्रसन्नेते मुखवर्णः पुत्रं जनयिष्यतीति ॥",
  "after": "क्षितिर्जलं वियत्तेजो वायुर्विष्णुः प्रजापतिः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.03.65",
  "kind": "metre",
  "line": "कार्तिकेयद्युतिं पुत्रं कार्तिकेयाभिरक्षितमिति ॥",
  "before": "प्रसूष्व त्वमविक्ळिष्टमविक्ळिष्टा शुभानने ॥",
  "after": "तथा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.03.72",
  "kind": "metre",
  "line": "अनागतायां वेदनायां मा प्रैवाहिट्टाः ॥",
  "before": "तथा पराऽनुशिष्यात् ॥",
  "after": "अकालप्रवाहणंहि विण्मूत्रादिवेगानामिवोदीरणमनर्थकरमहितं च गर्भस्य श्वासकासशोषकुब्जतादिकारित्वात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.03.84",
  "kind": "metre",
  "line": "स्फिजौ वोपसंगृह्य सुपीडितं पीडयेत् ॥",
  "before": "पाष्ण्यां वा श्रोणिमाकुट्टयेत् ॥",
  "after": "वेण्याऽङ्गुल्या वा केशवेष्टितया चकण्ठतालु परामृशेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.03.98",
  "kind": "metre",
  "line": "कुष्ठलाङ्गलीमुलकल्कंवा मद्यमूत्रान्यतरेण ॥",
  "before": "अर्कालेर्ककषायं वा सुरोन्मिश्रं ॥",
  "after": "वत्सकादिचूर्णं वा मद्येन ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.03.113",
  "kind": "metre",
  "line": "लवणचूर्णं वावत्सकादिनिर्यूहेण ॥",
  "before": "अथवा वीरतरादिमूषकादिप्रतीवापं ॥",
  "after": "वत्सकादिं वा मदिरया ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.04.6",
  "kind": "metre",
  "line": "सहस्रधौतेनसर्पिषाऽधोनाभेः सर्वतः प्रदिह्यात् ॥",
  "before": "तद्यथा ॥",
  "after": "मधुकसर्पिषा सुशीतेन पिचुमाप्लाव्य योनिसमीपे स्थापयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.04.10",
  "kind": "metre",
  "line": "तच्छृङ्गसिद्धस्य वा क्षीरसर्पिषः पिचुं ॥",
  "before": "परिपीततत्वरसानि च तैलानियोनौ निधापयेत् ॥",
  "after": "अतिस्रवति तु रक्ते तत एवाक्षमात्रं प्राशयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.04.11",
  "kind": "metre",
  "line": "अतिस्रवति तु रक्ते तत एवाक्षमात्रं प्राशयेत् ॥",
  "before": "तच्छृङ्गसिद्धस्य वा क्षीरसर्पिषः पिचुं ॥",
  "after": "केवलादेव वा क्षीरसर्पिषः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "02.04.39",
  "kind": "metre",
  "line": "तस्मात्तीक्ष्णैरनवशेषयञ्चुपाचरेत् ॥",
  "before": "आमगर्भशेषेण हि पुनः पुनः शूलमनुषज्येत ॥",
  "after": "ततः परं स्नेहपानैर्बस्तिभिराहारैश्च दीपनीयपाचनीयजीवनीयबृंहणीयमधुरवातहरैरिति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "02.04.58",
  "kind": "metre",
  "line": "पित्ते मधुकविदारीनिर्यूहसिद्धं पयः पिबेत ॥",
  "before": "निवातं च सेवेत ॥",
  "after": "तिस्रः स्थूलकुक्कुटीर्निस्तुषमाषाढकं च क्षीरोदकेनोदूखले संक्षुध्य तद्रसेन सर्पिषा च तित्तिरिकपिंजलान्यातररसं साधयित्वा पाययेदुपविष्टकविवर्द्धनार्थमुपशुष्ककवृद्व्यर्थं च ॥",
  "note": "18 aksharas"
 }
]