[
 {
  "id": "03.09.5",
  "kind": "metre",
  "line": "तत्र वातबस्त्यादयो नव वातोल्बणाः ॥",
  "before": "वातपित्तकफसन्निपातकृच्छ्राणि वातपित्तश्लेष्मशुक्राश्मर्यो वातबस्त्यष्ठीलाकुंडलिकामूत्रातीतजठरोत्संगग्रंथिशुक्रविद्घातोष्मवातमूत्रक्षयावसादाश्चेति ॥",
  "after": "ततो द्वौ वातपित्तोल्बणौ ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.09.24",
  "kind": "metre",
  "line": "पित्तेन पच्यमान इव दह्यते बस्तिः ॥",
  "before": "तत्र वायुना बस्तिसेवनीमेहेनेषु तीव्रवेदनार्दितो दंतान् खादति नाभिं पीडयति मेंढ्रं मृद्नाति मुहुर्मुहुर्वेपथुमान् कृच्छ्रात्सवातं शकृद्विमुंचति विशीर्णधारं च मूत्रयत्यश्मरी चास्य श्यावा परुषा विषमा कदंबपुष्पवत्कंटकाचिता भवति ॥",
  "after": "अश्मरी च सरक्ता पीतावभासकृष्णा भल्लातकास्थिसंस्थाना ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.09.31",
  "kind": "metre",
  "line": "पीडितमात्रे च तस्मिन्नवकाशे विलीयतइति ॥",
  "before": "सा शुक्रमार्गमावृणोति मूत्रकृच्छ्रं बस्तिवेदनां वृषणयोश्च श्वयथुमुत्पादयंति उत्पन्नमात्रायां च शुक्रं निरेति ॥",
  "after": "अश्मर्यैव तु वायुनाऽणुशो विभिन्ना शर्करेत्युच्यते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "03.09.36",
  "kind": "metre",
  "line": "अयं द्विविधोऽपि वातबस्तिः कृच्छ्रसाध्यः ॥",
  "before": "कदाचिच्च बस्तिं स्वस्थानात्प्रच्याव्य गर्भमिवोद्भूतं स्थूलं परिप्लुतं च कुरुते तत्र च शूलस्पंदनदाहोद्वेष्टनानि बिंदुशश्च मूत्रस्त्रवणं पीडिते च बस्तौ धारया प्रवृत्तिः ॥",
  "after": "तयोरपि द्वितीयोऽनिलप्रबलः कृच्छ्रसाध्यतरः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.09.37",
  "kind": "metre",
  "line": "तयोरपि द्वितीयोऽनिलप्रबलः कृच्छ्रसाध्यतरः ॥",
  "before": "अयं द्विविधोऽपि वातबस्तिः कृच्छ्रसाध्यः ॥",
  "after": "बस्तिविण्मार्गांतरे वायुर्घनोन्नतं तीव्ररुजमचलमष्ठीलांभं ग्रंथिं करोति तेनानिलविण्मूत्रसंगो भवत्याध्मानं च सा वाताष्ठीला ॥",
  "note": "18 aksharas"
 },
 {
  "id": "03.10.14",
  "kind": "metre",
  "line": "तस्मात्कफपित्तवातजाः क्रमेण साध्ययाप्यासाध्याः ॥",
  "before": "तत्क्षयेऽपि वायूरसादीन्धातून् शरीरस्य परस्परं सारभूतान्बस्तिमाहृप्य मूत्रेण सह विसृजति ॥",
  "after": "तथा पित्तजाः संसृष्टदोषमेदःस्थानत्वाद्विरुद्धोपक्रमत्वाच्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "03.10.24",
  "kind": "metre",
  "line": "सुरातुल्यमुपरिप्रसन्नमधः सांद्रं सुरामेही ॥",
  "before": "पर्युषितं सांद्रीभवत्सांद्रमेही ॥",
  "after": "हृष्टरोमा पिष्टमिव सांद्रसितं च पिष्टमेही ॥",
  "note": "18 aksharas"
 },
 {
  "id": "03.10.27",
  "kind": "metre",
  "line": "सरुजं ससिकतमिव सिकतामेही ॥",
  "before": "शुक्राभं शुक्रमिश्रं वा शुक्रमेही ॥",
  "after": "मधुरमतिशीतं शीतमेही ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.10.34",
  "kind": "metre",
  "line": "कटुकं सदाहं हारिद्राभ्रुतमिव हारिद्रमेही ॥",
  "before": "सफेनमच्छमम्लं चाषपत्रनीलं नीलमेही ॥",
  "after": "विस्रं मंजिष्ठोदकवर्णं मंजिष्ठमेही ॥",
  "note": "18 aksharas"
 },
 {
  "id": "03.10.35",
  "kind": "metre",
  "line": "विस्रं मंजिष्ठोदकवर्णं मंजिष्ठमेही ॥",
  "before": "कटुकं सदाहं हारिद्राभ्रुतमिव हारिद्रमेही ॥",
  "after": "विस्रमुष्णं लवणं शोणितसंकाशं शोणितमेही ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.10.36",
  "kind": "metre",
  "line": "विस्रमुष्णं लवणं शोणितसंकाशं शोणितमेही ॥",
  "before": "विस्रं मंजिष्ठोदकवर्णं मंजिष्ठमेही ॥",
  "after": "वसामिश्रं वसां वा वसामेही ॥",
  "note": "18 aksharas"
 },
 {
  "id": "03.10.57",
  "kind": "metre",
  "line": "कठिना विदारिकंदवृत्ता विदारिका ॥",
  "before": "महती पिटिकाभिरल्पाभिराचिता पुत्रिणी ॥",
  "after": "शीघ्रपाका महावेदना सर्षपाकृतिप्रमाणा तद्विधाभिश्च पिटिकाभिश्चिता सर्षपिका ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.11.83",
  "kind": "metre",
  "line": "स्वदोषाधिष्ठानश्च सर्वो भवति गुल्मः ॥",
  "before": "गुल्मएव च वर्द्धते न कुक्षिः ॥",
  "after": "तस्माच्चिरेण नैव पाकमैति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.12.93",
  "kind": "metre",
  "line": "॥ इत्युदरनिदानं नाम द्वादशोऽध्यायः ॥",
  "before": "बलिनस्तदजातांबु यत्नसाध्यं नवोत्थितं ॥",
  "after": "अथातः पांडुरोगकामलाशोफविसर्पनिदानं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.13.5",
  "kind": "metre",
  "line": "श्लेष्मत्वङ्मांसानि प्रदूष्यांतरमाश्रितं ॥",
  "before": "धमनीर्दश संप्राप्य व्याप्नुवत्सकलं वपुः ॥",
  "after": "त्वङ्मांसयोस्तत्कुरुते त्वचि वर्णान् पृथग्विधान् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.14.1",
  "kind": "metre",
  "line": "अथातः कुष्ठकृमिनिदानं व्याख्यास्यामः ॥",
  "before": "॥ इति पांडुकामलाशोफविसर्पनिदानं नाम त्रयोदशोऽध्यायः ॥",
  "after": "मिथ्याहारविहारेण विशेषेण विरोधिना ॥",
  "note": "14 aksharas"
 },
 {
  "id": "03.14.16",
  "kind": "metre",
  "line": "मंडलारख्यं विसर्ची च ऋक्षारख्यं वातपित्तजं ॥",
  "before": "वातेन कुष्ठं कापालं पित्तादौदुंबरं कफात् ॥",
  "after": "चर्मैककुष्ठकिटिभसिध्मालसविपादिकाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "03.15.1",
  "kind": "metre",
  "line": "अथातो वातव्याधिनिदानं व्याख्यास्यामः ॥",
  "before": "॥ इति कुष्ठकृमिनिदानं नाम चतुर्दशोऽध्यायः ॥",
  "after": "सर्वार्थानर्थकरणे विश्वस्यास्यैककारणं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.01.3",
  "kind": "metre",
  "line": "इति ह स्माहुरात्रेयादयो महर्षयः ॥",
  "before": "अथातो ज्वरचिकित्सितं व्याख्यास्यामः ॥",
  "after": "आमाशयस्थो हत्वाग्निं सामो मार्गान्पिधापयन् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.02.44",
  "kind": "metre",
  "line": "बर्द्धमहिध्माऽरुचिश्वरसकासपांडुविकारिणां ॥",
  "before": "तत्कफावृतसर्वोत्थज्वरिणाममृतोपमं ॥",
  "after": "गलग्रंथिप्रमेहार्शः प्लीहापस्मारशोफिनां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.03.22",
  "kind": "metre",
  "line": "त्रिवृच्छ्यामाकषा... कल्केन च सशर्करं ॥",
  "before": "यथास्वं कल्पविहिता विरेकार्थं प्रयोजयेत् ॥",
  "after": "साधयेद्विधिवल्लेहं लिह्यात्पाणितलं ततः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.04.132",
  "kind": "metre",
  "line": "गुडक्षारोपकरणकणादाडिमं श्वासकासजित् ॥",
  "before": "कासे श्वासे च हिध्मायां लिह्यात्क्षौद्रघृतप्लुतं ॥",
  "after": "क्रमात्पलद्वयार्द्धाक्षकणार्द्धाक्षपलोन्मितं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.08.1",
  "kind": "metre",
  "line": "अथातश्छर्दिहृद्रोगतृष्णाचिकित्सितं व्याख्यास्यामः ॥",
  "before": "॥ इति राजयक्ष्मचिकित्सितं नाम सप्तमोऽध्यायः ॥",
  "after": "आमाशयोत्क्लेशभवाः प्रायश्छर्द्यो हिंतं ततः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.08.151",
  "kind": "metre",
  "line": "नस्यं क्षीरघृतं सिद्धं शीतैरीक्षुरसतथा रसे ॥",
  "before": "मुद्गादीनां तथा यूषैर्जीवनीयरसान्वितैः ॥",
  "after": "नारीक्षीरेण वा घृष्टमुष्ट्रास्थि ससितं हितं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.09.52",
  "kind": "metre",
  "line": "सनागरं योजयेत तित्तिरिइमपति भोजनं ॥",
  "before": "गुडूचीभद्रमुस्तानां पटोलस्याथवा रसं ॥",
  "after": "तृप्यते चातिबलवद्द्वातपित्ते समुद्धते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.09.270",
  "kind": "metre",
  "line": "॥ इति मदात्ययादिचिकित्सितं नाम नवमोऽध्यायः ॥",
  "before": "तस्य संरक्षितव्यं च मनः प्रलषहेतुतः ॥",
  "after": "अथातोऽर्शसां चिकित्सितं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.6",
  "kind": "metre",
  "line": "ततो निवातमागारं प्र वेश्याचौरिकमुपदिशेत् ॥",
  "before": "छत्राकाराण्यूर्ध्व विस्तृतानि क्षारसूत्रेण बध्वा ततो यंत्रमपनीयोत्थाप्यातुरं स्वभ्यक्तगुदजघनवंक्षणं यथाकालमुष्णोदककोष्ठे शीतोदककोष्ठे वाऽवगाहयेत् ॥",
  "after": "सावशेषं पुनर्दाहयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.9",
  "kind": "metre",
  "line": "बहुषु तु प्राग्दक्षिणं ततो वामं वामात्पृष्ठाग्रजं ॥",
  "before": "एवं समरात्रात्समरात्रादेकैकमुपक्रमेत् ॥",
  "after": "एकाहं सर्वाणि दहतोऽतियोगोक्तो दोषः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.11",
  "kind": "metre",
  "line": "तत्र शुष्काण्यग्निना क्षारेण वा साधयेत् ॥",
  "before": "एकाहं सर्वाणि दहतोऽतियोगोक्तो दोषः ॥",
  "after": "क्षारेणैव मृदुनाऽऽर्द्राणि ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.27",
  "kind": "metre",
  "line": "सुरसा बृहतीपिप्पल्यश्वगंधाभिर्वा ॥",
  "before": "कुंजरवराहवृषशकृत्सक्तुसर्जरसैर्वा ॥",
  "after": "अरिष्टशिग्रुपत्रकुलत्थगवादनीभिर्वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.37",
  "kind": "metre",
  "line": "एभिश्च तैलान्यभ्यंगार्थमुपकल्पयेत् ॥",
  "before": "एभिर्हि प्रदिग्धान्यर्शांसि दुष्टमसृक् संचितं पिच्छां च विमुच्य प्रशाम्यन्ति ॥",
  "after": "तथा कासीससैंधवालपिप्पलीकुष्ठशुंठीविडंगविदारीलांगलीकरवीरार्कस्वर्णक्षीरीदन्तीचित्रकालर्कसुधापयोभिस्तैलं चतुर्गुणं मूत्रं विपक्मप्रदूषयद्गुदमभ्यंगात्क्षारवदर्शांसि शातयति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.40",
  "kind": "metre",
  "line": "अनंतरं च यथोक्तेनावगाहनेन ॥",
  "before": "तैलाभ्यक्तं वा पायुप्रदेशं पकेष्टिकासकलैस्तीक्ष्णकोटिभिरग्निवर्णैर्महिषीमूत्रनिर्वापितैर्निष्पीडयन् द्विकालं सप्तदिनानि स्वेदयेत् ॥",
  "after": "ततो गते सप्तरात्रे पूतिकरंजपल्लवकल्केन ससैंधवेन सस्नुहीपयसा वर्तिं कृत्वा नातिशुष्कां गुदे विदध्यात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.59",
  "kind": "metre",
  "line": "कटुकिकामूलकल्कं वा प्रातस्तक्रेण ॥",
  "before": "पीलूनि वा तक्रानुपानानि प्रातः पक्षं पक्षार्द्धं वा प्रयोजयेत् ॥",
  "after": "शुंठीचित्रकपुनर्नवाक्वाथसिद्धं वा क्षीरं गोमूत्रपरिस्रुते वा बहुकृत्वोऽजामूत्रक क्षार उषिता हरीतकीः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.63",
  "kind": "metre",
  "line": "भल्लातकानि वा रसायनोपदेशेन ॥",
  "before": "वासिष्ठहरीतकीर्वा ॥",
  "after": "पुनर्नवामलंबुषां वा शोफोक्तविधिना ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.85",
  "kind": "metre",
  "line": "अयं दुरालभारिष्टः समानः पूर्वेण ॥",
  "before": "दुरालभायाः प्रस्थमभयाऽऽमलकवृषपाठाचित्रकदंतीमहौषधामां प्रत्येकं द्विपलम्भासो द्रोणे पूर्ववत्सिद्धं पूतशीतं शर्करातुल्योन्मिश्रं मधुघृतप्रियंगुपिप्पलीचविकाकल्कलित्ते घृतकुंभे पक्षं निधापये त् ॥",
  "after": "नवामलकपलशतं पिप्पली नागपुष्पकुडुवद्वयं पालिकानि चव्यचित्रकक्रमुकरोध्रपाठामरिचविडंगमंजिष्ठैलवालुकपिप्पलीमूलान्यर्द्धपलांशानि दार्बीशताहेंद्रहासासरिबाद्यमुस्तकुष्ठान्यैकध्यं जलद्रोणद्वयेऽर्द्धावशेषं साधयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.91",
  "kind": "metre",
  "line": "एष षण्मासस्थितो गुग्गुलुप्राशः समानः पूर्वेण ॥",
  "before": "गंधबर्णसोपपन्नं चासवमभिसमीक्ष्य तं कुंभमिक्षुरसस्य पूरयेत् ॥",
  "after": "अमद्यपो वा पिबेच्छृतशीतमल्पमुदकं शृतं वा धान्यानागराभ्यां वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.118",
  "kind": "metre",
  "line": "उभौ च तत्रानुबध्येते श्लेष्माऽनिलो वा ॥",
  "before": "अशुद्धं च कालबलापेक्षी स्वबुद्धिरुपेक्षेत ॥",
  "after": "तत्र पित्तश्लेष्मोल्बणं पाचनदीपनद्रव्यैरुपेक्षया च संशोध्य शमयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.147",
  "kind": "metre",
  "line": "वृक्षांम्लदाडिमाम्लाम्लीकाम्लां सकोलाम्लां ॥",
  "before": "ह्रीवेरबिल्वनागरनिर्यूहे साधितां सवननीतां ॥",
  "after": "गुंजनकसुरासिद्धां दद्याद्यमकेन भर्जितां पेयां ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.10.149",
  "kind": "metre",
  "line": "रक्तातिसारग्रहणीप्रवाहिकाशोफनिग्रहिणीं ॥",
  "before": "गुंजनकसुरासिद्धां दद्याद्यमकेन भर्जितां पेयां ॥",
  "after": "काश्मर्य्यामलकानां सकच्छुराणां खलान् फलाम्लांश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.150",
  "kind": "metre",
  "line": "काश्मर्य्यामलकानां सकच्छुराणां खलान् फलाम्लांश्च ॥",
  "before": "रक्तातिसारग्रहणीप्रवाहिकाशोफनिग्रहिणीं ॥",
  "after": "गुंजनकशाल्मलीनां दुग्धीकाचुक्रिकाणां च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.152",
  "kind": "metre",
  "line": "न्यग्रोधशृंगिकानां खलांस्तथा कोविदारपुष्पाणां ॥",
  "before": "गुंजनकशाल्मलीनां दुग्धीकाचुक्रिकाणां च ॥",
  "after": "दघ्नः सेरेण सिद्धान् दद्याद्रक्ते प्रवृत्तेऽति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.154",
  "kind": "metre",
  "line": "सिद्धं पलांडुशाकं तक्रेणोपोदकां सबदरां च ॥",
  "before": "दघ्नः सेरेण सिद्धान् दद्याद्रक्ते प्रवृत्तेऽति ॥",
  "after": "रुधिरस्रुतौ प्रदद्यान्मासूरसूपं सतक्राम्लं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.161",
  "kind": "metre",
  "line": "अद्याद्रसैरतिवहेष्वर्शःस्वनिलोल्बणशरीरः ॥",
  "before": "दक्षशिखिनित्तिर्रिरसैर्दिककुल्लोपा कजैश्च मधुराम्लैः ॥",
  "after": "छगलीपयः प्रयुक्तं निहंति रक्तं सवास्तुकसरसञ्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.165",
  "kind": "metre",
  "line": "रक्तमनिबर्त्तमानं वातं च पलांडुरुपयुक्तः ॥",
  "before": "रसखलशाकयवागूसंयुक्तः केंवलोऽथवा जयति ॥",
  "after": "छागांतराधि तरुणं सधिरमुपसाधितं बहुपलांडु ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.170",
  "kind": "metre",
  "line": "नवनीतघृतं छागं छागं मांसं सषष्टिकः शालिः ॥",
  "before": "दधिसरमथिताभ्यासादर्शांस्युपयांति रक्तवाहीनि ॥",
  "after": "तरुणश्च सुरामंडस्तरुणीच सुरा जयत्यस्रं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.171",
  "kind": "metre",
  "line": "तरुणश्च सुरामंडस्तरुणीच सुरा जयत्यस्रं ॥",
  "before": "नवनीतघृतं छागं छागं मांसं सषष्टिकः शालिः ॥",
  "after": "प्रायेण वातबहुलान्यर्शांसि भवंत्यतिस्रुते रक्ते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.193",
  "kind": "metre",
  "line": "तस्मात्तत्राशुतरं स्नेहनमनुवासनं विदध्यात् ॥",
  "before": "रूक्षतया च विद्वातविबंधेन शुष्कोदावर्त्तसंभवः ॥",
  "after": "पिप्पलीभदनबिल्ववचामधुकशतपुष्पाशठीकुष्ठपुष्करमूलद्वीपिदेवदारुभिः श्लक्ष्णपिष्टैर्द्विगुणपयस्तैलं सिद्धमर्शोगुदभ्रंशशूलवंक्षणानाहगुदशोफोत्थानबाहुल्यप्रवाहिकापिच्छास्रावोरुकटीपृष्ठदौर्बल्यवैवर्ण्यमूत्रकृच्छ्रनिष्पूडनं वातमूत्रशकृत्पित्तश्लेष्मानुलोमकरं च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.10.215",
  "kind": "metre",
  "line": "इत्यर्शश्चिकित्सितं नाम दशमोऽध्यायः ॥",
  "before": "सन्नेऽनले संति न संति दीप्ते रक्षेद्तस्तेषु विशेषतोऽग्मिमिति ॥",
  "after": "अथातोऽतिसारचिकित्सितं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.11.1",
  "kind": "metre",
  "line": "अथातोऽतिसारचिकित्सितं व्याख्यास्यामः ॥",
  "before": "इत्यर्शश्चिकित्सितं नाम दशमोऽध्यायः ॥",
  "after": "प्रायेण ह्यतिसारोऽग्निमुपहृत्य प्रागामाधिष्ठानो भवति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.11.32",
  "kind": "metre",
  "line": "चित्रकशुंगबेरपूतीकरंजबिल्वाजमोदैर्वा ॥",
  "before": "समेन वा तिलबालबिल्वयोः कल्केन दधिसरस्नेहयुक्तं खलकं ॥",
  "after": "तकं दाडिमतैलाजैसैंधवोपेतमजितार्व्यं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.11.51",
  "kind": "metre",
  "line": "गुदं चाभ्यंगपूर्व स्वेदेन मृदुभूतं प्रवेशयेत् ॥",
  "before": "मरिचपंचकोलकाजाजीधनिकाबिडदाडिभगर्भं वा पूर्ववदम्लमनुवासयेद्धा दशमूलसिद्धेन स्नेहेन पिप्पल्यादिना वा ॥",
  "after": "सच्छिद्रेण चास्य चर्मणा गोष्फणाबंधं कुर्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.11.66",
  "kind": "metre",
  "line": "शर्करापद्मकेसरमुस्तपयस्याचंदनानि वा ॥",
  "before": "मधुकशृंगेरदीर्घवृंतत्वचो वा मधुयुक्ताः ॥",
  "after": "शाल्मलीवृंतकृतं वा शीतकषायं मधुरोपेतं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.11.67",
  "kind": "metre",
  "line": "शाल्मलीवृंतकृतं वा शीतकषायं मधुरोपेतं ॥",
  "before": "शर्करापद्मकेसरमुस्तपयस्याचंदनानि वा ॥",
  "after": "मधुकप्रियंगुकुटुंगत्वग्दाडिमांंकुरकल्केन वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.11.72",
  "kind": "metre",
  "line": "क्षीरं वा बृहतीबलांशुमतीकच्छुरामूलसिद्धं ॥",
  "before": "शूलाार्तस्तु रूक्षकोष्ठो घृतं सक्षारं पिबेत् ॥",
  "after": "मधुककटुंगाजमोदशर्करावच्चूर्णितं सतैलक्षौद्रं क्षीरमेव वा धारोष्णं बलवान्बिबद्धमलो विरेकार्थं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.11.76",
  "kind": "metre",
  "line": "ततो निःसृते शकृति पुराणेऽतिसारः शांतिमेति ॥",
  "before": "एवमेव च त्रायमाणाशृतं ॥",
  "after": "स्रुतदोषस्य संसर्जनकाले शूलं चेदनुवर्त्तते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.11.111",
  "kind": "metre",
  "line": "पटोलादीनामेव च कल्केन सघृतेन प्रदिह्यात् ॥",
  "before": "शतधौतादिघृतैश्च पिच्चूनभ्यंगार्थं दद्यात् ॥",
  "after": "तच्चूर्णैर्धातकीरोध्रमाषचूर्णैन च पायुद्दारमवचूर्णयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.11.133",
  "kind": "metre",
  "line": "यवानीपिप्पलीमूलतुर्जातकनागैः ॥",
  "before": "सलवणमारुतघ्नगणसाधिततैलमलं घृतमपि वा प्रवाहणकृतां विजयेत रुजं ॥",
  "after": "मरिचाग्निजलाजाजीधान्यसौवर्चलैः समैः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "04.12.47",
  "kind": "metre",
  "line": "एषोऽर्द्धमासस्थितो मूलासबोऽयं समानः पूर्वेण ॥",
  "before": "दशमूलवीरार्द्रिात्रफलाजीवकर्षभकाणां पृथक्पंचपलान् भागानपां वहे पक्त्वा पादशेषे रसे शीतीभूते गुडतुलाद्वयं दद्यादर्द्धकुडुबं च माक्षिकात्तत्प्रमाणांश्च चूर्णितान्मुस्तप्रियंगुमंजिष्ठामधुकविडंगप्लवशावररोधान् ॥",
  "after": "महावृक्षकांडचतुष्पलं द्विगुणार्ककांडंलवणत्रयत्रिपलं पक्ववार्ताककुंडवं चित्रकपलद्वयं चांतर्धूमं दग्ध्वा वार्ताकरसेन गुलिकाः कुर्यात्। ता भोजनोत्तरं भक्षिता ग्रहणीदुर्नामविसृचिकालसककासश्वासपीनसप्लीहपांडुश्वयथुमेहारोचकगुल्महराः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.12.113",
  "kind": "metre",
  "line": "इति ग्रहणीदोषचिकित्सितं नाम द्वादशोऽध्यायः ॥",
  "before": "एष सारश्चिकित्साया यदग्नेः परिरक्षणं ॥",
  "after": "अथातो मूत्राघातचिकित्सितं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "04.13.10",
  "kind": "metre",
  "line": "मधुकदार्बीकरुबीजानि वा तंडुलघावनेन ॥",
  "before": "त्रपुसकुसुंभैर्वारुबीजयष्टुकुंकुम कल्कं सर्वमूत्राघातघ्नं ॥",
  "after": "समाक्षिकं वा दार्बीमामलकरसेन ॥",
  "note": "18 aksharas"
 }
]