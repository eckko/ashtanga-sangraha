[
 {
  "id": "01.13.35",
  "kind": "metre",
  "line": "अरुष्करश्चित्रकमूलं चशुष्कार्शःप्रशमनानां ॥",
  "before": "मृद्घृष्टलोष्टप्रसादश्छर्दितृष्णाातियोगप्रशमनानां ॥",
  "after": "कुटजो रक्तार्शःप्रशमनानां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.49",
  "kind": "metre",
  "line": "गंधप्रियंगुः शोणितपित्तातिवेगप्रशमनानां ॥",
  "before": "काश्मर्यफलं रक्तसंग्रहणीयरक्तपित्तप्रशमनानां ॥",
  "after": "पृश्निपर्णी रक्तसंग्रहणीयदीपनीयपाचनीयवातहरवृष्याणां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.52",
  "kind": "metre",
  "line": "बला संग्रहणीयबल्यवातहराणां ॥",
  "before": "शालिपर्णी वृष्यसर्वदोषहराणां ॥",
  "after": "पिप्पलीमूलं पाचनीयदीपनीयानाहहराणां ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.13.53",
  "kind": "metre",
  "line": "पिप्पलीमूलं पाचनीयदीपनीयानाहहराणां ॥",
  "before": "बला संग्रहणीयबल्यवातहराणां ॥",
  "after": "चित्रकमूलं दीपनीयपाचनीयगुदशोफशूलहराणां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.58",
  "kind": "metre",
  "line": "एरंडतैलाभ्यासो वर्ध्मगुल्मानिलशूलहराणां ॥",
  "before": "रक्तावसेको विद्रधिविसर्पपिटिकागंडमालापहराणां ॥",
  "after": "लशुनो गुल्मानिलहराणां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.81",
  "kind": "metre",
  "line": "समघृतसक्तुप्राशाभ्यासोवृष्योदावर्त्तहराणां ॥",
  "before": "क्षीरघृताभ्यासो रसायनानां ॥",
  "after": "संकल्पो नक्ररेतश्च वृष्याणां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.124",
  "kind": "metre",
  "line": "अभिरामस्तंभशीतशुलोद्वेष्टकप्रशमनानां ॥",
  "before": "एकरसाभ्यासो दौर्बल्यारोचकान्यतमदोषप्रकोपकरोणां ॥",
  "after": "गर्भशल्यमाहार्याणां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.129",
  "kind": "metre",
  "line": "गर्भिणी तीक्ष्णौषधव्यवायव्यायामवर्जनीयानां ॥",
  "before": "वृद्धो याप्यानां ॥",
  "after": "सौमनस्यं गर्भधारणानां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.13.164",
  "kind": "metre",
  "line": "॥ इत्यग्र्यसंग्रहो नाम त्रयोदशोऽध्यायः ॥",
  "before": "अल्पमेतद्विजानीयाद्विताहितविनिश्चिये ॥",
  "after": "अथातः शोधनादिगणसंग्रहमध्यायं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.14.25",
  "kind": "metre",
  "line": "नालीसतमालतर्कारीहरितकवर्गपत्राणि ॥",
  "before": "अपामार्गविडंगमरिचपिप्पलीशिरीषबिल्वाजाज्यजमोदवार्ताकपृथ्वीकैलाहरेणुफलानि ॥",
  "after": "सर्षपफलपत्राणि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.14.35",
  "kind": "metre",
  "line": "तमालशालतालमधुकदार्बीसाराः ॥",
  "before": "अगुरुसुरदारुसरलसल्लकीजिगिण्यसनरसांजनहिंगुलाक्षानियौंसः ॥",
  "after": "तेजस्विनीमेषश्रृंगीत्वरांगेगुदीबृहतीद्वयत्वचः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.15.1",
  "kind": "metre",
  "line": "अथातो महाकषायसंग्रहमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति शोधनादिगणसंग्रहो नामचतुर्दशोऽध्यायः ॥",
  "after": "आनंत्यादौषधानामामयानां चानंता एव कषायाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.6",
  "kind": "metre",
  "line": "यथोक्तानुसरणमेव तु श्रेयो मंदबुद्धेरिति ॥",
  "before": "शक्यं हि बुद्धिमद्भिः स्वादुशीतस्निग्धादीन् जीवंत्यादिषु साधारणान् गुणानालोच्य क्षीरेक्षुद्राक्षाऽक्षोडविदारीकंदादिष्वपि तद्गुणेषु जीवनीयादित्वमवधारयितुं ॥",
  "after": "व्यस्ताश्च ते चत्वारिशतानि पंचाशदधिकानि तद्भिधानान्येव ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.18",
  "kind": "metre",
  "line": "क्षीरिणिराजक्षबके क्षारद्वाजी च बंहणीयो ऽयं ॥",
  "before": "वाट्याबला पयस्या काकोल्याविक्षुवाजिगंधे च ॥",
  "after": "हैमवती चिरबिल्वं मुस्ता कुष्ठं बघाहरिद्रे च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.19",
  "kind": "metre",
  "line": "हैमवती चिरबिल्वं मुस्ता कुष्ठं बघाहरिद्रे च ॥",
  "before": "क्षीरिणिराजक्षबके क्षारद्वाजी च बंहणीयो ऽयं ॥",
  "after": "चित्रककटुकाऽतिविषा वर्गोऽयं लेखनीयाख्यः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.28",
  "kind": "metre",
  "line": "इति बल्योदशकोऽयं हयगंधा रोहिणी ऋषभः ॥",
  "before": "ऐंद्रयतिर सापयस्या ऋष्यप्रोक्ता स्थिराबलाऽतिबलाः ॥",
  "after": "चंदनतुंगपयस्यासितालतामधुकपद्मकोशीरं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.32",
  "kind": "metre",
  "line": "कैं डर्यमधुककृष्णाः सविदार्यः कंठजननानि ॥",
  "before": "हंसपदीबृहतीद्वयमृद्धीकासारिवेक्षुमूलाणि ॥",
  "after": "वृक्षाम्लबदरदाडिमकुवला म्राम्रातलिकुचकरमर्द्द ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.52",
  "kind": "metre",
  "line": "शुक्रजननो गणोऽयं सहजटिला शूर्पपर्णीभिः ॥",
  "before": "मेदाकाकोलीद्वयवृक्षरुहाजीवकर्षभकुलिंगाः ॥",
  "after": "कुष्ठैलवालुकट्फलकांढेक्ष्विक्ष्वन्धिफेनकोशीरैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.53",
  "kind": "metre",
  "line": "कुष्ठैलवालुकट्फलकांढेक्ष्विक्ष्वन्धिफेनकोशीरैः ॥",
  "before": "शुक्रजननो गणोऽयं सहजटिला शूर्पपर्णीभिः ॥",
  "after": "वसुकेक्षुरकैः शुक्रं शुत्ष्येत्सकदंबनिर्यासैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.79",
  "kind": "metre",
  "line": "द्राक्षापीलुपरूषकमंजिष्ठासारिवाऽमृतापाठाः ॥",
  "before": "पुष्करमूलैलाऽगुरु वर्गोऽयं श्वासशमनाय ॥",
  "after": "त्रिफला चेति गणोऽगं ज्वरस्य शमनाय निर्दिष्टः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.80",
  "kind": "metre",
  "line": "त्रिफला चेति गणोऽगं ज्वरस्य शमनाय निर्दिष्टः ॥",
  "before": "द्राक्षापीलुपरूषकमंजिष्ठासारिवाऽमृतापाठाः ॥",
  "after": "दाडिमफल्गुपरूषकपियालयवषष्टिकेक्षुबदराणि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.83",
  "kind": "metre",
  "line": "पद्मक्लाजोशीरं मधुकोत्पलसारिवासितोदीच्यं ॥",
  "before": "श्रमनाशनानि विद्याद्वाक्षाखर्जूरसहितानि ॥",
  "after": "काश्मर्यफलं चंदनमेष गणो दाहहा प्रोक्तः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.88",
  "kind": "metre",
  "line": "अरिमेदवाजिकर्णौ केकुभश्चोदर्द्दशमनानि ॥",
  "before": "तिंदुकपियालबीजकसतच्छदखदिरकदरबदराणि ॥",
  "after": "काकोल्येलासेव्यं निदिग्धिके शालिपृश्निपर्ण्यौ च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.90",
  "kind": "metre",
  "line": "घ्नंत्यंगमर्द्दमचिराच्चंदनमधुकोरुबूकंच ॥",
  "before": "काकोल्येलासेव्यं निदिग्धिके शालिपृश्निपर्ण्यौ च ॥",
  "after": "दीप्यकमरिचाजाजीगंडीरं साजगंधमथ शूलं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.92",
  "kind": "metre",
  "line": "शमयतिसपंचकोलं शोफं दशमूलमोंढ्यं च ॥",
  "before": "दीप्यकमरिचाजाजीगंडीरं साजगंधमथ शूलं ॥",
  "after": "मधुमधुकलाजगैरिकफलिनीमोचरसमृत्कपालानि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.94",
  "kind": "metre",
  "line": "संस्थापयंति रुधिरं रुधिरं च सशर्करंरोध्रं ॥",
  "before": "मधुमधुकलाजगैरिकफलिनीमोचरसमृत्कपालानि ॥",
  "after": "शैलैलवालुकट्फलमोचरसाशोकपद्मकशिरीषं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.15.105",
  "kind": "metre",
  "line": "॥ इति महाकषायसंग्रहो नामपंचदशोऽध्यायः ॥",
  "before": "योगारोगानुरवशात्कल्पयेत्तान्यथायथं ॥",
  "after": "अथातो विविधगणसंग्रहमध्यायं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.16.1",
  "kind": "metre",
  "line": "अथातो विविधगणसंग्रहमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति महाकषायसंग्रहो नामपंचदशोऽध्यायः ॥",
  "after": "विदारिपंचांगुलवृश्चिकालीवृश्चीवदेवांह्वय शूर्पपर्ण्यः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.16.48",
  "kind": "metre",
  "line": "मुष्ककध्रुवराहीपिप्पलीपलाशधवशिंशिफाः ॥",
  "before": "प्रतिश्यायारुचिश्वासकासघ्नो व्रणशोधनः ॥",
  "after": "गुल्ममेहाश्मरीपांडुमेदोर्शः कफशुक्रजित् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.17.17",
  "kind": "metre",
  "line": "तत्राग्निमारुतात्मकं प्रायेणोर्ध्वभागं ॥",
  "before": "इत्थंच नानौषधभूतं जगति किंचिद्द्रव्यमस्ति विविधार्थप्रयोगवशात् ॥",
  "after": "तयोर्हि लाघवादूर्ध्वगतित्वाच्चाग्नेः प्लवनत्वाच्च मारुतस्य ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.17.62",
  "kind": "metre",
  "line": "अम्लंकांजिकं कफं जयति रूक्षोष्णत्वात् ॥",
  "before": "आनूपौदकपिशितं शीतमपि पित्तं करोत्युष्णवीर्यत्वात्तथा तैलं कटुविपाकतया च विपाकतएव बद्धविण्मूत्रं ॥",
  "after": "कपित्थं तु रौक्ष्यात् पित्तं चशीतवीर्यत्वात् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.17.63",
  "kind": "metre",
  "line": "कपित्थं तु रौक्ष्यात् पित्तं चशीतवीर्यत्वात् ॥",
  "before": "अम्लंकांजिकं कफं जयति रूक्षोष्णत्वात् ॥",
  "after": "आमलकं पित्तं शीतवीर्यत्वात् स्वादुपाकतया चकफं रौक्ष्याल्लाघवाच्च शैत्यरौक्ष्यलाघवैस्तु न वातं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.18.4",
  "kind": "metre",
  "line": "तत्रभूजलयोर्बाहुल्यान्मधुरो रसः ॥",
  "before": "स षडृतुकत्वात्कालस्य महाभूतगुणानामूनातिरेकविशेषेणसंसृष्टो विषमं विदग्धः षोढा पृथग्विपरिणमते मधुरादिभेदेन ॥",
  "after": "श्रूतेजसोरम्लः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.18.19",
  "kind": "metre",
  "line": "छर्युदर्दमूर्द्देरुकासपीनसकृमीन् ॥",
  "before": "श्वासप्रमेहगल रोगविसंज्ञताऽऽस्यमाधुर्यलोचनगदार्बुदगंडमालाः ॥",
  "after": "श्लीपदज्वरोदरष्टीवनानि चावहेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.18.20",
  "kind": "metre",
  "line": "श्लीपदज्वरोदरष्टीवनानि चावहेत् ॥",
  "before": "छर्युदर्दमूर्द्देरुकासपीनसकृमीन् ॥",
  "after": "अम्लोऽनिलनिबर्हणोऽनुलोमनः कोष्ठविदाही रक्तपित्तकृदुष्णवीर्यः शीतस्पर्शो बोधयतींद्रियाणि रोचनः पाचनो दीपनो बृंहणस्तर्पणः प्रीणनःक्लेदनो व्यवायी लघुः स्निग्धो हृद्यश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.18.29",
  "kind": "metre",
  "line": "खरविशदरौक्ष्यभावैः सोऽतिसमासेवितः कुर्यात् ॥",
  "before": "धातुबलक्षयमूर्च्छाग्लानिभ्रमातदोगपरुषत्वं ॥",
  "after": "कटुकोऽलसकश्वयथूर्दद्रुस्थौल्याभिष्यंदकृमिवक्त्ररोगविषकुष्ठकंडू प्रशमनोव्रणावसादनः स्नेहक्लेदशोषणो रोचनः पाचनो दीपनो लेखनः शोधनः शोषयत्यन्नं स्फुटयतींद्रियाणि भिनत्ति शोणितसंघातं चिनत्तिबंधान् विवृणोति स्रोतांसि क्षपयति श्लेष्माणं लघुरूक्षतीक्ष्णोष्णश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.18.56",
  "kind": "metre",
  "line": "तयोराद्यो लवणाम्लयोर्योनिरितरश्चेतरयोः ॥",
  "before": "अत एव चानूपसाधरणो जांगलसाधारणश्चेति विकल्पः ॥",
  "after": "संयोगास्तेषां सप्तपंचाशद्भवंतीति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.18.57",
  "kind": "metre",
  "line": "संयोगास्तेषां सप्तपंचाशद्भवंतीति ॥",
  "before": "तयोराद्यो लवणाम्लयोर्योनिरितरश्चेतरयोः ॥",
  "after": "भवंति चात्र ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.18.72",
  "kind": "metre",
  "line": "॥ इति रसभेदीयो नामाष्टादशोऽध्यायः ॥",
  "before": "संभवंति गणनां समतीता दोषभेषजवशादुपयोज्याः ॥",
  "after": "अथातो दोषादिविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.19.15",
  "kind": "metre",
  "line": "क्लेदत्वक्स्रेहरोमधारणैः स्वेद इति ॥",
  "before": "अम्बुक्लेदनिर्वाहणेन मूत्रं ॥",
  "after": "कार्श्यकार्ष्ण्यगात्रकम्पस्फुरणोष्णकामितासंज्ञानिद्रानाश बलेंद्रियोपघातास्थिशूलमज्जाशोषमलसंगाध्मानाटोपमोहदैन्यभयशोकप्रलापादिभिर्वृद्धो वायुः पीडयति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.19.26",
  "kind": "metre",
  "line": "आधिक्यकुक्षिशूलाटोपगौरवैः शकृत् ॥",
  "before": "अतिस्त्रीकामताशुक्राश्मरीसंभवाभ्यां शुक्रं ॥",
  "after": "आधिक्यबस्तितोदाध्मानैर्मूत्रं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.20.14",
  "kind": "metre",
  "line": "मलिनीकरणादाहारमलत्वान्मलाः ॥",
  "before": "धारणाद्द्वातवः ॥",
  "after": "दूषणस्वभावत्वादोषाइति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.20.34",
  "kind": "metre",
  "line": "रसनस्थः सम्यग्रसबोधनाद्बोधकः ॥",
  "before": "आमाशयस्थितोऽन्नसंघातस्य क्लेदनात्क्लेदकः ॥",
  "after": "शिरस्थश्चक्षुरादींद्रियतर्पणात्तर्पकः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.20.39",
  "kind": "metre",
  "line": "समासतश्चवृद्धिक्षयलक्षणमुक्तं पूर्वाध्याये ॥",
  "before": "तेषां वृद्धिहेतुर्वक्ष्यते निदानेषु ॥",
  "after": "वृद्धिर्हि द्वेधा चयकोपभेदेन ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.20.75",
  "kind": "metre",
  "line": "स्तैमित्यं तु प्रमीलक इत्यन्यैः पठितं ॥",
  "before": "निद्रातंस्येव विषयाग्रहणंतंद्रा ॥",
  "after": "उपलेप इवोपलेपः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.20.83",
  "kind": "metre",
  "line": "सरागकंडूः शोफः स्यादुदर्द्दः स कफोद्भव इति ॥",
  "before": "शीतपानीयसंस्पर्शाच्छीतकाले विशेषतः ॥",
  "after": "महाविकारास्तु यथास्वमेवोपदेक्ष्यंते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.20.91",
  "kind": "metre",
  "line": "तत्रात्मलिंगान्यायुष्कामीये निर्दिष्टानि ॥",
  "before": "तथा तत्कर्माप्युपक्रमश्च ॥",
  "after": "कर्माणि तु वायोः संस्रव्याससंगासभेदतोदहर्षतर्षवर्त्तमर्दकंठव्यथवेष्टभंगशूलशोषस्वापपारुष्यसौषिर्यसंकोचस्पंदनानि कषायरसत्वं श्यावारुणवर्णता च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.22.16",
  "kind": "metre",
  "line": "तस्मात् दृष्टहेतवः प्रत्युत्पन्नकर्मजाः ॥",
  "before": "ततु पुनर्दैवाख्यमुक्तं च नियतानियतभेदेन प्राक् ॥",
  "after": "विपरीता दैवजन्मानः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.22.18",
  "kind": "metre",
  "line": "अल्पनिदाना महारुजश्चोभयात्मकाः ॥",
  "before": "विपरीता दैवजन्मानः ॥",
  "after": "तत्र यथास्वं प्रतिपक्षशीलनात् पूर्वेषां रोगाणामुपशमः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.22.26",
  "kind": "metre",
  "line": "एवमेते व्याधयो द्विविधाः संतस्त्रिविधा जायंते ॥",
  "before": "यदिस्वयं कृतादेव कर्मणः कार्यनिर्वृत्तिः स्यात् न दृष्टं पुरुषांतरकृतात्किमिति विद्वानपि पराचरितयोरुपकारापकारयोः सुखदुःखानुरोधात्तोषरोषौ प्रतिकर्त्तव्यचिंतां वा प्रतिपद्यते ॥",
  "after": "ततश्च दोषविशेषतो भूयः सप्तविधाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.22.41",
  "kind": "metre",
  "line": "तेषु व्यथा पूर्वमुपजायते ततो दोषवैषम्यं ॥",
  "before": "बाह्यहेतुजास्त्वागंतवः ॥",
  "after": "दोषवैषम्येणैव च बहुरूपा रुगनुबध्यते प्रवर्द्धते च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.22.43",
  "kind": "metre",
  "line": "एवंच कृत्वा न दोषव्यतिरेकेण रोगानुबंधः ॥",
  "before": "दोषवैषम्येणैव च बहुरूपा रुगनुबध्यते प्रवर्द्धते च ॥",
  "after": "केवलंपौर्वापर्ये विशेषः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.22.79",
  "kind": "metre",
  "line": "मध्यो मूर्द्धहृदयबस्त्यादीनि मर्म्माण्यस्थिसंधयः ॥",
  "before": "तदाश्रया गंडपिटिकालज्यपचीचर्मकीलांबुदाधिमांसमषव्यंगादयो बहिर्भागाश्च शोथार्शोगुल्मविसर्पविद्रध्यदयः ॥",
  "after": "तत्रोपनिबद्धाश्च स्नायुशिराकंडरादयः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.22.91",
  "kind": "metre",
  "line": "प्रधानप्रशमे प्रशमो भवति तेषां ॥",
  "before": "तान् यथापथमेव वक्ष्यमाणानुपलक्षयेत् ॥",
  "after": "अनुपशाम्यतो वा पश्चात्तानुपक्रमेत् त्वरितं वा बलवंतमुपद्रवं प्रधानावरोधेन ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.22.100",
  "kind": "metre",
  "line": "अर्शासिगुल्मोदरातिसारग्रहणीनां ॥",
  "before": "तच्छूथ्योः ॥",
  "after": "प्रतिश्यायः कासज्वरयोः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.22.104",
  "kind": "metre",
  "line": "एकश्चापचारो निमित्तमेकस्य व्याधेः ॥",
  "before": "क्षयः शोषस्य ॥",
  "after": "बहूनां चतथा बहवः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.22.109",
  "kind": "metre",
  "line": "तस्मात्तानवहितः सम्यगागमादिभिः परीक्षेत ॥",
  "before": "तथा स एवान्यस्य प्रकोपे ॥",
  "after": "तत्रागंतो रोगमेवमेवंप्रकोपनमेवंयोनिमेवमात्मानमेवमधिष्ठानमेवंवेदनमेवंरूपशब्दगंधरसस्पर्शमेवंपूर्वरूपमेवमुपद्रवमेवंवृद्धिस्थानक्षयान्वितमेवमुदर्कमेवंनामानं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.22.111",
  "kind": "metre",
  "line": "तस्मिन्नियं प्रतीकारस्य प्रवृत्तिरन्यथा निवृत्तिः ॥",
  "before": "तत्रागंतो रोगमेवमेवंप्रकोपनमेवंयोनिमेवमात्मानमेवमधिष्ठानमेवंवेदनमेवंरूपशब्दगंधरसस्पर्शमेवंपूर्वरूपमेवमुपद्रवमेवंवृद्धिस्थानक्षयान्वितमेवमुदर्कमेवंनामानं ॥",
  "after": "प्रत्यक्षतस्त्वातुरस्य यथास्वमिंद्रियैर्वर्णसंस्थानप्रमाणोपचयच्छायाविण्मूत्रछर्दिताधिक्यमंत्रकूजनमंगुल्यादिसंधिस्फुटनं देहशक्रुद्व्रणादिगंधं सुप्तशीतोष्णस्तंभसंस्यंदश्लक्ष्णखरस्पर्शं च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "01.22.133",
  "kind": "metre",
  "line": "॥ इति रोगभेदीयो नाम द्वाविंशोऽध्यायः ॥",
  "before": "तत्रानुबंधंप्रकृतिं च सम्यक् ज्ञात्वा ततः कर्म समारभेत ॥",
  "after": "अथातो भेषजावचारणीयमध्यायं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.23.1",
  "kind": "metre",
  "line": "अथातो भेषजावचारणीयमध्यायं व्याख्यास्यामः ॥",
  "before": "॥ इति रोगभेदीयो नाम द्वाविंशोऽध्यायः ॥",
  "after": "भेषजम्वचारयन् प्रागेव तावदेवमातुरं परीक्षेत ॥",
  "note": "18 aksharas"
 }
]