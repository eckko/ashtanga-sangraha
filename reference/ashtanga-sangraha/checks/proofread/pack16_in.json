[
 {
  "id": "06.27.1",
  "kind": "metre",
  "line": "अथातः शिरोरोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति मुखरोगप्रतिषेधो नाम षड्विंशोऽध्यायः ॥",
  "after": "धूमातपतुषारांबुक्रीडा तिस्वप्नजागरैः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.27.65",
  "kind": "metre",
  "line": "इति शिरोरोगविज्ञानीयो नाम सप्तविंशोऽध्यायः ॥",
  "before": "शरीरपरिणामोत्थान्यपेक्षंते रसायनं ॥",
  "after": "अथातः शिरोरोगप्रतिषेधं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.28.8",
  "kind": "metre",
  "line": "तत्सिद्धैश्च पायसैः पिंडस्वेदं लेपं वा ॥",
  "before": "ततः प्रत्यूषे दशमूलसिद्धेन पयसा कवोष्णेन परिषेकं कुर्यात् ॥",
  "after": "कूर्ममहिषवराहकुक्कुटशल्लकीनां वसा ससैंधवा नस्यं शिरःकर्णपूरणं च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.28.33",
  "kind": "metre",
  "line": "उत्पलादिवर्गशृतं क्षीरमास्थापनं ॥",
  "before": "क्षीरेक्षुजांगलरसखर्जूरद्राक्षाकसेरुकमृणालसिद्धः सर्पिर्मंडोऽनुवासनं ॥",
  "after": "शंखकं प्रत्याख्यायैवमेवोपचरेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.28.45",
  "kind": "metre",
  "line": "शिरोविरेचनद्रव्यैर्वा सूत्रस्थानोक्तैः प्रधमनं ॥",
  "before": "एभिरेव धूमवर्त्तिः ॥",
  "after": "तैरेव पक्कं तैलं प्रतिमर्शो वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.28.99",
  "kind": "metre",
  "line": "सलिलसेकमारोमोद्गमात् परिहरेत् ॥",
  "before": "खलतिविहितानि चाचरेत् ॥",
  "after": "खलताविंदुलुप्तोक्तः क्रमो यथादोषं च संशुद्धिः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.28.100",
  "kind": "metre",
  "line": "खलताविंदुलुप्तोक्तः क्रमो यथादोषं च संशुद्धिः ॥",
  "before": "सलिलसेकमारोमोद्गमात् परिहरेत् ॥",
  "after": "त्रिफलार्जुनसैंर्यकत्वक्पुष्पकृष्णपेंडीतकफलमूलोत्पलनीलीलोहचूर्ण कासीसजंबुमार्कवबीजमंजिष्ठामेषशृंगीखदिररजः सकर्दममर्दितोत्काणुतैलयुक्तमसनसारसंपुटे न्यस्तं कर्दमे मासं निखातस्थितमुद्धृतं सूचीकूर्चप्रच्छितायाः खलतेर्लेपः परं रोमसंजननं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.28.106",
  "kind": "metre",
  "line": "खलतिपलितयोश्च प्रयोगान् परस्परं विदध्यात् ॥",
  "before": "एवमेव मधुरवर्गकल्केन ॥",
  "after": "अकालपलितेषु वातादीनपेक्ष्य स्नेहस्वेदसंशोधनास्त्रविस्त्रावणानि कुर्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.28.116",
  "kind": "metre",
  "line": "एवमलिकुलनीलाः केशाः शिरो विभूषयंतीति ॥",
  "before": "तृतीयेऽहनि प्रक्षाल्यैवमेव कुर्यात् ॥",
  "after": "भवंति चात्र ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.29.6",
  "kind": "metre",
  "line": "सोऽपि पुनर्वातादि भिरधिष्ठितो निजतां लभते ॥",
  "before": "आगंतुः शस्त्रानुशस्त्रोपलकुट्टननखदशनविषाणविषारुष्करादिनिमित्तः ॥",
  "after": "पुनश्च द्वेधा दुष्टः शुद्धश्च ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.29.53",
  "kind": "metre",
  "line": "पीतासितमूत्रपुरीषवातवाहिनश्च कोष्ठस्थाः ॥",
  "before": "असाध्याः पुनर्मासपिंडवदुद्गताःप्रसेकिनोऽन्तःपूया वेदनावंतश्चापानवदुद्वृत्तोष्ठाः कठिना गोशृङ्गवत्प्ररोहा दुष्टशोणितास्राविणस्तनुपिच्छिलास्राविणो वा मध्योन्नताः समवसन्नसुषिरपर्यंताः शणतूलवत्स्नायुजालवंतो दुर्दशा मेदोमज्जवसामस्तुलुङ्गस्राविणश्च दोषसमुत्थाः ॥",
  "after": "रक्ताशयजाश्च क्षारोदकसमास्रावाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.29.54",
  "kind": "metre",
  "line": "रक्ताशयजाश्च क्षारोदकसमास्रावाः ॥",
  "before": "पीतासितमूत्रपुरीषवातवाहिनश्च कोष्ठस्थाः ॥",
  "after": "तथा ऽऽमाशयजाः कलायांभोनिभास्रावाः पक्वाशयजाश्च पुलाकोदकमिवनिःस्रवन्तः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.29.57",
  "kind": "metre",
  "line": "सशब्दवातवाहिनश्च शिरःकंठस्थाः ॥",
  "before": "क्षीणमांसानां च सर्वतो गतयस्त्वणुमुखामांसबुद्बुदवंतः ॥",
  "after": "विसर्पज्वरपिपासारोचकाविपाककासश्वासातीसारछर्दियुक्ता भिन्ने च शिरःकपाले मस्तुलुङ्गदर्शनं त्रिदोषलिङ्गप्रादुर्भावो वा स्यादिति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.30.12",
  "kind": "metre",
  "line": "शुष्कं हि दाहोषारागश्यावत्वशूलानि वर्द्धयति ॥",
  "before": "न तु शुष्यदुपेक्षितव्यमन्यत्र पीडयितव्यात् ॥",
  "after": "स तु शीतस्तनुर्मुहुर्मुहुश्च प्रयुज्यते ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.30.14",
  "kind": "metre",
  "line": "स प्रदेहो रक्तपित्तत्वचां प्रसादकृत् ॥",
  "before": "स तु शीतस्तनुर्मुहुर्मुहुश्च प्रयुज्यते ॥",
  "after": "प्रलेपस्तृष्णः शीतो वा बहलश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.30.23",
  "kind": "metre",
  "line": "स एव च पुनरस्त्रातिप्रवृत्तौ संस्तंभनसंज्ञः ॥",
  "before": "स एव वातदुष्टे रक्ते प्रसादनः ॥",
  "after": "श्लेष्ममेदोभूयिष्ठे शीतैश्चाविदग्धे विष्टब्धे ग्रथिते वा रूक्षैर्विलयनः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.30.26",
  "kind": "metre",
  "line": "सूक्ष्मास्ये व्रणे रूक्षैः पिच्छिलैश्च पीडनः ॥",
  "before": "तैरेव च विदग्धे पाचनः ॥",
  "after": "अशुद्धे यथास्वमुपदिष्टैः शोधनः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.30.52",
  "kind": "metre",
  "line": "तथा सतिलो मुद्गपायस उपनाहः ॥",
  "before": "तद्वन्मधुकयवचूर्णतैलसर्पिर्भिः कोष्णस्तु लेपः ॥",
  "after": "दशमूलसिद्धेन सुखोष्णेनांभसा पयसा वा घृततैलाभ्यां वा परिषेकः शोफे व्रणे वा दाहशूलघ्नः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.30.54",
  "kind": "metre",
  "line": "स्थिराणां मंदवेदनानां शोफानां विम्लापनं कार्यं ॥",
  "before": "दशमूलसिद्धेन सुखोष्णेनांभसा पयसा वा घृततैलाभ्यां वा परिषेकः शोफे व्रणे वा दाहशूलघ्नः ॥",
  "after": "अभ्यज्य स्वेदयित्वा च वेणुनाड्या शनैः शनैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.30.57",
  "kind": "metre",
  "line": "तथाऽस्फोतपत्रमसूरकल्केनालेपः ॥",
  "before": "विम्लापनार्थं मृद्नीयात्तलेनांगुष्ठकेन वा ॥",
  "after": "सुसिद्धपिष्टैः सघृतमधुगोधूमयवमुद्द्रैर्वा लेपादाविलीयते ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.30.63",
  "kind": "metre",
  "line": "पाचनार्थं पाकवेदनाशास्त्रकर्मसहनार्थं च ॥",
  "before": "पाकाभिमुखे च शोफै यथेष्टमातुरं भोजयेत् ॥",
  "after": "पक्के तु यथोक्तेन विधिना शस्त्रमवचारयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.30.188",
  "kind": "metre",
  "line": "इति व्रणप्रतिषेधो नाम त्रिंशोऽध्यायः ॥",
  "before": "भुंजानो जांगलैर्मासैः शीघ्रं व्रणमपोहति ॥",
  "after": "अथातः सद्योव्रणविज्ञनप्रतिषेधं व्याख्यास्यामः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.31.1",
  "kind": "metre",
  "line": "अथातः सद्योव्रणविज्ञनप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति व्रणप्रतिषेधो नाम त्रिंशोऽध्यायः ॥",
  "after": "आगंतोर्व्रणस्य प्रागुपदिष्टः संभवः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.31.2",
  "kind": "metre",
  "line": "आगंतोर्व्रणस्य प्रागुपदिष्टः संभवः ॥",
  "before": "अथातः सद्योव्रणविज्ञनप्रतिषेधं व्याख्यास्यामः ॥",
  "after": "तत्र यथायथं प्रतीकारश्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.31.15",
  "kind": "metre",
  "line": "तत्र मांसमनुप्राप्तेन शल्येन विद्धं ॥",
  "before": "विद्धं त्वष्टविधं ॥",
  "after": "द्वितीयपार्श्वत्वचमुन्नम्योत्तुंडितं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.31.140",
  "kind": "metre",
  "line": "कार्यं वातास्रजित्सिमर्द्नाभ्यंगशोधनं ॥",
  "before": "गूढप्रहाराभिहते पतिते विषमोच्चकैः ॥",
  "after": "विश्लिष्टदेहं मथितं क्षीणं मर्माहतं हतं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.32.8",
  "kind": "metre",
  "line": "विश्लिष्टेऽल्पशोफो वेदनासातत्यं संधिविक्रिया च ॥",
  "before": "अथोत्पिष्टे स्वस्थानएव संधीषूभयतः शोफो वेदना विशेषतश्च रात्रौ भवति ॥",
  "after": "अवक्षिप्ते संधिविश्लेषस्तीव्रा च रूक् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.32.25",
  "kind": "metre",
  "line": "अण्णुवेददारिवेदनावच्च दारितं ॥",
  "before": "पृथुतां गंतमनल्पशोफं पिच्चितं ॥",
  "after": "स्पृश्यमानं शब्दवच्चूर्णितं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.32.135",
  "kind": "metre",
  "line": "विगत्ततुषानरजस्कान्संचूर्ण्य सुचूर्णितैर्युज्यात् ॥",
  "before": "पुनरपि पीतपयस्कांस्तान् पूर्ववदेवशोषितान्वाढं ॥",
  "after": "नलदवालकलोहितयष्टिका नखमि शिलुवकुष्ठबलात्रयैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.32.144",
  "kind": "metre",
  "line": "इति भंगविज्ञानप्रतिषेधो नाम द्वात्रिंशोऽध्यायः ॥",
  "before": "वातपित्तजनितानतिवीर्यान् व्यापिनोऽपि विविधैरुपयोगैरिति ॥",
  "after": "अथातो भगंदरविज्ञान प्रतिषेधं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.33.1",
  "kind": "metre",
  "line": "अथातो भगंदरविज्ञान प्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति भंगविज्ञानप्रतिषेधो नाम द्वात्रिंशोऽध्यायः ॥",
  "after": "हस्त्यश्वपृष्ठगमनकठिनोत्कटकासनैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.33.57",
  "kind": "metre",
  "line": "व्रणं चास्य मधुकतैलेनोष्णेन सिंचेत् ॥",
  "before": "स्विन्नं वचाकुष्ठहिंगुव्योषलवणपंचकाजमोदाः सर्पिर्मद्यकांजिककुलत्थयूषान्यतमेन पाययेत् ॥",
  "after": "गुदं च बलातैलादिभिर्वातवेदनाघ्नैः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.33.61",
  "kind": "metre",
  "line": "सकृदेव ह्यवदारणादसाध्यता याप्यता वा स्यात् ॥",
  "before": "एवमेव परिक्षेपिण्यपि क्रमादार्तं नाडीविहितेन क्षारसूत्रेण द्विशस्त्रिशो वाऽवदारयेत् ॥",
  "after": "अर्शोभगंदरे पूर्वमशांसि छिंद्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.35.1",
  "kind": "metre",
  "line": "अथातो ग्रंथ्यादिप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति ग्रंथ्यर्बुदश्लीपदापचीनाडीविज्ञानं नाम चतुस्त्रिंशोऽध्यायः ॥",
  "after": "सर्वेष्वेव पूर्वं ग्रंथिषु बृहतीद्वयपिप्पलीचित्रकसाधितेन पुराणसर्पिषा स्निग्धं वामयेत् विरेचयेच्च ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.35.13",
  "kind": "metre",
  "line": "विविधाश्च वातव्याधिविहिताः स्नेहस्वेदोपनाहाः ॥",
  "before": "अमृतानिम्बबीजभार्गीश्योनाक्तालपत्रीकृष्णगंधाऽगुरुभिः क्षीरपिष्टैः सुखोष्णैरालेपयेत् ॥",
  "after": "तथानुपशमे सिराव्यधः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.35.18",
  "kind": "metre",
  "line": "द्राक्षैक्षुरसयुक्तो हरीतकीविरेकः ॥",
  "before": "कुर्यात्पित्तजे रक्तजे च जलौकसो न्यग्रोधादिः प्रदेहपरिषेकयोः पद्मकादिः पाचने च ॥",
  "after": "पक्वे पाटिते च पित्तव्रणोक्तो विधिः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.35.23",
  "kind": "metre",
  "line": "भल्लातकसैंधवाजगंधासर्षपैर्वा ॥",
  "before": "तगरविडंगैलावालुकचव्यपलाशश्वेतचित्रकैर्वा ॥",
  "after": "एवमप्यपच्यमानममर्मस्थं विदार्य स्थितरक्तं निःशेषमग्निना दहेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.35.26",
  "kind": "metre",
  "line": "ततो निर्वापितं क्षारक्षौद्रगुडोत्तराैरालेपयेत् ॥",
  "before": "सशेषो हि पुनरापूर्यते ॥",
  "after": "संशुद्धं रोपयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.35.42",
  "kind": "metre",
  "line": "वातहरवर्गक्वाथपयोम्लसिद्धं त्रैवृत्तं पिबेत् ॥",
  "before": "बहुशश्चात्र शृंगेण रुधिरमवसेचयेत् ॥",
  "after": "पित्तोत्थे मृदून् स्वेदोपनाहान् कायविरेचनं च प्रयोजयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.35.56",
  "kind": "metre",
  "line": "करंजतैलं चाभ्यंजनार्थे च युंजीत ॥",
  "before": "ततो गृहधूमरोध्रमनःशिलाहरिद्रापत्तंगचूर्णैर्मधुसर्पिर्भिः प्रतिसारयेत् ॥",
  "after": "सर्वार्बुदानि च यदृच्छया पर्यागतानि सुपरिशोधितानि रोपयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.35.67",
  "kind": "metre",
  "line": "पैत्तिके मृदुरुपनाहो गुल्फस्य चाधः सिरामोक्षः ॥",
  "before": "एवमप्यशाम्यदग्निना दहेत् ॥",
  "after": "पित्तार्बुदोक्ताः स्नेहविरेकाः पित्तघ्नाश्च लेपाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.35.90",
  "kind": "metre",
  "line": "अपक्वांश्च गंडान्त्राकुलीसैंधवनागरैर्लेपयेत् ॥",
  "before": "विरेचनकं च धूमं पिबेत् ॥",
  "after": "गुंजाकरवीरार्कश्यामासिद्धार्थिकैजामूत्रयुक्तैर्दशकृत्वो विपकं तैलं लवणपंचकपिप्पलीमरिचचूर्णोपेतमभ्यंगात्सर्वावस्थमपच्यर्बुदनाडीदुष्टव्रणवल्मीकानपोहति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.35.96",
  "kind": "metre",
  "line": "सर्षपवृक्षादनीक्वाथैर्द्वणक्षालनं ॥",
  "before": "अमर्मजांश्च गंडानपक्वानेवो द्धृत्याग्निना क्षारेण वा प्रतिसारयेत् ॥",
  "after": "तिलकुंतलकक्षारपिष्टस्तिलकल्कः सुखोष्णो लेपः ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.35.104",
  "kind": "metre",
  "line": "एवमुभयपार्श्वजायां गंडमालायामुभयतः ॥",
  "before": "अनेनेतरपार्श्वजा व्याख्याता ॥",
  "after": "यवमुद्गप्रायं च गंडमालासु भोजनं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.36.1",
  "kind": "metre",
  "line": "अथातः क्षुद्ररोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति ग्रंथ्यर्बुदश्लीपदापचीनाडीप्रतिषेधो नाम पंचत्रिंशोऽध्यायः ॥",
  "after": "स्निग्धा सवर्णा ग्रंथिता नीरुजा मुद्गसन्निभा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.37.4",
  "kind": "metre",
  "line": "पक्वामजगल्लिकां व्रणवदुपाचरेत् ॥",
  "before": "यवक्षारशुक्तिसौराष्ट्रीकल्केश्च लेपयेत् ॥",
  "after": "यवप्रख्यादीन् पाषाणगर्दभांतान् स्वेदयित्वा सुरदारुकुष्ठमनःशिलालैर्लेपयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.37.19",
  "kind": "metre",
  "line": "अनुपशाम्यंतीं त्वभ्यज्य स्वेदयित्वा च विम्लापयेत् ॥",
  "before": "विदारिकां जलवासिनीभिः शोधयित्वा बिल्वमूलनागमृत्तिकावर्षाभूजकर्णपलाशकल्केन प्रलिंपेत् ॥",
  "after": "पक्कां शस्त्रेण विदार्य निंबपटोलविदारिकल्केन प्रच्छाद्य बध्नीयात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.37.22",
  "kind": "metre",
  "line": "शुद्धां मधुरकपायसंस्कृतेन तैलेन रोपयेत् ॥",
  "before": "क्षीरिवृक्षबदरखदिरकषायो व्रणप्रक्षालनं ॥",
  "after": "शर्कराबुर्दं मेदोर्बुदवदुपाचरेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.37.23",
  "kind": "metre",
  "line": "शर्कराबुर्दं मेदोर्बुदवदुपाचरेत् ॥",
  "before": "शुद्धां मधुरकपायसंस्कृतेन तैलेन रोपयेत् ॥",
  "after": "वल्मीकं हस्तपादस्य चोपरिष्ठान्मर्मणि वा जातं प्रवृत्तमतिबहुच्छिद्रावृतं सशोफं च वर्जयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.37.29",
  "kind": "metre",
  "line": "कदरं च शस्त्रेणोत्कृत्य स्नेहेन दहेत् ॥",
  "before": "सुशुद्धे व्रणे च भल्लातकमनःशिलैलाकालानुसार्थ्यगुरुचंदनैर्निबवैलं रोपणार्थं श्रपयेत् ॥",
  "after": "रुद्धगुदे निरुद्धमणिवच्चिकित्सा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.37.35",
  "kind": "metre",
  "line": "अवशिष्टं सर्जरसचूर्णेन पूरयेत् ॥",
  "before": "मधुरकषायसिद्धेन वा ॥",
  "after": "कुनखमपि प्रदुष्टमेवमेवोपक्रमेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.37.40",
  "kind": "metre",
  "line": "चर्मकीलं जतुमणिं च तद्वच्छस्त्रेणोत्कृत्य दहेत् ॥",
  "before": "तिलकालकान्मपकांश्च सूर्यकांतेनाग्निना दहेत् क्षारेण वा ॥",
  "after": "लांच्छनव्यंगनीलिकासु यथासन्नं सिरां विध्येत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.37.42",
  "kind": "metre",
  "line": "क्षीरिवृक्षकल्कैश्च क्षीरपिष्टैर्लेपयेत् ॥",
  "before": "लांच्छनव्यंगनीलिकासु यथासन्नं सिरां विध्येत् ॥",
  "after": "बलाऽतिबलामधुकहरिद्राभिर्वा मधुकागुरुपयस्याकालीयकैर्वा तरुणकपित्थतिंदुकरजनीभिर्वाऽम्लिकामूलेन वा शूकंरदंष्ट्रया वा मधुघृतयुक्तया ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.37.58",
  "kind": "metre",
  "line": "आलेपश्चास्य चंदनमधुककल्केन ॥",
  "before": "वमनविरेचने च पित्तवत्कुर्यात् ॥",
  "after": "घृतवसासर्जरस नीलोत्पलशंखवे तसकदलीमूलमूर्वामधुककल्केन वा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.37.63",
  "kind": "metre",
  "line": "इति क्षुद्ररोगप्रतिषेधो नाम सप्तत्रिंशोऽध्यायः ॥",
  "before": "कोठे कुष्ठचिकित्सितं चेक्षेत ॥",
  "after": "अथातो गुह्यरोगविज्ञानं व्याख्यास्यामः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.38.1",
  "kind": "metre",
  "line": "अथातो गुह्यरोगविज्ञानं व्याख्यास्यामः ॥",
  "before": "इति क्षुद्ररोगप्रतिषेधो नाम सप्तत्रिंशोऽध्यायः ॥",
  "after": "स्त्रीव्यवायनिवृत्तस्य सहसा भजतोऽथवा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.39.7",
  "kind": "metre",
  "line": "एवं सद्य एव रुक्शोफरागसंरंभा निवर्त्तंते ॥",
  "before": "यथायोगं च लेपसेकादीनविरतं विदध्यात् ॥",
  "after": "पकेषु तु शस्त्रमवचारयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.39.50",
  "kind": "metre",
  "line": "मृदितं कोष्णेन बलातैलेन सेचयेत् ॥",
  "before": "पुष्करिकासंव्यूढस्पर्शहानित्वक्पाकेषु पित्तविसर्पोक्तो विधिः ॥",
  "after": "मधुरद्रव्यकल्केः सुखोष्णैर्घृतसिक्तैरुपनाहयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.39.91",
  "kind": "metre",
  "line": "योनिस्रंसे च महायोनिप्रभृतिष्वेष एव विधिः ॥",
  "before": "उपावृत्तायामानूपमांसरसाः क्षीरं स्वेदो दशमूलत्रिवृताकाथकल्कसिद्धश्च स्नेहः पानानुवासनोत्तरबस्तिषु ॥",
  "after": "जातघ्नीरक्तयोनिरक्तक्षयासु कुटजकाश्मर्यक्वाथसिद्धं सर्पिरुत्तरबस्तौ दद्यात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.40.13",
  "kind": "metre",
  "line": "क्षीरं कुमुद्वतीदंतीस्नुह्यर्कजालिनीव्यालादीनां ॥",
  "before": "त्वक्सारनिर्यासाः करककरघाटककरंभमहाकरंभनाराचकादीनां ॥",
  "after": "धातवो हरितालफेनाश्मभस्मरक्तप्रभृतयः ॥",
  "note": "18 aksharas"
 }
]