[
 {
  "id": "06.40.14",
  "kind": "metre",
  "line": "धातवो हरितालफेनाश्मभस्मरक्तप्रभृतयः ॥",
  "before": "क्षीरं कुमुद्वतीदंतीस्नुह्यर्कजालिनीव्यालादीनां ॥",
  "after": "कंदजानि तु हालाहलकालकूटवत्सनाभशृंगीसर्पपवालककर्दमकवैराटकमुस्त कसाक्तुकक्रौंचक बलाहलकमहाविषपुंडरीकगालवमूलकमर्कटकर्कटककरवीरकेंद्रा युधसांकोचकलांग लकतीलप घकुशमुस्तकेंद्रमुष्ककरोहि पाज नाभकादीनि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.40.21",
  "kind": "metre",
  "line": "क्षीरविषैर्जिह्वागौरवं शकृद्भेदश्च ॥",
  "before": "निर्यासविषैः प्रसेकास्यदौर्गंध्यपारुष्यशिरोवेदनाः ॥",
  "after": "धातुविषैस्तालुदाहमूर्च्छा हृदयपीडा ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.40.25",
  "kind": "metre",
  "line": "इतरं तु प्रायः कालांतर प्राहरणं ॥",
  "before": "तद्ध्यतितीक्ष्णत्वादाशुकारितरं ॥",
  "after": "सर्वमपि चैतन्मूलमित्युच्यते मूलाश्रयत्वात्पत्रादीनां ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.40.377",
  "kind": "metre",
  "line": "पैत्तिकं संस्रंसनैः सेकप्रदेहैरभूरिशीतलैः ॥",
  "before": "कषायकटुतिक्तैश्च भोजनैः शमयेद्विषं ॥",
  "after": "कषायतिक्तमधुरैर्घृतयुक्तैश्च भोजनैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.40.403",
  "kind": "metre",
  "line": "बल्या सोमराज्या वा पचेत्पाटल्याऽथवा ॥",
  "before": "भोजने च प्रणिहितं हंति वाताशयाद्विषं ॥",
  "after": "घृतमंडसमं तैलमनुवासनिकं परं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.41.1",
  "kind": "metre",
  "line": "अथातः सर्पविषविज्ञानीयमध्यायं व्याख्यास्यामः ॥",
  "before": "इति विषप्रतिषेधो नाम चत्वारिंशोऽध्यायः ॥",
  "after": "दिव्यभौमविभागेन द्विविधाः पन्नगाः स्मृताः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.43.1",
  "kind": "metre",
  "line": "अथातः कीटविषविज्ञानप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति सर्पविषप्रतिषेधो नाम द्विचत्वारिंशोऽध्यायः ॥",
  "after": "सर्पाणामेव विण्मूत्रशुक्रांडशवकोथजाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.44.1",
  "kind": "metre",
  "line": "अथातो लूताविषविज्ञानप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति कीटविज्ञानप्रतिषेधो नाम त्रयश्चत्वारिंशोऽध्यायः ॥",
  "after": "विश्वामित्राय रुष्टस्य वसिष्ठस्य ललाटजाः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.45.1",
  "kind": "metre",
  "line": "अथातः प्रत्येकलूताविषप्रतिषेधं व्याख्यास्यामः ॥",
  "before": "इति लूताविषविज्ञानप्रतिषेधो नाम चतुश्चत्वारिंशोऽध्यायः ॥",
  "after": "आदर्शे पिटिका ताम्रा भवेत्कपिलया स्थिरा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.45.68",
  "kind": "metre",
  "line": "शस्तं शेल्वर्जुनआभ्रातात्तद्वकूलं सिंधुवारतः ॥",
  "before": "विसर्पश्चात्र ह्रीबेरचंदनोशीरपद्मकं ॥",
  "after": "अदंशे चित्रया रक्ता पिटिका विस्तृता स्थिरा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.48.9",
  "kind": "metre",
  "line": "गुणैरेभिर्विषविपर्यस्तैर्निहतस्ते परस्परं ॥",
  "before": "प्रायः पित्तगुणैर्युक्तं मध्यगामि च जंगमं ॥",
  "after": "युंज्यान्मूलविषं तस्माद्दष्टानां पानलेपयोः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.73",
  "kind": "metre",
  "line": "परं चोपयोज्येदिति समानं पूर्वेण ॥",
  "before": "तानि सुस्विन्नशीतानि चोद्धृत्य निष्कुलीकृतान्यापोथ्य पिप्पलीविडंगतंदुलानां पृथगाढकेनाध्यर्द्धेन शर्करायाः षड्द्विर्मधुघृततैलानां संयोज्य घृतकुंभे स्थापयेद्विशतिरात्रं ॥",
  "after": "ओमलकसहस्रं पिप्पलीसहस्रसंयुक्तं तरुणपलाशक्षारोदकेनाप्लाव्य शुचौ भांडे स्थापयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.49.112",
  "kind": "metre",
  "line": "एवं तानि लोहपत्राणि संवत्सराद्द्रवीभवंति ॥",
  "before": "मासि मासि चोद्धृत्यायसेन दंडेन घट्टयेत् ॥",
  "after": "ततश्चोत्तरकालमकृतवावमनविरेचनं वा स्निग्धतनुरेव केवलं समंततोऽंगुष्टपर्वमात्रमुखेनायसेन स्रुवेणायस एव भाजने तस्मात्कल्कीकृतात्स्रुचमेकं गृहीत्वा मधुघृताभ्यां पृथक् स्रुचेन संयोज्य प्राश्नीयात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.207",
  "kind": "metre",
  "line": "कुष्ठीकुष्ठमपोहति विशीर्णकर्णौष्ठनासमपि ॥",
  "before": "उपयुज्य योगमखिलं प्रतिदिनमेव द्विकालमभियुक्तः ॥",
  "after": "अथ भल्लातकान्यनुपहतान्यनामयान्यापूर्णरसप्रमाणवीर्याणि पक्वजांबवप्रकाशानि शुक्रेशुचौ वा मासे संगृह्य यवपल्ले माषपल्ले वा निधापयेत् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.216",
  "kind": "metre",
  "line": "ततः पंचपंच वर्द्धयेद्यावत्सप्ततिः ॥",
  "before": "यावत्पंच ॥",
  "after": "प्राप्य च सप्ततिमपकर्षयेत् ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.49.226",
  "kind": "metre",
  "line": "मन्सि मासि वर्षशतमायुषोऽपि वृद्धिः ॥",
  "before": "अनेनैव विधिना भल्लातकस्वरसं गृहीत्वा केवलमेव मासमेकं प्रयुंजीत त्रिगुणः कालइत्यादि समानं पूर्वेण ॥",
  "after": "एवं दशमासानुपयुज्य वर्षसहस्रमायुर्भवति ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.49.285",
  "kind": "metre",
  "line": "स्वरवर्णबलोत्साहं नवंवयो नष्टपलितं च ॥",
  "before": "त्वग्रोमकेशदशननखांस्तुमुक्त्वा पुनर्नवाँल्लभते ॥",
  "after": "पलानि दश बाकुच्या दशैव च फलत्रयात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.310",
  "kind": "metre",
  "line": "खदिरांभसा पिबेद्वा रविसेवी तया यवागूं वा ॥",
  "before": "भांति वृक्षा इव पुनः प्ररूढनवपल्लवाः ॥",
  "after": "गायत्रीजलसिद्धां कुष्ठी न तोयकार्यकरः गजलिंगक्षारयुता तत्क्षारन्नाथिनो विलेपिभुजः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.315",
  "kind": "metre",
  "line": "इक्षुरगोक्षुरसिंह्यीव्याधीपंचांगुलांबुना पीता ॥",
  "before": "अंशस्ताभ्यां तथांशः कृमिरिपुदहनस्फोटकरुद्ध्यः स चूर्णो गोमूत्रेणोपयुक्तः प्रमितहितभुजः श्वित्रमाश्वेव हंति ॥",
  "after": "उपलेपनं घनं वा रसाशिनां हंति बाकुचिका ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.316",
  "kind": "metre",
  "line": "उपलेपनं घनं वा रसाशिनां हंति बाकुचिका ॥",
  "before": "इक्षुरगोक्षुरसिंह्यीव्याधीपंचांगुलांबुना पीता ॥",
  "after": "उष्णोदकेन पिष्टा पीता घृतमिश्रिता जयेद्गुल्मं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.317",
  "kind": "metre",
  "line": "उष्णोदकेन पिष्टा पीता घृतमिश्रिता जयेद्गुल्मं ॥",
  "before": "उपलेपनं घनं वा रसाशिनां हंति बाकुचिका ॥",
  "after": "लघुपंचमूलसिद्धां पेयामुपयोजयेज्जीर्णे ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.325",
  "kind": "metre",
  "line": "इक्षुरकादिकाथैर्वर्ध्मनि मूत्रेण वा गवां शस्ता ॥",
  "before": "शोफे पांड्व्याधाववल्गुर्जं सीध्वरिष्टसंयुक्तं ॥",
  "after": "धारोष्णेन तु पयसा युक्ता शोफज्वरौ हंति ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.328",
  "kind": "metre",
  "line": "कृमिहरचतुरंगुलयोः क्वाथैः कोष्णैः कृमिकोष्ठे ॥",
  "before": "उष्णांबुना प्रयोज्या लूताकीटाखुसर्पदंष्ट्रेषु ॥",
  "after": "लेखांमिदोः सघृतां सुखांबुना पुत्रिणी भवति पीत्वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.335",
  "kind": "metre",
  "line": "इति शमनी धन्येयं विषधरभूतोपसर्गाघ्नी ॥",
  "before": "तिक्तमधुरकषायैः कफजांस्त्रिफलारसमधुभ्यां ॥",
  "after": "गेहे स्थिताऽपि रेखा चांद्रमसी किमुत कोष्ठस्था ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.469",
  "kind": "metre",
  "line": "खर्जूरदाडिमसिताद्राक्षापानानुपोऽभ्यसेन्नित्यं ॥",
  "before": "पटुसुरभिंमधुरगंधान्बलाक्षकधवलबहुलरसान् ॥",
  "after": "लभते बलवर्णोजोवीर्यस्वरसौमनस्यतेजांसि ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.549",
  "kind": "metre",
  "line": "महिषाख्यः पुष्परागस्फटिकसितनीरजच्छायः ॥",
  "before": "गंधोत्कटः स दाहे स्निग्धद्रवपिच्छिलो विगतशल्यः ॥",
  "after": "यः पद्मरागरागो यः कनकच्छेदपाटलो यो वा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.550",
  "kind": "metre",
  "line": "यः पद्मरागरागो यः कनकच्छेदपाटलो यो वा ॥",
  "before": "महिषाख्यः पुष्परागस्फटिकसितनीरजच्छायः ॥",
  "after": "जयतींद्रनीलममलं भग्नेप्यतिकांतिमत्वेन ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.551",
  "kind": "metre",
  "line": "जयतींद्रनीलममलं भग्नेप्यतिकांतिमत्वेन ॥",
  "before": "यः पद्मरागरागो यः कनकच्छेदपाटलो यो वा ॥",
  "after": "ज्येष्ठः प्रयोगोऽस्य तुला पलानैवाधिकं पिबेत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.557",
  "kind": "metre",
  "line": "उपयोक्तुस्तथैवास्य भव त्वं हि महाबल इति ॥",
  "before": "जरामरणदुःखेभ्यो यथा तेऽभ्युत्थिताः सुराः ॥",
  "after": "पंचमूलस्य महतः क्वाथेन हिमभोजनात् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.597",
  "kind": "metre",
  "line": "स्निग्धमन्म्लकषायं मृदु गुरु च शिलाजतु श्रेष्ठं ॥",
  "before": "गोमूत्रगंधि कृष्णं गुग्गुल्वाभं विशर्करं मृत्स्नं ॥",
  "after": "रास्नादशमूलबलापुनर्नवैंरंडशुंठिमधुकानां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.600",
  "kind": "metre",
  "line": "द्राक्षाभीरुपटोलीत्रायंतिगुडूचिजीवनीयानां ॥",
  "before": "क्वाथेन भावितं तद्विशेषतो वातरोगघ्नम् ॥",
  "after": "निर्यूहेण सुभिन्नं शस्तं पित्तामये सुतरां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.604",
  "kind": "metre",
  "line": "लघुपंचमूलशुंठीद्राक्षाकाश्मर्यवाजिगंधानां ॥",
  "before": "सह पंचकोलकानां क्वाथेन कफामये भाव्यं ॥",
  "after": "सगुडूचिशरबलानां रसेन पित्तानिलगदेषु ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.609",
  "kind": "metre",
  "line": "त्रायंत्यमृतातिविषासहितानां पित्तकफजेषु ॥",
  "before": "पाठापटोलनिंबत्रिफलाघनकुटजससपर्णीनां ॥",
  "after": "निचयेऽपि दोषबलतो योगानैतान्विकलप्य युंजीत ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.611",
  "kind": "metre",
  "line": "विविधगणसंग्रहोक्तेस्तैस्तैश्च गणैर्गिरेः सारं ॥",
  "before": "निचयेऽपि दोषबलतो योगानैतान्विकलप्य युंजीत ॥",
  "after": "व्याधिव्याधितसात्म्यं समनुसरन् भावयेदपः पात्रे ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.616",
  "kind": "metre",
  "line": "तत्समरसतां यातं संशुष्कं प्रक्षिपेद्रसे भूयः ॥",
  "before": "तन्निर्यूहेऽष्टांशे पूतोष्णे प्रक्षिपेद्गिरिजं ॥",
  "after": "स्वैः स्वैरेवं क्वाथैर्भाव्यं वारान् भवेत्सम ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.617",
  "kind": "metre",
  "line": "स्वैः स्वैरेवं क्वाथैर्भाव्यं वारान् भवेत्सम ॥",
  "before": "तत्समरसतां यातं संशुष्कं प्रक्षिपेद्रसे भूयः ॥",
  "after": "अथ स्निग्धस्य शुद्धस्य घृतं तिक्तकसाधितं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "06.49.657",
  "kind": "metre",
  "line": "द्विपलाभिर्द्विगुणाभिः कुर्याद्गुलिकास्ततोऽक्षसमाः ॥",
  "before": "द्विपलेन चतुर्जातात्तैलघृतक्षौद्रशर्कराभिश्च ॥",
  "after": "ताः शुष्के नवकुंभे जातीपुष्पाधिवासिते स्थाप्याः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.660",
  "kind": "metre",
  "line": "क्षीररसदाडिमांभोमार्दीकमुरासवान्यतमं ॥",
  "before": "तासामेकां खादेत्प्रतिदिनमनुपानमत्रेष्टं ॥",
  "after": "जीर्णेऽन्नं लघु भोज्यं यूषपयःपिशितनिर्यूहैः ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.662",
  "kind": "metre",
  "line": "सप्ताहमात्रमेवं सर्वाञ्चीनः क्रमाद्भवेत् परतः ॥",
  "before": "जीर्णेऽन्नं लघु भोज्यं यूषपयःपिशितनिर्यूहैः ॥",
  "after": "भुक्तस्यॉंते प्राग्वा गुलिका न विरुध्यते चैषा ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.665",
  "kind": "metre",
  "line": "प्रबलमपि वातशोणितमूरुस्तंभं ज्वरं दीर्घं ॥",
  "before": "निरपाया भूरिफला ऽपरिहारसुखोपयोजिता जयति ॥",
  "after": "भगमूत्रशुक्रदोषप्लीहयकृत्पांडुहृद्रोगान् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.668",
  "kind": "metre",
  "line": "विद्रधिमुदरं कुष्ठं श्वित्रं पांढ्यं क्षयं मदं मूर्च्छा ॥",
  "before": "वध्मवमिगुल्मपीनसहिक्माकासारुचिश्वासान् ॥",
  "after": "उन्मादमपस्मारं मुखनेत्रशिरोगदांस्तांस्तान् ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.49.677",
  "kind": "metre",
  "line": "कुरुते नृपवल्लभतां जयं विवादे च वक्त्रस्था ॥",
  "before": "वृष्याऽऽयुष्या धन्या कांतियशः श्रीविबोधिनी मेध्या ॥",
  "after": "विजितखलतिवलिपलिता जीवयति सुखं शतद्वयं शरदां ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.50.432",
  "kind": "metre",
  "line": "इतिवाजीकरणयोगो नाम पञ्चाशत्तमोऽध्यायः ॥",
  "before": "यदुदितमिह पुण्यं कुर्वतो मेऽनुवादं भवतु विगतरोगो निर्वृतस्तेन लोकः ॥",
  "after": "इत्यष्टमं वाजीकरणमंगं संपूर्णं ॥",
  "note": "18 aksharas"
 },
 {
  "id": "06.50.433",
  "kind": "metre",
  "line": "इत्यष्टमं वाजीकरणमंगं संपूर्णं ॥",
  "before": "इतिवाजीकरणयोगो नाम पञ्चाशत्तमोऽध्यायः ॥",
  "after": "इति श्रीसिंहगुप्तसूनुश्रीमद्वाग्भटाचार्य विरचितेऽष्टांगसंग्रहे षष्ठमुत्तरस्थानं संपूर्णं ॥",
  "note": "14 aksharas"
 },
 {
  "id": "01.02.36",
  "kind": "sample",
  "line": "चंडं शोकातुरं भीरुं कृतघ्नं वैद्यमानिनं ॥",
  "before": "आर्त्तं च नृपसद्वैद्यैर्द्विष्टं तद्वेषिणं द्विषं ॥",
  "after": "हीनोपकरणं व्यग्रमविधेयं गतायुषं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.03.39",
  "kind": "sample",
  "line": "पारिभद्रकमम्लीकामोचकयौ शाल्मलीं शणं ॥",
  "before": "कोविदारशमीपीलुपिप्पलैंगुदगुग्गुलून् ॥",
  "after": "स्वाद्वम्ललवणं शुष्कं सुषिरं पूतिपिच्छिलं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.04.45",
  "kind": "sample",
  "line": "लघूष्णैः प्रावृतःस्वप्यात्कालेधुपाधिवासितः ॥",
  "before": "कुंकुमेनानुदिग्धांगोऽगुरुणा गुरुणाऽपि वा ॥",
  "after": "पीनांगनांगसंसर्ग निवारितहिमानिलः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.04.57",
  "kind": "sample",
  "line": "सेवेत सुहृदुद्यानयुवतीश्च मनोरमाः ॥",
  "before": "व्यायामोद्वर्तनक्षौद्रयवगोधूमजांगलान् ॥",
  "after": "स्नातः स्वलंकृतः स्त्रग्वी चंदनागुरु रूषितः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.04.115",
  "kind": "sample",
  "line": "तप्तानां संचितं पूर्वं तदा पित्तं प्रकुप्यति ॥",
  "before": "वर्षाशीतोचितांगानां सहसैवाकरश्मिभिः ॥",
  "after": "शस्तं तिक्तैहविःपानं विरेकोऽस्त्रश्रुतिः सदा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.05.56",
  "kind": "sample",
  "line": "अतिस्थौल्याग्निसदनकुष्ठमे हहृतौजसः ॥",
  "before": "प्रायशः सुचिरेणापि भेषजद्वेषिणो गदान् ॥",
  "after": "स्रोतोरौधाक्षविभ्रंशश्वासश्वयथुपांडुताः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.05.68",
  "kind": "sample",
  "line": "ये तु संशोधनैः शुद्धा न तेषां पुनरुद्भवः ॥",
  "before": "दोषाः कदाचित्कुप्यंति जितालंघनपाचनैः ॥",
  "after": "यथाक्रमं यथायोगमतऊर्ध्वं प्रयोजयेत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.06.95",
  "kind": "sample",
  "line": "अतिशैत्यगुरुस्थैर्यसंघातैः कफवातकृत् ॥",
  "before": "भवेत्पर्युषितंतद्वत्तोयं तु करकोद्भवं ॥",
  "after": "चंद्रकांतभवं रक्षोविषपित्तज्वरापहं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.06.112",
  "kind": "sample",
  "line": "आजं शोषज्वरश्वासरक्तपित्ता तिसारजित् ॥",
  "before": "अल्पांबुपानव्यायामकदुतिक्ताशनैर्लघु ॥",
  "after": "ईषद्रूक्षोष्णलवणमौष्ट्रकं दीपनं लघु ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.06.132",
  "kind": "sample",
  "line": "नामुद्रसूपं नाक्षौद्रं तन्नाघृतसितोपलं ॥",
  "before": "नैवाद्यान्निशि नैवोष्णंवसंतोष्णशरत्सु न ॥",
  "after": "नचानामलकं नापि 'मंदं नो नित्यमन्यथा ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.06.216",
  "kind": "sample",
  "line": "विशेषात्कृमिकुष्ठघ्ने तथोर्ध्वाधोविरेचने ॥",
  "before": "भृशोष्णतीक्ष्णकटुनी तौवरारुष्करोद्भवे ॥",
  "after": "अक्षातिमुक्तकाक्षोडनालिकेरमधूकजं ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.06.262",
  "kind": "sample",
  "line": "मैरेयो मधुरो वृष्यः सरः संतर्पणो गुरुः ॥",
  "before": "सुरासवस्तीक्ष्णमदः स्वादुस्तीक्ष्णोऽनिलापहः ॥",
  "after": "धातक्यभिषुतो जीर्णो रूक्षो रोचनदीपनः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.07.195",
  "kind": "sample",
  "line": "गोधा नियच्छति विषं मूषकः शुक्रवर्द्धनः ॥",
  "before": "जीर्णार्शोग्रहणीदोषशोषार्त्तानां परं हिताः ॥",
  "after": "शुष्ककासश्रमात्यग्निविषमज्वरपीनसान् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.07.292",
  "kind": "sample",
  "line": "दीपनं भेदनं हंति गरशोफकफानिलान् ॥",
  "before": "वर्षाभौ कालशाकं च सक्षारं कटुतिक्तकं ॥",
  "after": "दीपनाः कफवातघ्नाश्चिरबिल्वांकुराः सराः ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.07.308",
  "kind": "sample",
  "line": "स्वराग्निसादोदावर्त्तपीनसांश्च ' महत्पुनः ॥",
  "before": "गुल्मकासक्षयश्वासव्रणनेत्रगलामयान् ॥",
  "after": "रूक्षोष्णं कटुकं स्वादु विपाके सर्वदोषकृत् ॥",
  "note": "ordinary line, no flag"
 },
 {
  "id": "01.07.346",
  "kind": "sample",
  "line": "मोचरखर्जूरपनसनारिकेलपरूषकं ॥",
  "before": "सर्वं हृद्यं लघु स्निग्धं ग्राहि रोचनदीपनं ॥",
  "after": "आम्राततालकाश्मर्यराजादनमधूकजं ॥",
  "note": "ordinary line, no flag"
 }
]